---
// TEMPORARY — design system review page. Delete once the rebrand is signed off.
import BaseLayout from '../layouts/BaseLayout.astro';

const coreColours = [
  { name: 'Hot pink', token: '--color-pink', value: '#ef1f9f', role: 'Primary accent' },
  { name: 'Black', token: '--color-black', value: '#000000', role: 'Page background, everywhere' },
  { name: 'White', token: '--color-white', value: '#ffffff', role: 'Primary text, tertiary colour' },
];

const roleColours = [
  { token: '--color-primary', value: 'var(--color-primary)', note: 'Accents, links, markers, buttons' },
  { token: '--color-primary-hover', value: 'var(--color-primary-hover)', note: '#d1198a — hover state only' },
  { token: '--color-bg', value: 'var(--color-bg)', note: 'Solid black page background' },
  { token: '--color-surface', value: 'var(--color-surface)', note: '#0a0a0a — section separation' },
  { token: '--color-surface-raised', value: 'var(--color-surface-raised)', note: '#141414 — raised blocks' },
  { token: '--color-surface-input', value: 'var(--color-surface-input)', note: 'Form field fill' },
];

const greys = [
  { token: '--grey-950', value: 'var(--grey-950)', note: '#0a0a0a' },
  { token: '--grey-900', value: 'var(--grey-900)', note: '#141414' },
  { token: '--grey-800', value: 'var(--grey-800)', note: '#1f1f1f' },
];

const textColours = [
  { token: '--color-text', value: 'var(--color-text)', note: 'Headlines, emphasis' },
  { token: '--color-text-body', value: 'var(--color-text-body)', note: 'Long-form body copy (78% white)' },
  { token: '--color-text-muted', value: 'var(--color-text-muted)', note: 'Secondary text (55% white)' },
  { token: '--color-text-faint', value: 'var(--color-text-faint)', note: 'Captions, meta (38% white)' },
];

const borders = [
  { token: '--color-border', value: 'var(--color-border)', note: 'Default hairline' },
  { token: '--color-border-strong', value: 'var(--color-border-strong)', note: 'Emphasised edge' },
  { token: '--color-border-accent', value: 'var(--color-border-accent)', note: 'Pink hairline' },
];

const holoStops = [
  { token: '--holo-base', value: 'var(--holo-base)' },
  { token: '--holo-lilac', value: 'var(--holo-lilac)' },
  { token: '--holo-blue', value: 'var(--holo-blue)' },
  { token: '--holo-mint', value: 'var(--holo-mint)' },
  { token: '--holo-peach', value: 'var(--holo-peach)' },
  { token: '--holo-pink', value: 'var(--holo-pink)' },
];

const holoBloom = [
  { token: '--holo-bloom', value: 'var(--holo-bloom)' },
  { token: '--holo-bloom-mid', value: 'var(--holo-bloom-mid)' },
  { token: '--holo-ray', value: 'var(--holo-ray)' },
  { token: '--holo-break-lilac', value: 'var(--holo-break-lilac)' },
  { token: '--holo-break-mint', value: 'var(--holo-break-mint)' },
  { token: '--holo-break-pink', value: 'var(--holo-break-pink)' },
];

const buttonVariants = [
  {
    cls: 'btn btn-primary',
    name: 'Primary',
    note: 'Holographic foil, black bold text → inverts to solid black with white text and a 1px foil border',
  },
  {
    cls: 'btn btn-secondary',
    name: 'Secondary',
    note: 'Solid #ef1f9f, black text → inverts to white background with black text',
  },
  {
    cls: 'btn btn-tertiary',
    name: 'Tertiary',
    note: 'Transparent with a 1px white border, white text → fills with the holographic surface, black bold text',
  },
];

const pairings = [
  {
    name: 'Primary + tertiary',
    where: 'Home, Accelerator, Community',
    filled: 'btn btn-primary',
    filledLabel: 'Apply now',
  },
  {
    name: 'Secondary + tertiary',
    where: 'Fund',
    filled: 'btn btn-secondary',
    filledLabel: 'Apply now',
  },
];

const displayScale = [
  { token: '--text-display', note: 'clamp(3rem, 8vw, 6rem) · tracking -0.055em' },
  { token: '--text-h1', note: 'clamp(2.5rem, 5.5vw, 4.25rem) · tracking -0.055em' },
  { token: '--text-h2', note: 'clamp(1.875rem, 4vw, 2.875rem) · tracking -0.04em' },
  { token: '--text-h3', note: 'clamp(1.375rem, 2.6vw, 1.875rem) · tracking -0.025em' },
  { token: '--text-h4', note: 'clamp(1.125rem, 2vw, 1.375rem) · tracking -0.025em' },
];

const bodyScale = [
  { token: '--text-lead', note: 'clamp(1.125rem, 1.6vw, 1.3125rem) · white' },
  { token: '--text-body', note: '1.0625rem · line-height 1.65 · 78% white' },
  { token: '--text-small', note: '0.9375rem · 55% white' },
  { token: '--text-xs', note: '0.8125rem · 38% white' },
];
---

<BaseLayout title="Styleguide" description="Design system reference">
  <main class="sg">
    <div class="container">
      <header class="sg-header">
        <p class="sg-eyebrow">Design foundation</p>
        <h1>Styleguide</h1>
        <p class="lead">
          One typeface, one accent, one surface treatment. Every value on this page is a CSS
          custom property defined in <code>src/styles/global.css</code>.
        </p>
        <p class="sg-wordmark-demo wordmark">the tech bros</p>
        <p class="sg-caption">Wordmark — Helvetica Neue, weight 400, letter-spacing -0.06em, lowercase, no glow.</p>
      </header>

      <!-- ── Colour ─────────────────────────────────────────────────────── -->
      <section class="sg-section">
        <h2>Colour</h2>

        <h3>Core palette</h3>
        <div class="sg-swatch-grid">
          {coreColours.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background: ${c.value};`}></div>
              <p class="sg-swatch-name">{c.name}</p>
              <p class="sg-token">{c.token}</p>
              <p class="sg-token">{c.value}</p>
              <p class="sg-caption">{c.role}</p>
            </div>
          ))}
        </div>

        <h3>Surfaces &amp; roles</h3>
        <div class="sg-swatch-grid">
          {roleColours.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background: ${c.value};`}></div>
              <p class="sg-token">{c.token}</p>
              <p class="sg-caption">{c.note}</p>
            </div>
          ))}
        </div>

        <h3>Neutral greys</h3>
        <p class="sg-note">Used only where a surface genuinely needs to separate from the page. No tints.</p>
        <div class="sg-swatch-grid">
          {greys.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background: ${c.value};`}></div>
              <p class="sg-token">{c.token}</p>
              <p class="sg-caption">{c.note}</p>
            </div>
          ))}
        </div>

        <h3>Text</h3>
        <div class="sg-swatch-grid">
          {textColours.map((c) => (
            <div class="sg-swatch">
              <p class="sg-text-sample" style={`color: ${c.value};`}>Aa</p>
              <p class="sg-token">{c.token}</p>
              <p class="sg-caption">{c.note}</p>
            </div>
          ))}
        </div>

        <h3>Borders</h3>
        <div class="sg-swatch-grid">
          {borders.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip sg-chip-border" style={`border-color: ${c.value};`}></div>
              <p class="sg-token">{c.token}</p>
              <p class="sg-caption">{c.note}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Type scale ─────────────────────────────────────────────────── -->
      <section class="sg-section">
        <h2>Type — display scale</h2>
        <p class="sg-note">Helvetica Neue, weight 400, tight negative tracking, white on black.</p>
        <div class="sg-type-list">
          {displayScale.map((t) => (
            <div class="sg-type-row">
              <p class="sg-sample" style={`font-size: var(${t.token});`}>the tech bros</p>
              <p class="sg-token">{t.token} — {t.note}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="sg-section">
        <h2>Type — body scale</h2>
        <p class="sg-note">Long-form copy sits at 78% white so it does not vibrate against pure black.</p>
        <div class="sg-type-list">
          {bodyScale.map((t) => (
            <div class="sg-type-row">
              <p class={`sg-body-sample sg-body-${t.token.replace('--text-', '')}`}>
                The world's first all-female, all-technical accelerator. We back technical founders
                from first commit to first cheque, and we do it in public.
              </p>
              <p class="sg-token">{t.token} — {t.note}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Buttons ────────────────────────────────────────────────────── -->
      <section class="sg-section">
        <h2>Buttons</h2>
        <p class="sg-note">
          1rem / 2.25rem padding, weight 700 at <code>--text-button</code> with -0.02em tracking,
          square corners, 80ms linear hover — a switch, not a fade. Listed in order of weight. The
          right-hand column has the hover state forced on so both can be compared at rest.
        </p>

        <div class="sg-btn-table">
          <p class="sg-token sg-btn-head">Variant</p>
          <p class="sg-token sg-btn-head">Default</p>
          <p class="sg-token sg-btn-head">Hover</p>

          {buttonVariants.map((b) => (
            <>
              <div class="sg-btn-cell sg-btn-label">
                <p class="sg-swatch-name">{b.name}</p>
                <p class="sg-caption">{b.note}</p>
              </div>
              <div class="sg-btn-cell">
                <button type="button" class={b.cls}>apply now</button>
              </div>
              <div class="sg-btn-cell">
                <button type="button" class={`${b.cls} is-hover`}>apply now</button>
              </div>
            </>
          ))}
        </div>

        <h3>Pairing rule</h3>
        <p class="sg-note">
          <strong>Never place primary and secondary side by side.</strong> A button group is one
          filled variant — primary <em>or</em> secondary — plus tertiary. Only these two
          combinations are approved.
        </p>
        <div class="sg-pairings">
          {pairings.map((pair) => (
            <div class="sg-pairing">
              <p class="sg-swatch-name">{pair.name}</p>
              <p class="sg-caption">{pair.where}</p>
              <div class="btn-group sg-pairing-row">
                <a href="#" class={pair.filled}>{pair.filledLabel}</a>
                <a href="#" class="btn btn-tertiary">Learn more</a>
              </div>
            </div>
          ))}
        </div>
        <p class="sg-note sg-pairing-warning">
          The Fund page uses secondary + tertiary only — no holographic anywhere on it.
        </p>

        <h3>Live</h3>
        <p class="sg-note">Hover these to check the transition timing.</p>
        <div class="btn-group sg-btn-row">
          <a href="#" class="btn btn-primary">Primary</a>
          <a href="#" class="btn btn-secondary">Secondary</a>
          <a href="#" class="btn btn-tertiary">Tertiary</a>
        </div>

        <h3>Form controls</h3>
        <div class="sg-form">
          <input type="text" placeholder="Text input" />
          <textarea rows="3" placeholder="Textarea"></textarea>
        </div>
      </section>

      <!-- ── Shape ──────────────────────────────────────────────────────── -->
      <section class="sg-section">
        <h2>Shape</h2>
        <p class="sg-note">
          <code>border-radius: 0</code> everywhere. Read live from
          <code>getComputedStyle</code> below, not asserted.
        </p>
        <div class="sg-shape-row">
          <div class="card sg-shape-card" data-radius-probe=".card">Card</div>
          <button type="button" class="btn btn-primary" data-radius-probe=".btn-primary">Primary</button>
          <button type="button" class="btn btn-secondary" data-radius-probe=".btn-secondary">Secondary</button>
          <button type="button" class="btn btn-tertiary" data-radius-probe=".btn-tertiary">Tertiary</button>
          <input type="text" value="Input" data-radius-probe="input" />
        </div>
        <ul class="sg-radius-report" id="radius-report"></ul>
      </section>

      <!-- ── Holographic surface ────────────────────────────────────────── -->
      <section class="sg-section">
        <h2>Holographic surface</h2>
        <p class="sg-note">
          Four stacked layers, top down: broad soft-edged <strong>rays</strong> from a
          <code>repeating-conic-gradient</code>, a soft round <strong>bloom</strong> of converging
          light, a faint off-axis <strong>breakup</strong> conic, and the <strong>base</strong>
          conic sweeping five pastels cycled three times so each hue holds its own identity. The
          rays and bloom are deliberately barely perceptible — they suggest internal structure
          rather than draw it. No hard boundaries, no images. A background fill for discrete blocks
          only — never a glow, never a text effect, never a full-page background. Text on it is
          black, weight 700, tightly tracked.
        </p>

        <div class="holo sg-holo-block">
          <h3>applications open</h3>
          <p>Cohort 03 closes 14 November. Twelve teams. Twelve weeks. No equity.</p>
        </div>

        <div class="sg-holo-row">
          <div class="holo sg-holo-card">
            <p>holo card</p>
          </div>
          <div class="holo sg-holo-card">
            <p>holo card</p>
          </div>
          <a href="#" class="btn btn-primary">apply now</a>
        </div>

        <h3>Centre point</h3>
        <p class="sg-note">
          Set <code>--holo-centre-x</code> and <code>--holo-centre-y</code> on any element to move
          where the light converges. Same surface, three centres.
        </p>
        <div class="sg-holo-row">
          <div class="holo sg-holo-card"><p>55% / 45%</p></div>
          <div class="holo sg-holo-card" style="--holo-centre-x: 20%; --holo-centre-y: 25%"><p>20% / 25%</p></div>
          <div class="holo sg-holo-card" style="--holo-centre-x: 80%; --holo-centre-y: 75%"><p>80% / 75%</p></div>
        </div>

        <h3>Base conic stops</h3>
        <div class="sg-swatch-grid">
          {holoStops.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background: ${c.value};`}></div>
              <p class="sg-token">{c.token}</p>
            </div>
          ))}
        </div>

        <h3>Bloom, ray &amp; breakup stops</h3>
        <p class="sg-note">
          Shown over black — the ray stop carries 0.09 alpha and the breakup stops 0.2 alpha by
          design, so they read faint here. The rays are drawn from
          <code>--holo-ray-x / -y</code>, offset from the bloom on purpose: when both converge on
          the same point the surface reads as a starburst rather than foil.
        </p>
        <div class="sg-swatch-grid">
          {holoBloom.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background: ${c.value};`}></div>
              <p class="sg-token">{c.token}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .sg {
    padding: 4rem 0 8rem;
  }

  .sg-header {
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sg-eyebrow {
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--text-xs);
    margin-bottom: 1rem;
  }

  .sg-wordmark-demo {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin: 2.5rem 0 0.5rem;
  }

  .sg-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .sg-section h2 {
    margin-bottom: 2rem;
  }

  .sg-section h3 {
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .sg-note {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .sg-caption {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    margin-bottom: 0;
  }

  .sg-token {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0;
    margin-bottom: 0.25rem;
  }

  /* ── swatches ── */
  .sg-swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }

  .sg-chip {
    width: 100%;
    height: 88px;
    border: 1px solid var(--color-border);
    margin-bottom: 0.75rem;
  }

  .sg-chip-border {
    border-width: 3px;
    background: var(--color-surface);
  }

  .sg-swatch-name {
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .sg-text-sample {
    font-size: 3.5rem;
    line-height: 1;
    letter-spacing: var(--tracking-heading);
    margin-bottom: 0.75rem;
  }

  /* ── type ── */
  .sg-type-list {
    display: grid;
    gap: 2.5rem;
  }

  .sg-type-row {
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
  }

  .sg-sample {
    font-weight: var(--weight-heading);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .sg-body-sample {
    max-width: 62ch;
    margin-bottom: 0.75rem;
  }

  .sg-body-lead {
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  .sg-body-body {
    font-size: var(--text-body);
    color: var(--color-text-body);
  }

  .sg-body-small {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .sg-body-xs {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* ── buttons + forms ── */
  .sg-btn-row {
    align-items: center;
  }

  .sg-btn-table {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto auto;
    gap: 1.25rem 2rem;
    align-items: center;
    margin-bottom: 3rem;
  }

  .sg-btn-head {
    margin-bottom: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sg-btn-cell {
    display: flex;
  }

  .sg-btn-label {
    flex-direction: column;
  }

  .sg-btn-label .sg-swatch-name {
    margin-bottom: 0.25rem;
  }

  .sg-btn-table .btn {
    width: auto;
  }

  @media (max-width: 768px) {
    .sg-btn-table {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .sg-btn-head {
      display: none;
    }

    .sg-btn-label {
      margin-top: 1.5rem;
    }
  }

  .sg-form {
    max-width: 480px;
  }

  .sg-pairings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .sg-pairing {
    border-left: 1px solid var(--color-border);
    padding-left: 1.5rem;
  }

  .sg-pairing-row {
    margin-top: 1rem;
  }

  .sg-pairing-warning {
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .sg-shape-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  .sg-shape-card {
    padding: 1.25rem 2rem;
  }

  .sg-shape-row input {
    width: auto;
    margin-bottom: 0;
  }

  .sg-radius-report {
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .sg-radius-report li {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* ── holo ── */
  .sg-holo-block {
    padding: 3rem;
    margin-bottom: 2rem;
  }

  .sg-holo-block h3 {
    margin-top: 0;
    font-size: var(--text-h2);
  }

  .sg-holo-block p {
    margin-bottom: 0;
    max-width: 48ch;
  }

  .sg-holo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .sg-holo-card {
    flex: 1 1 200px;
    min-height: 160px;
    padding: 1.5rem;
    display: flex;
    align-items: flex-end;
  }

  .sg-holo-card p {
    margin-bottom: 0;
  }

  code {
    color: var(--color-text);
    font-size: 0.95em;
  }

  @media (max-width: 768px) {
    .sg-holo-block {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  // Live confirmation that nothing anywhere is rounded.
  const report = document.getElementById('radius-report');
  if (report) {
    document.querySelectorAll('[data-radius-probe]').forEach((el) => {
      const radius = getComputedStyle(el).borderRadius;
      const li = document.createElement('li');
      li.textContent = `${el.getAttribute('data-radius-probe')} → border-radius: ${radius}`;
      report.appendChild(li);
    });
  }
</script>
