  .org-tag-supporter {
    color: var(--color-primary);
    border-color: var(--color-border-accent);
    background: rgba(239, 31, 159, 0.1);
  }

  .org-tag-community {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: rgba(255, 255, 255, 0.06);
  }

  .org-tag-more {
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  /* A tag with a website behind it. It keeps its group's colour — the two-colour
     split is what distinguishes supporters from community partners, and being a
     link is not a third category — and signals itself on hover instead. */
  .org-tag-link {
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--transition-btn), border-color var(--transition-btn);
  }

  .org-tag-supporter.org-tag-link:hover,
  .org-tag-supporter.org-tag-link:focus-visible {
    background: rgba(239, 31, 159, 0.25);
    border-color: var(--color-primary);
  }

  .org-tag-community.org-tag-link:hover,
  .org-tag-community.org-tag-link:focus-visible {
    background: rgba(255, 255, 255, 0.16);
    border-color: var(--color-text);
  }

  /* Filter Styles */
  .event-filters {
    display: flex;
    gap: 1.5rem;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-group {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .filter-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-family: var(--font-primary);
    white-space: nowrap;
  }

  .filter-dropdown {
    position: relative;
  }

  .filter-button {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-primary);
    color: var(--color-text);
    padding: 0.75rem 1.25rem;
    border-radius: 0;
    cursor: pointer;
    font-family: var(--font-primary);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 0.5rem;
    min-width: 150px;
    transition: all 0.2s ease;
  }

  .filter-button:hover {
    background: rgba(239, 31, 159, 0.1);
    border-color: var(--color-primary);
  }

  .filter-button[aria-expanded="true"] {
    background: rgba(239, 31, 159, 0.2);
    border-color: var(--color-primary);
  }

  .filter-label {
    flex: 1;
    text-align: left;
  }

  .filter-arrow {
    font-size: 0.7rem;
    transition: transform 0.2s ease;
  }

  .filter-button[aria-expanded="true"] .filter-arrow {
    transform: rotate(180deg);
  }

  .filter-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-primary);
    border-radius: 0;
    min-width: 200px;
    max-height: 400px;
    overflow-y: auto;
    z-index: 100;
    display: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .filter-menu-nested {
    overflow: visible !important;
    max-height: none;
  }

  .filter-menu-nested .filter-submenu {
    overflow: visible;
  }

  .filter-menu.active {
    display: block;
  }

  .filter-menu li {
    list-style: none;
    position: relative;
  }

  .filter-submenu-list li {
    list-style: none;
  }

  .filter-option {
    width: 100%;
    background: none;
    border: none;
    color: var(--color-text);
    padding: 0.75rem 1rem;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-primary);
