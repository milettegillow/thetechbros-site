---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import FormModal from '../components/FormModal.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { COMMUNITY_LEADS } from '../config';
import PeopleGrid from '../components/PeopleGrid.astro';
import { partnerUrl } from '../data/partner-urls';

// The same grid the team on /about and both grids on /accelerator use, off the
// same shared list, so the three pages can't drift apart. The city rides along
// as the tile's `meta` line — the one thing this page shows that they don't.
const leads = COMMUNITY_LEADS.map((lead) => ({
  name: lead.name,
  photo: lead.photo,
  linkedin: lead.linkedin,
  meta: lead.city,
}));
import { getEventStats } from '../lib/eventStats';

// Helper function to capitalize first letter
function capitalize(str: string): string {
  return str.charAt(0).toUpperCase() + str.slice(1);
}

const MAX_TAGS = 5;

/**
 * `indent` is an optical correction, not a layout nudge. The number and its
 * label already share a left box edge; what doesn't line up is the ink,
 * because a leading "1" carries ~0.087em of left side bearing while a "w" or
 * "f" starts hard against the edge. Shifting the number left by its own
 * bearing puts the visible stroke where the label's first letter starts.
 * Values are in em so they track the clamped font size across viewports.
 * Measured against Helvetica Neue: "1" 0.087em, "2" 0.024em.
 */
const stats = [
  { value: '1,500+', label: 'women hosted in-person', indent: '0.087em' },
  { value: '28', label: 'countries', indent: '0.024em' },
  { value: '10,500+', label: 'followers', indent: '0.087em' },
];


const COMMUNITY_FIELDS = [
  { name: 'fullName', label: 'Full Name', kind: 'text' as const },
  { name: 'email', label: 'Email', kind: 'email' as const },
  { name: 'linkedinUrl', label: 'LinkedIn URL', kind: 'linkedin' as const, placeholder: 'https://www.linkedin.com/in/yourname' },
  { name: 'personalWebsite', label: 'Personal Website', kind: 'url' as const, placeholder: 'https://yourwebsite.com' },
  { name: 'phoneNumber', label: 'Phone Number', kind: 'tel' as const },
  { name: 'location', label: 'Location', kind: 'text' as const, placeholder: 'City, Country' },
  {
    name: 'fields',
    label: 'Field(s)',
    kind: 'checkbox-group' as const,
    hint: '(Select all that apply)',
    options: ['CS', 'AI / ML', 'Mathematics', 'Engineering', 'Physics', 'Chemistry', 'Biology', 'Robotics / hardware', 'Software', 'Medicine'],
  },
  { name: 'mostAdvancedDegree', label: 'Most Advanced Degree', kind: 'select' as const, options: ['BSc', 'MSc', 'PhD'] },
  { name: 'whyTTB', label: 'Why the bros?', kind: 'textarea' as const, maxlength: 5000 },
  { name: 'addToMailingList', label: 'Add me to the mailing list', kind: 'checkbox' as const, required: false },
];

const CITY_LEAD_FIELDS = [
  { name: 'fullName', label: 'Name', kind: 'text' as const },
  { name: 'email', label: 'Email', kind: 'email' as const },
  { name: 'city', label: 'City', kind: 'text' as const, placeholder: 'City, Country' },
  { name: 'linkedinUrl', label: 'LinkedIn URL', kind: 'linkedin' as const, placeholder: 'https://www.linkedin.com/in/yourname' },
  { name: 'whyYou', label: 'Why you', kind: 'textarea' as const, maxlength: 2000 },
  { name: 'whatYoudRun', label: "What you'd run there", kind: 'textarea' as const, maxlength: 2000 },
];

const SOCIALS_FIELDS = [
  { name: 'fullName', label: 'Name', kind: 'text' as const },
  { name: 'email', label: 'Email', kind: 'email' as const },
  { name: 'linkedinUrl', label: 'LinkedIn URL', kind: 'linkedin' as const, placeholder: 'https://www.linkedin.com/in/yourname' },
  { name: 'relevantExperience', label: 'Relevant experience', kind: 'textarea' as const, maxlength: 2000 },
  { name: 'whyYou', label: 'Why you', kind: 'textarea' as const, maxlength: 2000 },
];

// One "event listing" link per event. Most are Luma, but some point at a
// university page or a students' union, so the caller must not assume Luma.
function listingUrl(data: { lumaUrl?: string; eventUrl?: string }) {
  return data.lumaUrl ?? data.eventUrl;
}

const events = (await getCollection('events')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function ordinal(n: number) {
  if (n > 3 && n < 21) return `${n}th`;
  return `${n}${['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
}

function formatDateRange(date: Date, endDate?: Date) {
  const month = date.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });
  const year = date.getUTCFullYear();
  const start = ordinal(date.getUTCDate());
  if (endDate) {
    return `${start}-${ordinal(endDate.getUTCDate())} ${month}, ${year}`;
  }
  return `${start} ${month}, ${year}`;
}

// Sponsors and in-kind partners are one visual group; community partners
// another. Each tag carries its organisation's website where one is on file;
// where none is, `url` stays undefined and the tag renders as plain text.
//
// `all` is the complete set for the modal; the card shows `shown` and counts
// the rest, so the two must come from the same call.
function orgTags(data: (typeof events)[number]['data']) {
  const supporters = [...(data.sponsors ?? []), ...(data.inKind ?? [])].map(
    (name) => ({ name, kind: 'supporter' as const, url: partnerUrl(name) })
  );
  const partners = (data.communityPartners ?? []).map(
    (name) => ({ name, kind: 'community' as const, url: partnerUrl(name) })
  );
  const all = [...supporters, ...partners];
  return { all, shown: all.slice(0, MAX_TAGS), overflow: Math.max(0, all.length - MAX_TAGS) };
}

// ── Counters: every value derived, nothing hardcoded ──
const eventStats = getEventStats(events);

const counters = [
  { value: eventStats.eventCount, label: eventStats.eventCount === 1 ? 'event' : 'events' },
  { value: eventStats.cityCount, label: eventStats.cityCount === 1 ? 'city' : 'cities' },
  { value: eventStats.countryCount, label: eventStats.countryCount === 1 ? 'country' : 'countries' },
  { value: eventStats.organisationCount, label: 'partners & sponsors' },
];

// ── Filter options, also derived ──
const eventTypes = [...new Set(events.map((e) => e.data.type))].sort();
const countries = [...new Set(events.map((e) => e.data.country))].sort();
const locationGroups = countries.map((country) => ({
  country,
  cities: [
    ...new Set(events.filter((e) => e.data.country === country).map((e) => e.data.city)),
  ].sort(),
}));
---

<BaseLayout title="Community">
  <Navigation />
  <main>
    <section class="community-hero">
      <div class="container">
        <div class="stat-row">
          {stats.map((stat) => (
            <div class="stat-block" style={`--stat-indent: -${stat.indent}`}>
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
        <p class="statement">The old boys’ network, replaced.</p>
      </div>
    </section>

    <section class="community" id="community">
      <div class="container">
        
        <div class="community-options">
          <div class="community-card">
            <h2>whatsapp community</h2>
            <p>Join our global community of women in STEM. 250+ members across 28 countries. Apply below.</p>
            <button type="button" class="btn btn-primary" onclick="window.openApplyModal && window.openApplyModal()">Apply to Join</button>
          </div>
          <div class="community-card" id="newsletter">
            <h2>newsletter</h2>
            <p>Monthly updates on our companies, events, and opportunities.</p>
            <NewsletterSignup buttonText="Subscribe" />
          </div>
          <div class="community-card">
            <h2>upcoming events</h2>
            <p>We run regular hackathons, pitch nights, co-working days, and more. See what's coming up below.</p>
            <a href="https://luma.com/thetechbros" class="btn btn-tertiary" target="_blank">View Events on Luma</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Past Events -->
    <section class="leads" id="community-leads">
      <div class="container">
        <h2>community leads</h2>
        <PeopleGrid
          people={leads}
          photoBase="/community/leads"
          columns={3}
          photoSize={220}
          columnWidth={350}
          align="center"
        />

        <div class="your-city">
          <h2>your city?</h2>
          <p>we're looking for community leads worldwide. we run calls city by city, and accept applications on a rolling basis.</p>
          <button type="button" class="btn btn-primary" onclick="window.openCityLeadModal && window.openCityLeadModal()">apply to lead your city</button>
        </div>

        <p class="socials-line">
          we're also looking for volunteers to help run our socials. apply <button type="button" class="link-button" onclick="window.openSocialsModal && window.openSocialsModal()">here</button>.
        </p>
      </div>
    </section>

    <section id="past-events" class="past-events">
      <div class="container">
        <h2>past events</h2>

        <!-- Counters: derived from the events collection -->
        <div class="event-counters">
          {counters.map((c) => (
            <div class="event-counter">
              <span class="event-counter-value">{c.value}</span>
              <span class="event-counter-label">{c.label}</span>
            </div>
          ))}
        </div>

        <!-- Filter Section -->
        <div class="event-filters">
          <div class="filter-group">
            <label for="filter-type">Filter by:</label>
            <div class="filter-dropdown">
              <button class="filter-button" id="filter-type-btn" aria-haspopup="true" aria-expanded="false">
                <span class="filter-label">Type</span>
                <span class="filter-arrow">&#9660;</span>
              </button>
              <ul class="filter-menu" id="filter-type-menu">
                <li><button class="filter-option" data-filter="type" data-value="">All Types</button></li>
                {eventTypes.map((type) => (
                  <li><button class="filter-option" data-filter="type" data-value={type}>{capitalize(type)}</button></li>
                ))}
              </ul>
            </div>
          </div>

          <div class="filter-group">
            <div class="filter-dropdown">
              <button class="filter-button" id="filter-location-btn" aria-haspopup="true" aria-expanded="false">
                <span class="filter-label">Location</span>
                <span class="filter-arrow">&#9660;</span>
              </button>
              <ul class="filter-menu filter-menu-nested" id="filter-location-menu">
                <li><button class="filter-option" data-filter="location" data-value="">All Locations</button></li>
                {locationGroups.map((group) => (
                  <li class="filter-submenu">
                    <button class="filter-option filter-submenu-trigger" data-filter="location" data-value={group.country}>
                      {group.country} <span class="submenu-arrow">&#9654;</span>
                    </button>
                    <ul class="filter-submenu-list">
                      {group.cities.map((city) => (
                        <li><button class="filter-option" data-filter="location" data-value={`${city}, ${group.country}`}>{city}</button></li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <button class="clear-filters" id="clear-filters-btn">Clear Filters</button>
        </div>

        <div class="card-grid">
          {events.map((event) => {
            const { all, shown, overflow } = orgTags(event.data);
            return (
              <div
                class="card"
                data-event-id={event.id}
                data-event-type={event.data.type}
                data-event-country={event.data.country}
                data-event-city={event.data.city}
              >
                {event.data.photo && (
                  <img
                    src={`/community/events/${event.data.photo}`}
                    alt={`${event.data.title} in ${event.data.city}, ${event.data.country}`}
                    class="event-image"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <p class="event-date">{formatDateRange(event.data.date, event.data.endDate)}</p>
                <h3>{event.data.title}</h3>
                <div class="event-meta">
                  <span class="event-type">{capitalize(event.data.type)}</span>
                  <span class="event-location">{event.data.city}, {event.data.country}</span>
                </div>
                {shown.length > 0 && (
                  <div class="org-tags">
                    {shown.map((tag) =>
                      tag.url ? (
                        <a
                          class={`org-tag org-tag-${tag.kind} org-tag-link`}
                          href={tag.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          onclick="event.stopPropagation()"
                        >{tag.name}</a>
                      ) : (
                        <span class={`org-tag org-tag-${tag.kind}`}>{tag.name}</span>
                      )
                    )}
                    {overflow > 0 && <span class="org-tag org-tag-more">+{overflow} more</span>}
                  </div>
                )}
                {/* The complete tag set, for the modal. The card truncates to
                    MAX_TAGS and counts the remainder, so the modal cannot be
                    built by copying what the card displays. A template is never
                    rendered, so this costs the card nothing. */}
                <template class="event-all-tags">
                  {all.map((tag) =>
                    tag.url ? (
                      <a
                        class={`org-tag org-tag-${tag.kind} org-tag-link`}
                        href={tag.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >{tag.name}</a>
                    ) : (
                      <span class={`org-tag org-tag-${tag.kind}`}>{tag.name}</span>
                    )
                  )}
                </template>
                <div class="card-content">
                  {(event.data.description ?? '').split('\n\n').filter(Boolean).map((para) => (
                    <p>{para}</p>
                  ))}
                  {(event.data.quotes ?? []).map((quote) => (
                    <p>"{quote}"</p>
                  ))}
                </div>
                <button class="see-more-btn">See more...</button>
                {event.data.rating !== undefined && (
                  <p class="star-rating">&#11088;&#11088;&#11088;&#11088;&#11088; {event.data.rating}/5</p>
                )}
                {(event.data.linkedinUrl || listingUrl(event.data)) && (
                  <div class="event-links">
                    {event.data.linkedinUrl && (
                      <a
                        href={event.data.linkedinUrl}
                        class="event-link linkedin-link"
                        title="View on LinkedIn"
                        aria-label="View on LinkedIn"
                        target="_blank"
                        rel="noopener noreferrer"
                        onclick="event.stopPropagation()"
                      >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                      </a>
                    )}
                    {listingUrl(event.data) && (
                      <a
                        href={listingUrl(event.data)}
                        class="event-link listing-link"
                        title="View the event listing"
                        aria-label="View the event listing"
                        target="_blank"
                        rel="noopener noreferrer"
                        onclick="event.stopPropagation()"
                      >
                        {/* Generic calendar mark — the listing may be on Luma, a
                            university site, a students' union or Partiful. */}
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M7 1h2.5v3H7V1zm7.5 0H17v3h-2.5V1zM2 5.5h3.5v1.75h3.5V5.5h6v1.75h3.5V5.5H22V23H2V5.5zm2.5 4.75v10.25h15V10.25h-15z"/>
                          <rect x="6.25" y="12.5" width="2.75" height="2.5"/>
                          <rect x="10.6" y="12.5" width="2.75" height="2.5"/>
                          <rect x="14.95" y="12.5" width="2.75" height="2.5"/>
                          <rect x="6.25" y="16.5" width="2.75" height="2.5"/>
                          <rect x="10.6" y="16.5" width="2.75" height="2.5"/>
                        </svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>

        <p class="events-outro">
          We run these with partners and sponsors.
          <a href="/partners">Partner with us</a>.
        </p>
      </div>
    </section>

    <section class="cta-section">
      <div class="container text-center">
        <h2>ready to apply for the accelerator?</h2>
        <p>If you're ready to take the next step, check out our accelerator program.</p>
        <div class="btn-group" style="justify-content: center;">
          <a href="/accelerator" class="btn btn-primary">Accelerator</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <FormModal
    id="apply-modal"
    openFunction="openApplyModal"
    title="apply to join the community"
    endpoint="/api/community-apply"
    fields={COMMUNITY_FIELDS}
    successMessage="Thank you for applying to join our community. We'll be in touch soon."
  />

  <FormModal
    id="city-lead-modal"
    openFunction="openCityLeadModal"
    title="apply to lead your city"
    endpoint="/api/community-role-apply"
    fields={CITY_LEAD_FIELDS}
    extra={{ role: 'city-lead' }}
    successMessage="Thank you for applying to lead your city. We'll be in touch soon."
  />

  <FormModal
    id="socials-modal"
    openFunction="openSocialsModal"
    title="apply to run our socials"
    endpoint="/api/community-role-apply"
    fields={SOCIALS_FIELDS}
    extra={{ role: 'socials' }}
    successMessage="Thank you for applying to run our socials. We'll be in touch soon."
  />

  <!-- Event Modal -->
  <div id="event-modal" class="event-modal">
    <div class="modal-overlay"></div>
    <div class="modal-content">
      <button class="modal-close" aria-label="Close modal">&times;</button>
      <img id="modal-image" src="" alt="" class="modal-image" />
      <p id="modal-date" class="modal-date"></p>
      <h2 id="modal-title" class="modal-title"></h2>
      <div id="modal-meta" class="modal-meta">
        <span class="event-type" id="modal-event-type"></span>
        <span class="event-location" id="modal-event-location"></span>
      </div>
      <div id="modal-tags" class="org-tags modal-tags"></div>
      <div id="modal-body" class="modal-body"></div>
      <p id="modal-rating" class="modal-rating"></p>
      <!-- Filled by cloning the card's own links, so the modal carries every
           link the card does — the listing as well as LinkedIn. -->
      <div id="modal-links" class="event-links modal-links"></div>
    </div>
  </div>
</BaseLayout>

<script>
  window.addEventListener('load', () => {
    if (window.location.hash === '#apply') {
      (window as any).openApplyModal && (window as any).openApplyModal();
      return;
    }

    // Re-run the jump to a hash target once everything has loaded. The events
    // grid fills in lazily, so the browser's own jump happens while the page
    // is still short and lands well above the section asked for. `load` fires
    // after the images are in, when the layout has settled, and
    // `scrollIntoView` honours the target's `scroll-margin-top` so the sticky
    // nav doesn't cover the heading.
    const { hash } = window.location;
    if (!hash || hash.length < 2) return;
    let target: Element | null = null;
    try {
      target = document.querySelector(hash);
    } catch {
      return; // Not a usable selector — leave the browser's behaviour alone.
    }
    target?.scrollIntoView();
  });
</script>

<style>
  /* Stats act as the hero — first thing on the page, tightened right up. */
  .community-hero {
    padding: 3.5rem 0 2.5rem;
  }

  /* Content-sized columns with the slack spread between them: the first stat
     sits flush against the container's left edge (so it lines up with the
     headline below) and the last ends flush right. Equal thirds left a gap
     after "1,500+" and a ragged right edge, because the numbers differ in
     width. */
  .stat-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .stat-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
  }

  .stat-value {
    display: block;
    white-space: nowrap;
    text-indent: var(--stat-indent, 0);
    font-size: var(--text-display);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .stat-label {
    display: block;
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.3;
  }

  .community {
    background: rgba(0, 0, 0, 0.2);
    padding: 3rem 0;
  }

  /* The page's statement of intent: below the stats, above body copy. */
  .statement {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.15;
    color: var(--color-text);
    max-width: 20ch;
    margin: 5rem 0 0;
  }

  .community-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .community-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2.5rem;
    border-radius: 0;
    transition: all 0.3s ease;
  }

  .community-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .community-card h2 {
    color: var(--color-text);
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .community-card p {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .cta-section {
    padding: 4rem 0;
  }

  .cta-section p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  /* ── Your city? ── */
  /* Landing target for /about's "become a community lead" button. The sticky
     nav would otherwise cover the heading it scrolls to, so the section
     reserves the bar's height above itself. */
  .leads {
    scroll-margin-top: 7rem;
  }

  /* The heading sits well clear of the portraits: three large circles need
     air above them or they read as crowding the section title. */
  .leads > .container > h2 {
    margin-bottom: 4rem;
  }

  .your-city {
    margin-top: 5rem;
    padding: 3rem;
    border: 1px solid var(--color-border-accent);
    background: var(--color-surface-raised);
  }

  .your-city h2 {
    margin-bottom: 1rem;
  }

  .your-city p {
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .socials-line {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .link-button {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-primary);
    font-size: inherit;
    color: var(--color-primary);
    text-decoration: underline;
    cursor: pointer;
  }

  .link-button:hover {
    color: var(--color-primary-hover);
  }

  /* Breakpoints come after the base rules so they actually win. */
  @media (max-width: 768px) {
    .stat-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .community-options {
      grid-template-columns: 1fr;
    }

    .your-city {
      padding: 2rem 1.5rem;
    }
  }

  /* ── Past events, moved from /about ── */
  .past-events {
    padding: 4rem 0;
  }

  .events-outro {
    margin-top: 3rem;
    color: var(--color-text-muted);
  }

  .events-outro a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .events-outro a:hover {
    color: var(--color-primary-hover);
  }

  /* Counters — values come from the events collection */
  .event-counters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .event-counter {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .event-counter-value {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--color-primary);
  }

  .event-counter-label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  /* Organisation tags. Sponsors and in-kind share one colour; community
     partners take another. No tier labels — colour alone separates them. */
  .org-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .org-tag {
    font-size: var(--text-xs);
