---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import AsSeenIn from '../components/AsSeenIn.astro';
import { getCollection } from 'astro:content';
import { getEventStats } from '../lib/eventStats';

const eventStats = getEventStats(await getCollection('events'));

const routes = [
  {
    label: 'fund',
    href: '/fund',
    body: 'First cheques into all-female, all-technical teams at pre-seed. Cornerstone-backed by the British Business Bank.',
  },
  {
    label: 'accelerator',
    href: '/accelerator',
    body: 'Eight weeks: two in person in Norway, six hybrid. Twenty founders, 7.4% acceptance rate.',
  },
  {
    label: 'community',
    href: '/community',
    body: `${eventStats.eventCount} events and counting, ${eventStats.cityCount} cities, 1,500+ technical women.`,
  },
];

/**
 * Every figure here that can come from the events collection does. Only the
 * two that can't — people hosted and follower count — are written in.
 *
 * `indent` is an optical correction — a leading "1" carries ~0.087em of left
 * side bearing and a "3" ~0.029em, so the number's ink is nudged left to sit
 * where its label's first letter starts. In em so it tracks the clamped size.
 */
const LEADING_DIGIT_INDENT: Record<string, string> = {
  '1': '0.087em',
  '3': '0.029em',
};

const indentFor = (value: string) => LEADING_DIGIT_INDENT[value[0]] ?? '0em';

const numbers = [
  { value: String(eventStats.eventCount), label: 'events' },
  { value: String(eventStats.cityCount), label: 'cities' },
  { value: '1,500+', label: 'technical women hosted in person' },
  { value: '10,500+', label: 'followers' },
].map((n) => ({ ...n, indent: indentFor(n.value) }));

// Amplitude removed at the client's request.
// Most marks are white-on-transparent, so the default brightness(0) invert(1)
// is a no-op that only bites on the few coloured ones. `tone` overrides it for
// artwork that carries its own light/dark structure and would flatten into a
// solid white slab.
const partnerLogos = [
  { file: 'nfx.png', name: 'NFX' },
  // Knocked-out artwork: flattening to white would fill the plate solid.
  { file: 'notion.png', name: 'Notion', tone: 'threshold' },
  { file: 'nvidia.png', name: 'NVIDIA' },
  { file: 'google_cloud.png', name: 'Google Cloud' },
  { file: 'aws.png', name: 'AWS' },
  // Coloured plate with the letters knocked out of it, same as Notion.
  { file: 'innovate-uk.png', name: 'Innovate UK', tone: 'threshold' },
  { file: 'aria.png', name: 'ARIA' },
  { file: 'angellist.png', name: 'AngelList' },
  { file: 'vercel.png', name: 'Vercel' },
  { file: 'ada.png', name: 'Ada' },
  { file: 'cursor.png', name: 'Cursor' },
  { file: 'elevenlabs.png', name: 'ElevenLabs' },
  { file: 'codecademy.png', name: 'Codecademy' },
  { file: 'beringea.png', name: 'Beringea' },
  { file: 'pillar.png', name: 'Pillar' },
  { file: 'samos.png', name: 'Samos Investments' },
  { file: 'incident.png', name: 'Incident.io' },
  { file: 'bang-olufsen.png', name: 'Bang & Olufsen' },
];

// The track is rendered twice so the marquee can loop seamlessly.
const marquee = [...partnerLogos, ...partnerLogos];
---

<BaseLayout
  title="Home"
  description="Backing the next generation of female tech billionaires."
>
  <Navigation />
  <main class="home">
    <!-- 1. Hero -->
    <section class="hero">
      <!-- Full-bleed picture starting under the nav; the copy sits on it. -->
      <div class="hero-media">
        <img
          src="/index/hero.jpg"
          alt="A Tech Bros cohort member in a t-shirt reading 'yes Chad, I really do understand the algorithm'"
          class="hero-img"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          width="6000"
          height="3212"
        />
        <div class="hero-scrim"></div>
        <div class="container hero-content">
          <h1>backing the next generation of female tech <span class="accent">billionaires</span></h1>
          <p class="hero-line">the world's first all-female, all-technical accelerator</p>
          <div class="btn-group">
            <a href="/fund" class="btn btn-primary">the fund</a>
            <a href="/accelerator" class="btn btn-tertiary">the accelerator</a>
          </div>
        </div>
      </div>
    </section>

    <!-- As seen in -->
    <AsSeenIn />

    <!-- What we do -->
    <section class="what-we-do">
      <div class="container">
        <h2>what we do</h2>
        <div class="route-grid">
          {routes.map((route) => (
            <a href={route.href} class="route-card">
              <span class="route-label">{route.label}</span>
              <span class="route-body">{route.body}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Yes Chad — full-bleed, between what we do and the numbers -->
    <section class="chad">
      <div class="holo chad-block">
        <p>yes Chad, I really do understand the algorithm</p>
      </div>
    </section>

    <!-- The numbers -->
    <section class="numbers">
      <div class="container">
        <div class="number-row">
          {numbers.map((item) => (
            <div class="number-block" style={`--stat-indent: -${item.indent}`}>
              <span class="number-value">{item.value}</span>
              <span class="number-label">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Partners & sponsors -->
    <section class="partners">
      <div class="container">
        <div class="partner-row">
          <!-- Fixed: sits on the same line as the scrolling logos but never moves. -->
          <div class="lead-sponsor">
            <p class="partners-heading">2026 lead sponsor</p>
            <div class="lead-sponsor-mark">
              <img
                src="/index/partner-logos/goodwin.png"
                alt="Goodwin"
                class="lead-sponsor-logo"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="partner-wall">
            <p class="partners-heading">past partners &amp; sponsors</p>
            <div class="logo-carousel">
              <div class="logo-carousel-track">
                {marquee.map((logo) => (
                  <div class="logo-item">
                    <img
                      src={`/index/partner-logos/${logo.file}`}
                      alt={logo.name}
                      data-tone={logo.tone}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="btn-group">
          <a href="/partners" class="btn btn-tertiary">partners &amp; sponsors</a>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="closing">
      <div class="container">
        <p>we're betting on a new kind of tech bro.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .home section {
    padding: 5rem 0;
  }

  .home h2 {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 2.5rem;
  }

  /* ── 1. Hero ── */
  /* Selector has to out-specify `.home section` above, or the generic block
     padding would reopen a gap under the nav. */
  .home section.hero {
    padding: 0;
  }

  /* hero.jpg is 6000x3212, so its own height is 53.533vw; 48.18vw is 90% of
     that, giving a frame that shows the bottom nine tenths and loses only the
     sky. Capped so it can't eat a short screen. Expressed as a height rather
     than `aspect-ratio`, because aspect-ratio under a max-height makes Chrome
     shrink the *width* to keep the ratio — which would letterbox the hero
     instead of running it full-bleed. */
  .hero-media {
    position: relative;
    width: 100%;
    height: min(48.18vw, 90vh);
    min-height: 34rem;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Anchored to the bottom, so the crop is taken entirely off the sky and
       treetops and the table, laptops and people sit higher in view. */
    object-position: center bottom;
  }

  /* Three washes. The bottom and left ones stay light — they only set the
     mood. The work of making the copy legible is done by a third wash pinned
     to the bottom-left corner, so the darkness is spent where the words are
     instead of being spread over the whole frame; the top two thirds of the
     picture stay close to untouched. Held in custom properties so the narrow
     breakpoint re-tunes the same three layers rather than redefining them. */
  .hero-scrim {
    --scrim-bottom: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.52) 22%,
      rgba(0, 0, 0, 0.24) 50%,
      rgba(0, 0, 0, 0.06) 75%,
      rgba(0, 0, 0, 0) 100%
    );
    --scrim-left: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.26) 0%,
      rgba(0, 0, 0, 0.08) 45%,
      rgba(0, 0, 0, 0) 70%
    );
    --scrim-copy: radial-gradient(
      145% 100% at 0% 100%,
      rgba(0, 0, 0, 0.93) 0%,
      rgba(0, 0, 0, 0.8) 40%,
      rgba(0, 0, 0, 0.38) 70%,
      rgba(0, 0, 0, 0) 92%
    );
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--scrim-copy), var(--scrim-bottom), var(--scrim-left);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 8rem;
    padding-bottom: 4rem;
  }

  .hero h1 {
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .hero h1 .accent {
    color: var(--color-primary);
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 64ch;
    margin-bottom: 0;
  }

  .hero .btn-group {
    margin-top: 2.5rem;
  }

  /* ── 3. What we do ── */
  .route-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  /* No borders: the cards sit straight on black. The whole anchor is the
     link, and hover lifts every part of it so the target reads as the card
     rather than the heading. */
  .route-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .route-label {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text);
    line-height: 1.1;
    transition: color var(--transition);
  }

  .route-body {
    color: var(--color-text-body);
    line-height: 1.55;
    transition: color var(--transition);
  }

  .route-card:hover .route-label,
  .route-card:focus-visible .route-label {
    color: var(--color-primary);
  }

  .route-card:hover .route-body,
  .route-card:focus-visible .route-body {
    color: var(--color-text);
  }

  /* ── 4. The numbers ── */
  /* Reads as one block with the banner above it: no rule at the top (the
     holographic band is the divider) and only a short gap under it. The rule
     and spacing below the row are unchanged. Selector out-specifies
     `.home section` above, which would otherwise reimpose 5rem. */
  .home section.numbers {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .home section.partners {
    padding-top: 2rem;
  }

  .number-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3rem;
    border-bottom: 1px solid var(--color-border);
    padding: 0 0 3rem;
  }

  .number-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
  }

  .number-value {
    display: block;
    white-space: nowrap;
    /* Optical correction so the label lines up with the number's ink. */
    text-indent: var(--stat-indent, 0);
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .number-label {
    display: block;
    font-size: var(--text-small);
    color: var(--color-text);
    line-height: 1.3;
  }

  /* ── Yes Chad — full-bleed, no container, text held to the right ── */
  /* No padding at all: the block butts straight onto the hero image. */
  .home section.chad {
    padding: 0;
  }

  .chad-block {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    /* Sized to the two lines of type, not the other way round. */
    padding: 3rem 2rem;
    display: flex;
    justify-content: flex-end;
  }

  .chad-block p {
    font-size: var(--text-h2);
    line-height: 1.15;
    max-width: 24ch;
    margin-bottom: 0;
    text-align: right;
  }

  /* ── Partners & sponsors ── */
  .partners-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    /* Both labels sit on the same line above their content. */
    min-height: 1.2em;
  }

  /* The live sponsor is called out; the archive stays muted. */
  .lead-sponsor .partners-heading {
    color: var(--color-primary);
    font-weight: 700;
  }

  .partner-row {
    display: grid;
    /* Fixed left column so the two labels never crowd each other. */
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  /* The lockup and the carousel share a baseline: same box height, so the
     Goodwin mark lines up with the scrolling logos beside it. */
  .lead-sponsor-mark,
  .logo-item {
    height: 112px;
    display: flex;
    align-items: center;
  }

  /* Goodwin and the scrolling marks share one cap height, centred in boxes of
     equal height, so they land on the same optical line. */
  .lead-sponsor-logo,
  .logo-item img {
    display: block;
    width: auto;
    height: auto;
    max-height: 72px;
    max-width: 100%;
    object-fit: contain;
    /* Same treatment as the as-seen-in strip: white on black, whatever the
       source artwork's colours. */
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* Artwork whose meaning lives in its own light/dark structure — a coloured
     plate with the letters knocked out of it. Flattening that to white fills
     the plate solid and loses the mark, so instead grayscale plus a hard
     contrast push drops the plate to black and lifts the letters to white. */
  .logo-item img[data-tone='threshold'] {
    filter: grayscale(1) contrast(5);
  }

  .logo-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Fades at both ends so marks dissolve instead of being sliced by the
       overflow edge on the way in and out. */
    mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
  }

  .logo-carousel-track {
    display: flex;
    gap: 4rem;
    animation: scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel-track {
      animation: none;
    }
  }

  .logo-item {
    flex-shrink: 0;
    width: 220px;
    justify-content: center;
    padding: 0 1rem;
  }

  .partners .btn-group {
    margin-top: 0;
  }

  /* ── Closing ── */
  .closing {
    border-top: 1px solid var(--color-border);
  }

  .closing p {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-text);
    max-width: 20ch;
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .route-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .home section {
      padding: 3.5rem 0;
    }

    .hero-media {
      /* Too narrow for 16:9 to be tall enough to hold the copy. */
      height: auto;
      min-height: 72vh;
    }

    .hero-scrim {
      --scrim-bottom: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.76) 0%,
        rgba(0, 0, 0, 0.6) 25%,
        rgba(0, 0, 0, 0.32) 52%,
        rgba(0, 0, 0, 0.12) 75%,
        rgba(0, 0, 0, 0) 100%
      );
      --scrim-left: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.24) 0%,
        rgba(0, 0, 0, 0.12) 60%,
        rgba(0, 0, 0, 0.08) 100%
      );
      --scrim-copy: radial-gradient(
        170% 90% at 0% 100%,
        rgba(0, 0, 0, 0.93) 0%,
        rgba(0, 0, 0, 0.82) 45%,
        rgba(0, 0, 0, 0.45) 75%,
        rgba(0, 0, 0, 0) 95%
      );
    }

    .hero-content {
      padding-top: 6rem;
      padding-bottom: 2.5rem;
    }


    .home section.numbers {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .home section.partners {
      padding-top: 1.5rem;
    }

    .number-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .chad-block {
      padding: 2.25rem 1.5rem;
    }

    /* Lead sponsor stacks above the carousel. */
    .partner-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .lead-sponsor-mark,
    .logo-item {
      height: 88px;
    }

    .lead-sponsor-logo,
    .logo-item img {
      max-height: 56px;
    }

    .logo-item {
      width: 170px;
    }
  }
</style>
