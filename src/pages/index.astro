---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import AsSeenIn from '../components/AsSeenIn.astro';
import { getCollection } from 'astro:content';
import { getEventStats } from '../lib/eventStats';

const eventStats = getEventStats(await getCollection('events'));

const routes = [
  {
    label: 'fund',
    href: '/fund',
    body: 'First cheques into all-female, all-technical teams at pre-seed. Cornerstone-backed by the British Business Bank.',
  },
  {
    label: 'accelerator',
    href: '/accelerator',
    body: 'Eight weeks: two in person in Norway, six hybrid. Twenty founders, 7.4% acceptance rate.',
  },
  {
    label: 'community',
    href: '/community',
    body: `${eventStats.eventCount} events and counting, ${eventStats.cityCount} cities, 1,500+ technical women.`,
  },
];

/**
 * Every figure here that can come from the events collection does. Only the
 * two that can't — people hosted and follower count — are written in.
 *
 * `indent` is an optical correction — a leading "1" carries ~0.087em of left
 * side bearing and a "3" ~0.029em, so the number's ink is nudged left to sit
 * where its label's first letter starts. In em so it tracks the clamped size.
 */
const LEADING_DIGIT_INDENT: Record<string, string> = {
  '1': '0.087em',
  '3': '0.029em',
};

const indentFor = (value: string) => LEADING_DIGIT_INDENT[value[0]] ?? '0em';

const numbers = [
  { value: String(eventStats.eventCount), label: 'events' },
  { value: String(eventStats.cityCount), label: 'cities' },
  { value: '1,500+', label: 'technical women hosted in person' },
  { value: '10,500+', label: 'followers' },
].map((n) => ({ ...n, indent: indentFor(n.value) }));

// Amplitude removed at the client's request.
const partnerLogos = [
  { file: 'nfx.png', name: 'NFX' },
  { file: 'notion.png', name: 'Notion' },
  { file: 'nvidia.png', name: 'NVIDIA' },
  { file: 'google_cloud.png', name: 'Google Cloud' },
  { file: 'aws.png', name: 'AWS' },
  { file: 'innovate-uk.png', name: 'Innovate UK' },
  { file: 'aria.png', name: 'ARIA' },
  { file: 'angellist.png', name: 'AngelList' },
  { file: 'vercel.png', name: 'Vercel' },
  { file: 'ada.png', name: 'Ada' },
  { file: 'cursor.png', name: 'Cursor' },
  { file: 'elevenlabs.png', name: 'ElevenLabs' },
  { file: 'codecademy.png', name: 'Codecademy' },
  { file: 'beringea.png', name: 'Beringea' },
  { file: 'pillar.png', name: 'Pillar' },
  { file: 'samos.png', name: 'Samos Investments' },
  { file: 'incident.png', name: 'Incident.io' },
  { file: 'bang-olufsen.png', name: 'Bang & Olufsen' },
];

// The track is rendered twice so the marquee can loop seamlessly.
const marquee = [...partnerLogos, ...partnerLogos];
---

<BaseLayout
  title="Home"
  description="Backing the next generation of female tech billionaires."
>
  <Navigation />
  <main class="home">
    <!-- 1. Hero -->
    <section class="hero">
      <div class="container">
        <h1>backing the next generation of female tech billionaires</h1>
        <p class="hero-line">
          the world's first all-female, all-technical accelerator - and the only fund backing
          exclusively all-female, all-technical teams.
        </p>
        <div class="btn-group">
          <a href="/fund" class="btn btn-primary">the fund</a>
          <a href="/accelerator" class="btn btn-tertiary">the accelerator</a>
        </div>
      </div>

      <!-- Full-bleed and uncropped: the t-shirt is the point. -->
      <div class="hero-image">
        <img
          src="/index/hero.jpg"
          alt="A Tech Bros cohort member in a t-shirt reading 'yes Chad, I really do understand the algorithm'"
          class="hero-img"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          width="1920"
          height="1080"
        />
      </div>
    </section>

    <!-- Yes Chad — full-bleed, sitting directly under the hero -->
    <section class="chad">
      <div class="holo chad-block">
        <p>yes Chad, I really do understand the algorithm</p>
      </div>
    </section>

    <!-- As seen in -->
    <AsSeenIn />

    <!-- What we do -->
    <section class="what-we-do">
      <div class="container">
        <h2>what we do</h2>
        <div class="route-grid">
          {routes.map((route) => (
            <a href={route.href} class="route-card">
              <span class="route-label">{route.label}</span>
              <span class="route-body">{route.body}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- The numbers -->
    <section class="numbers">
      <div class="container">
        <div class="number-row">
          {numbers.map((item) => (
            <div class="number-block" style={`--stat-indent: -${item.indent}`}>
              <span class="number-value">{item.value}</span>
              <span class="number-label">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Partners & sponsors -->
    <section class="partners">
      <div class="container">
        <div class="partner-row">
          <!-- Fixed: sits on the same line as the scrolling logos but never moves. -->
          <div class="lead-sponsor">
            <p class="partners-heading">2026 lead sponsor</p>
            <div class="lead-sponsor-mark">
              <img
                src="/index/partner-logos/goodwin.png"
                alt="Goodwin"
                class="lead-sponsor-logo"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="partner-wall">
            <p class="partners-heading">past partners &amp; sponsors</p>
            <div class="logo-carousel">
              <div class="logo-carousel-track">
                {marquee.map((logo) => (
                  <div class="logo-item">
                    <img src={`/index/partner-logos/${logo.file}`} alt={logo.name} loading="lazy" decoding="async" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="btn-group">
          <a href="/partners" class="btn btn-tertiary">partners &amp; sponsors</a>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="closing">
      <div class="container">
        <p>we're betting on a new kind of tech bro.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .home section {
    padding: 5rem 0;
  }

  .home h2 {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 2.5rem;
  }

  /* ── 1. Hero ── */
  .hero {
    padding: 4.5rem 0 0;
  }

  .hero h1 {
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 56ch;
    margin-bottom: 0;
  }

  .hero .btn-group {
    margin-top: 2.5rem;
  }

  /* Full-bleed, natural proportions, no crop. */
  .hero-image {
    width: 100vw;
    margin: 3.5rem 0 0;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── 3. What we do ── */
  .route-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  /* No borders: the cards sit straight on black. The whole anchor is the
     link, and hover lifts every part of it so the target reads as the card
     rather than the heading. */
  .route-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .route-label {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text);
    line-height: 1.1;
    transition: color var(--transition);
  }

  .route-body {
    color: var(--color-text-body);
    line-height: 1.55;
    transition: color var(--transition);
  }

  .route-card:hover .route-label,
  .route-card:focus-visible .route-label {
    color: var(--color-primary);
  }

  .route-card:hover .route-body,
  .route-card:focus-visible .route-body {
    color: var(--color-text);
  }

  /* ── 4. The numbers ── */
  .number-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 3rem 0;
  }

  .number-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
  }

  .number-value {
    display: block;
    white-space: nowrap;
    /* Optical correction so the label lines up with the number's ink. */
    text-indent: var(--stat-indent, 0);
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .number-label {
    display: block;
    font-size: var(--text-small);
    color: var(--color-text);
    line-height: 1.3;
  }

  /* ── Yes Chad — full-bleed, no container, text held to the right ── */
  .chad {
    padding: 0;
  }

  .chad-block {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 6rem 2rem;
    display: flex;
    justify-content: flex-end;
  }

  .chad-block p {
    font-size: var(--text-h2);
    line-height: 1.15;
    max-width: 24ch;
    margin-bottom: 0;
    text-align: right;
  }

  /* ── Partners & sponsors ── */
  .partners-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    /* Both labels sit on the same line above their content. */
    min-height: 1.2em;
  }

  .partner-row {
    display: grid;
    /* Fixed left column so the two labels never crowd each other. */
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  /* The lockup and the carousel share a baseline: same box height, so the
     Goodwin mark lines up with the scrolling logos beside it. */
  .lead-sponsor-mark,
  .logo-item {
    height: 80px;
    display: flex;
    align-items: center;
  }

  .lead-sponsor-logo {
    display: block;
    height: 48px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .logo-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    mask-image: linear-gradient(to right, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent);
  }

  .logo-carousel-track {
    display: flex;
    gap: 4rem;
    animation: scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel-track {
      animation: none;
    }
  }

  .logo-item {
    flex-shrink: 0;
    width: 150px;
    justify-content: center;
    padding: 1rem;
  }

  .logo-item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .partners .btn-group {
    margin-top: 0;
  }

  /* ── Closing ── */
  .closing {
    border-top: 1px solid var(--color-border);
  }

  .closing p {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-text);
    max-width: 20ch;
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .route-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .home section {
      padding: 3.5rem 0;
    }

    .hero {
      padding-top: 3rem;
    }

    .number-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .chad-block {
      padding: 3.5rem 1.5rem;
    }

    /* Lead sponsor stacks above the carousel. */
    .partner-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .lead-sponsor-mark,
    .logo-item {
      height: 64px;
    }

    .logo-item {
      width: 120px;
    }
  }
</style>
