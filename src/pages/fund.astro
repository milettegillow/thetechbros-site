---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getEventStats } from '../lib/eventStats';

const eventStats = getEventStats(await getCollection('events'));

const marketStats = [
  {
    claim: 'Female-founded startups generate 78p revenue per £1 invested, versus 31p for male-founded.',
    graphic: 'revenue-per-pound.png',
    source: 'BCG, 2018',
    url: 'https://www.bcg.com/publications/2018/why-women-owned-startups-are-better-bet',
  },
  {
    claim: 'Female-founded startups reach exit faster.',
    graphic: 'time-to-exit.png',
    source: 'PitchBook, 2023',
    url: 'https://www.prnewswire.com/news-releases/pitchbook-report-on-women-in-vc-ecosystem-highlights-resilience-and-strong-performance-of-female-founders-amid-market-headwinds-301667083.html',
  },
  {
    claim: 'Female founders burn 15% less capital per month.',
    graphic: 'burn-rate.png',
    source: 'Inc, 2025',
    url: 'https://www.inc.com/annabel-burba/female-founders-outperform-their-male-counterparts-but-receive-much-less-funding-study-finds/91212886',
  },
  {
    claim: 'Female teams are the most underrepresented in both decks submitted and investment received.',
    graphic: 'investment-share.png',
    source: 'Founders Forum Group, 2025',
    url: 'https://ff.co/women-funding-statistics-2025/',
  },
];

// Top of funnel: reach, before anyone applies.
const reach = [
  { figure: '15+', label: 'universities' },
  { figure: '10,500+', label: 'followers' },
  { figure: '28', label: 'countries' },
];

const pipeline = [
  {
    figure: String(eventStats.eventCount),
    label: `events across ${eventStats.cityCount} cities and ${eventStats.countryCount} countries`,
  },
  { figure: '1,500+', label: 'technical women hosted in person' },
  { figure: '500+', label: 'applications, all reached organically' },
  { figure: '40', label: 'founders selected' },
  { figure: '2', label: 'cohorts' },
];

/**
 * Where alumni came from. `logo` points at public/index/cohort-logos/; entries
 * with no file fall back to a wordmark. `tone` overrides the default white-out
 * for marks that are a coloured plate with the shape knocked out of it.
 */
const alumniOrigins = [
  { name: 'NASA' },
  { name: 'Tesla', logo: '/index/cohort-logos/tesla.png', height: 40 },
  { name: 'Apple', logo: '/index/cohort-logos/apple.png', height: 40 },
  { name: 'Google', logo: '/index/cohort-logos/google.png', height: 24 },
  { name: 'Amazon' },
  { name: 'Microsoft', logo: '/index/cohort-logos/microsoft.png', height: 22 },
  { name: 'Meta', logo: '/index/cohort-logos/meta.png', height: 22 },
  { name: 'Discord', logo: '/index/cohort-logos/discord.png', height: 36, tone: 'threshold' },
  { name: 'Stanford', logo: '/index/cohort-logos/stanford.png', height: 26 },
  { name: 'MIT', logo: '/index/cohort-logos/mit.png', height: 30 },
  { name: 'Oxford', logo: '/index/cohort-logos/oxford.png', height: 24, tone: 'threshold' },
  { name: 'Cambridge', logo: '/index/cohort-logos/cambridge.png', height: 22 },
  { name: 'UC Berkeley' },
  { name: 'Caltech' },
  { name: 'EPFL' },
  { name: 'Y Combinator', logo: '/index/cohort-logos/ycombinator.png', height: 34, tone: 'knockout' },
];

// Rendered twice so the marquee loops seamlessly, as on the home page.
const alumniMarquee = [...alumniOrigins, ...alumniOrigins];

// Prize winners at Tech Bros events who went on to join cohort 2.
const prizeWinners = [
  'Dimple Amitha Garuadapuri',
  'Amanda \u2018Mango\u2019 Simeon',
  'Nadaa Moharram',
  'Helena Williams',
];

const alumni = [
  { figure: '45%', label: 'ex-big tech engineers', detail: 'Tesla, Apple, Google, NASA' },
  { figure: '70%', label: 'attended a global top 25 university', detail: 'Stanford, MIT, Oxford, Cambridge' },
  { figure: '100%', label: 'STEM', detail: '80% engineering, CS or AI/ML backgrounds' },
  { figure: '7.4%', label: 'acceptance rate, cohort 2' },
];
---

<BaseLayout
  title="Fund"
  description="We back the top 1% of technical female talent at pre-seed."
>
  <Navigation />
  <main class="fund">
    <!-- 1. Headline -->
    <section class="fund-hero">
      <div class="container">
        <h1>we back the top 1% of technical female talent at pre-seed</h1>
        <p class="hero-line">first cheques into all-female, all-technical founding teams.</p>
      </div>
    </section>

    <!-- 2. The market case -->
    <section class="market">
      <div class="container">
        <h2>the market case</h2>

        <div class="lead-stat">
          <span class="lead-stat-figure">2%</span>
          <p class="lead-stat-text">
            Of global venture capital goes to all-female teams.
            <span class="lead-stat-emphasis">In the US, that share has fallen to 1%.</span>
          </p>
        </div>

        <div class="market-supporting">
          <p class="market-frame">the data is unambiguous, and the market has not caught up.</p>

          <ul class="market-grid">
            {marketStats.map((stat) => (
              <li class="market-item">
                <div class="market-graphic">
                  <img
                    src={`/fund/stat-graphics/${stat.graphic}`}
                    alt=""
                    loading="eager"
                    decoding="async"
                    onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                  />
                  <span class="market-graphic-placeholder" hidden aria-hidden="true"></span>
                </div>
                <p class="market-claim">{stat.claim}</p>
                <a class="market-source" href={stat.url} target="_blank" rel="noopener noreferrer">
                  {stat.source}
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    <!-- 3. Who we back -->
    <section class="who">
      <div class="container">
        <h2>who we back</h2>
        <p class="who-line">all-female, all-technical founding teams. pre-seed. first cheque.</p>
        <p class="who-claim">
          we are the only fund in the world backing exclusively all-female, all-technical teams.
        </p>
      </div>
    </section>

    <!-- 4. Backed by the British Business Bank -->
    <section class="bbb">
      <div class="container">
        <h2>backed by the british business bank</h2>
        <p class="bbb-body">
          The British Business Bank is a cornerstone investor in The Tech Bros Fund, through the
          first Microfunds cohort of its £400m Investor Pathways Capital initiative - £90m committed
          across 10 funds, selected from 151 applications.
        </p>
        <div class="btn-group">
          <a href="/press" class="btn btn-secondary">read the coverage</a>
        </div>
      </div>
    </section>

    <!-- 5. Our pipeline -->
    <section class="pipeline">
      <div class="container">
        <h2>our pipeline</h2>
        <ul class="stat-row stat-row-reach">
          {reach.map((step) => (
            <li class="stat-cell">
              <span class="stat-cell-figure">{step.figure}</span>
              <span class="stat-cell-label">{step.label}</span>
            </li>
          ))}
        </ul>

        <ul class="stat-row">
          {pipeline.map((step) => (
            <li class="stat-cell">
              <span class="stat-cell-figure">{step.figure}</span>
              <span class="stat-cell-label">{step.label}</span>
            </li>
          ))}
        </ul>
        <p class="flow-note">
          Four of our twenty cohort 2 founders first came to us as prize winners at Tech Bros
          events: {prizeWinners.map((name, i) => (
            <>
              <span class="flow-name">{name}</span>{i < prizeWinners.length - 2 ? ', ' : i === prizeWinners.length - 2 ? ' and ' : '.'}
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- 6. Alumni quality -->
    <section class="alumni">
      <div class="container">
        <h2>our alumni are exceptional</h2>
        <p class="alumni-frame">
          the accelerator is the top of our funnel. this is who comes through it.
        </p>
        <ul class="alumni-grid">
          {alumni.map((item) => (
            <li class="alumni-item">
              <span class="alumni-figure">{item.figure}</span>
              <span class="alumni-label">{item.label}</span>
              <span class="alumni-detail">{item.detail}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="alumni-origins">
        <div class="container">
          <p class="alumni-origins-heading">where they came from</p>
        </div>
        <div class="origin-carousel">
          <div class="origin-track">
            {alumniMarquee.map((org) => (
              <div class="origin-item">
                {org.logo ? (
                  <img
                    src={org.logo}
                    alt={org.name}
                    class="origin-logo"
                    data-tone={org.tone}
                    style={org.height ? `height: ${org.height}px` : undefined}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="origin-name">{org.name}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Closing -->
    <section class="closing">
      <div class="container">
        <p>we're betting on the founders nobody else is looking at.</p>
      </div>
    </section>

    <!-- 8. Contact -->
    <section class="contact">
      <div class="container">
        <p class="contact-line">
          LP enquiries: <span id="lp-contact"></span>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Assembled at runtime from the central config so the address never appears
  // in the served HTML.
  import { CONTACT_USER, CONTACT_DOMAIN } from '../config';

  const slot = document.getElementById('lp-contact');
  if (slot) {
    const address = `${CONTACT_USER}@${CONTACT_DOMAIN}`;
    const link = document.createElement('a');
    link.href = `mailto:${address}`;
    link.textContent = address;
    slot.appendChild(link);
  }
</script>

<style>
  /* ──────────────────────────────────────────────────────────────────────
     /fund is a thesis and credibility page: black, pink and white only.
     No holographic surface anywhere, including button hover states.
     ────────────────────────────────────────────────────────────────────── */

  .fund section {
    padding: 8rem 0;
  }

  .fund h2 {
    font-size: var(--text-h1);
    color: var(--color-text);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    margin-bottom: 4rem;
  }

  /* ── 1. Headline ── */
  .fund-hero {
    padding: 5rem 0 4rem !important;
  }

  .fund-hero h1 {
    margin-bottom: 2rem;
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* ── 2. The market case ── */
  .lead-stat {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    margin-bottom: 4rem;
  }

  .lead-stat-figure {
    display: block;
    font-size: var(--text-display);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .lead-stat-text {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0;
  }

  .lead-stat-emphasis {
    color: var(--color-primary);
  }

  .market-supporting {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .market-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  /* Fixed slot so the four claims stay on one line whatever each graphic's
     proportions are, and so the row doesn't reflow when the files land. */
  .market-graphic {
    height: 120px;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: flex-end;
  }

  .market-graphic img,
  .market-graphic-placeholder {
    display: block;
    max-height: 120px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  .market-graphic-placeholder {
    width: 100%;
    height: 120px;
    background: var(--color-surface);
  }

  .market-graphic [hidden] {
    display: none !important;
  }

  .market-claim {
    color: var(--color-text);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .market-source {
    display: inline-block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
    margin-bottom: 0;
  }

  .market-source:hover,
  .market-source:focus-visible {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .market-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  /* ── 3. Who we back ── */
  .who .container {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .who-line {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .who-claim {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* ── 4. British Business Bank ── */
  .bbb-body {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* ── 5. Pipeline ──
     Ordinary stat rows, same shape as the alumni figures below and the numbers
     on the home page: figure over label, no connectors. */
  .pipeline .container {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  .stat-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2.5rem;
  }

  /* Reach sits above the funnel and has three items, not five. */
  .stat-row-reach {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 4rem;
  }

  .stat-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-cell-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .stat-cell-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  /* A highlight, not a footnote: full width and above body size. */
  .flow-note {
    margin: 4rem 0 0;
    font-size: var(--text-h3);
    line-height: 1.35;
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text-body);
  }

  /* Names lift out of the body copy; deliberately not links. */
  .flow-name {
    color: var(--color-text);
  }

  /* ── 6. Alumni quality ── */
  .alumni-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }


  .alumni-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .alumni-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .alumni-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .alumni-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  .alumni-detail {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ── Where alumni came from: same marquee as the sponsor wall ── */
  .alumni-origins {
    margin-top: 4.5rem;
  }

  .alumni-origins-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .origin-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Fades at both ends so marks dissolve rather than being sliced. */
    mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
  }

  .origin-track {
    display: flex;
    gap: 4rem;
    animation: origin-scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes origin-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .origin-track {
      animation: none;
    }
  }

  .origin-item {
    flex-shrink: 0;
    width: 200px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
  }

  .origin-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* Coloured plate with the mark knocked out of it: grayscale plus a hard
     contrast push drops the plate to black and lifts the mark to white. */
  .origin-logo[data-tone='threshold'] {
    filter: grayscale(1) contrast(5);
  }

  /* Same idea, but the plate needs pulling below the contrast pivot first. */
  .origin-logo[data-tone='knockout'] {
    filter: grayscale(1) brightness(0.7) contrast(20);
  }

  .origin-name {
    font-size: var(--text-body);
    color: var(--color-text);
    letter-spacing: var(--tracking-subheading);
    white-space: nowrap;
  }

  /* ── 7. Contact ── */
  /* Same treatment as the closing statement on the home page. */
  .closing {
    border-top: 1px solid var(--color-border);
  }

  .closing p {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-text);
    max-width: 20ch;
    margin-bottom: 0;
  }

  .contact {
    padding-top: 0 !important;
  }

  .contact-line {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .contact-line a {
    color: var(--color-primary);
  }

  .contact-line a:hover {
    color: var(--color-primary-hover);
  }

  /* ── No holographic surface on this page ──
     The global tertiary hover fills with foil; here it inverts to solid
     white instead. The colour needs !important to beat the global rule that
     forces black text on the holographic surface. */
  .btn.btn-tertiary:hover,
  .btn.btn-tertiary:focus-visible {
    background: var(--color-white);
    background-image: none;
    border-color: var(--color-white);
    color: var(--color-black) !important;
  }

  @media (max-width: 1024px) {
    .market-grid,
    .alumni-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .fund section {
      padding: 4.5rem 0;
    }

    .fund h2 {
      margin-bottom: 2.5rem;
    }

    .stat-row,
    .stat-row-reach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .market-grid,
    .alumni-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .lead-stat {
      display: block;
    }

    .lead-stat-figure {
      display: block;
      margin-bottom: 0.5rem;
    }
  }
</style>
