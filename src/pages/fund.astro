---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getEventStats } from '../lib/eventStats';
import { COHORT_2 } from '../data/cohort-2';
import { COHORT_STRIP } from '../config';

const eventStats = getEventStats(await getCollection('events'));

// Beat one: how these teams perform. `figure` stands in where there is no
// graphic, so the slot is never left empty.
const evidence = [
  {
    graphic: 'revenue-per-pound.png',
    claim: 'Female-founded startups generate 78p revenue per £1 invested, versus 31p for male-founded.',
    source: 'BCG, 2018',
    url: 'https://www.bcg.com/publications/2018/why-women-owned-startups-are-better-bet',
  },
  {
    graphic: 'time-to-exit.png',
    claim: 'Female-founded startups reach exit faster.',
    source: 'PitchBook, 2023',
    url: 'https://www.prnewswire.com/news-releases/pitchbook-report-on-women-in-vc-ecosystem-highlights-resilience-and-strong-performance-of-female-founders-amid-market-headwinds-301667083.html',
  },
  {
    figure: '15%',
    claim: 'less capital burned per month.',
    source: 'Inc, 2025',
    url: 'https://www.inc.com/annabel-burba/female-founders-outperform-their-male-counterparts-but-receive-much-less-funding-study-finds/91212886',
  },
];

// Beat two: how the market responds.
const gap = {
  graphic: 'investment-share.png',
  source: 'Founders Forum Group, 2025',
  url: 'https://ff.co/women-funding-statistics-2025/',
};

// A digit's left side bearing varies, so a number set flush left doesn't put
// its *ink* flush left. These pull the glyph back so the label lines up with
// it, same correction as the home page and /community.
const LEADING_DIGIT_INDENT: Record<string, string> = {
  '1': '0.087em',
  '3': '0.029em',
};
const indentFor = (value: string) => LEADING_DIGIT_INDENT[value[0]] ?? '0em';

// Top of funnel: reach, before anyone applies.
const reach = [
  { figure: '15+', label: 'universities' },
  { figure: '28', label: 'countries' },
  { figure: '10,500+', label: 'followers' },
  {
    figure: String(eventStats.eventCount),
    label: `events across ${eventStats.cityCount} cities and ${eventStats.countryCount} countries`,
  },
].map((item) => ({ ...item, indent: indentFor(item.figure) }));

const pipeline = [
  { figure: '1,500+', label: 'technical women hosted in person' },
  { figure: '500+', label: 'applications, all reached organically' },
  { figure: '40', label: 'founders selected' },
  { figure: '2', label: 'cohorts' },
].map((item) => ({ ...item, indent: indentFor(item.figure) }));

/**
 * Where alumni came from — the same institutions as the "our founders come
 * from" strip on /accelerator, in the same order, because both are describing
 * the same founders. The list, the ordering and each mark's tuned height live
 * in the shared config; nothing about the set is restated here.
 */
const alumniOrigins = COHORT_STRIP;

// Rendered twice so the marquee loops seamlessly, as on the home page.
const alumniMarquee = [...alumniOrigins, ...alumniOrigins];

// Prize winners at Tech Bros events who went on to join cohort 2. Looked up in
// the cohort 2 data file so the profile links have one source of truth; a name
// that doesn't match there simply renders unlinked rather than pointing wrong.
const PRIZE_WINNER_NAMES = [
  'Dimple Amitha Garuadapuri',
  'Amanda \u2018Mango\u2019 Simeon',
  'Nadaa Moharram',
  'Dr. Helena Williams',
];

const prizeWinners = PRIZE_WINNER_NAMES.map((name) => ({
  name,
  linkedin: COHORT_2.find((person) => person.name === name)?.linkedin,
}));

const alumni = [
  { figure: '45%', label: 'ex-big tech engineers', detail: 'Tesla, Apple, Google, NASA' },
  { figure: '70%', label: 'attended a global top 25 university', detail: 'Stanford, MIT, Oxford, Cambridge' },
  { figure: '100%', label: 'STEM', detail: '80% engineering, CS or AI/ML backgrounds' },
  { figure: '7.4%', label: 'acceptance rate, cohort 2' },
];
---

<BaseLayout
  title="Fund"
  description="We back the top 1% of technical female talent at pre-seed."
>
  <Navigation />
  <main class="fund">
    <!-- 1. Headline -->
    <section class="fund-hero">
      <div class="container">
        <h1>we back the top 1% of technical female talent at pre-seed</h1>
        <p class="hero-line">first cheques into all-female, all-technical founding teams.</p>
      </div>
    </section>

    <!-- 2a. The evidence -->
    <section class="market">
      <div class="container">
        <div class="lead-stat">
          <span class="lead-stat-figure">2%</span>
          <p class="lead-stat-text">
            Of global venture capital goes to all-female teams.
            <span class="lead-stat-emphasis">In the US, that share has fallen to 1%.</span>
          </p>
        </div>

        <div class="market-supporting">
          <h2>the evidence</h2>
          <p class="market-frame">the data is unambiguous, and the market has not caught up.</p>

          <ul class="market-grid">
            {evidence.map((stat) => (
              <li class="market-item">
                {stat.graphic ? (
                  <div class="market-graphic">
                    <img
                      src={`/fund/stat-graphics/${stat.graphic}`}
                      alt=""
                      loading="eager"
                      decoding="async"
                      onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                    />
                    <span class="market-graphic-placeholder" hidden aria-hidden="true"></span>
                  </div>
                ) : (
                  <div class="market-graphic market-graphic-figure">
                    <span class="market-figure">{stat.figure}</span>
                  </div>
                )}
                <p class="market-claim">{stat.claim}</p>
                <a class="market-source" href={stat.url} target="_blank" rel="noopener noreferrer">
                  {stat.source}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 2b. And yet — the same evidence, from the market's side -->
    <section class="gap">
      <div class="container">
        <h2>and yet</h2>
        <div class="gap-layout">
          <div class="gap-graphic">
            <img
              src={`/fund/stat-graphics/${gap.graphic}`}
              alt=""
              loading="eager"
              decoding="async"
              onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
            />
            <span class="gap-graphic-placeholder" hidden aria-hidden="true"></span>
          </div>
          <div class="gap-copy">
            <p>
              All-female teams submit a fraction of the decks, and receive a smaller fraction still
              of the investment.
            </p>
            <p class="gap-close">
              The gap between how these teams perform and how they are funded is the opportunity.
            </p>
            <a class="market-source" href={gap.url} target="_blank" rel="noopener noreferrer">
              {gap.source}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Backed by the British Business Bank -->
    <section class="bbb">
      <div class="container">
        <h2>backed by the british business bank</h2>
        <p class="bbb-body">
          The British Business Bank is a cornerstone investor in The Tech Bros Fund I, through the
          first Microfunds cohort of its £400m Investor Pathways Capital initiative: £90m committed
          across 10 funds, selected from 151 applications.
        </p>
        <div class="btn-group">
          <a href="/press" class="btn btn-secondary">read the coverage</a>
        </div>
      </div>
    </section>

    <!-- 5. Our pipeline -->
    <section class="pipeline">
      <div class="container">
        <h2>our pipeline</h2>
        <p class="row-label">reach</p>
        <ul class="stat-row stat-row-reach">
          {reach.map((step) => (
            <li class="stat-cell" style={`--stat-indent: -${step.indent}`}>
              <span class="stat-cell-figure">{step.figure}</span>
              <span class="stat-cell-label">{step.label}</span>
            </li>
          ))}
        </ul>

        <p class="row-label row-label-second">conversion</p>
        <ul class="stat-row">
          {pipeline.map((step) => (
            <li class="stat-cell" style={`--stat-indent: -${step.indent}`}>
              <span class="stat-cell-figure">{step.figure}</span>
              <span class="stat-cell-label">{step.label}</span>
            </li>
          ))}
        </ul>
        <p class="flow-note">
          Four of our twenty cohort 2 founders first came to us as prize winners at bros
          events: {prizeWinners.map((winner, i) => (
            <>{winner.linkedin ? (<a class="flow-name" href={winner.linkedin} target="_blank" rel="noopener noreferrer">{winner.name}</a>) : (<span class="flow-name">{winner.name}</span>)}{i < prizeWinners.length - 2 ? ', ' : i === prizeWinners.length - 2 ? ' and ' : '.'}</>
          ))}
        </p>
      </div>
    </section>

    <!-- 6. Alumni quality -->
    <section class="alumni">
      <div class="container">
        <h2>our alumni are exceptional</h2>
        <p class="alumni-frame">
          the accelerator is the top of our funnel. this is who comes through it.
        </p>
        <ul class="alumni-grid">
          {alumni.map((item) => (
            <li class="alumni-item">
              <span class="alumni-figure">{item.figure}</span>
              <span class="alumni-label">{item.label}</span>
              <span class="alumni-detail">{item.detail}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="alumni-origins">
        <div class="container">
          <p class="alumni-origins-heading">where they came from</p>
        </div>
        <div class="origin-carousel">
          <div class="origin-track">
            {alumniMarquee.map((org) => (
              <div class="origin-item">
                <img
                  src={org.src}
                  alt={org.name}
                  class="origin-logo"
                  data-tone={org.tone}
                  style={`height: ${org.height}px`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Closing -->
    <section class="closing">
      <div class="container">
        <p>we're betting on the founders<br class="closing-break" />nobody else is looking at.</p>
      </div>
    </section>

    <!-- 8. Contact -->
    <section class="contact">
      <div class="container">
        <p class="contact-line">
          LP enquiries: <span id="lp-contact"></span>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Assembled at runtime from the central config so the address never appears
  // in the served HTML.
  import { CONTACT_USER, CONTACT_DOMAIN } from '../config';

  const slot = document.getElementById('lp-contact');
  if (slot) {
    const address = `${CONTACT_USER}@${CONTACT_DOMAIN}`;
    const link = document.createElement('a');
    link.href = `mailto:${address}`;
    link.textContent = address;
    slot.appendChild(link);
  }
</script>

<style>
  /* ──────────────────────────────────────────────────────────────────────
     /fund is a thesis and credibility page: black, pink and white only.
     No holographic surface anywhere, including button hover states.
     ────────────────────────────────────────────────────────────────────── */

  .fund section {
    padding: 8rem 0;
  }

  .fund h2 {
    font-size: var(--text-h1);
    color: var(--color-text);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    margin-bottom: 4rem;
  }

  /* ── 1. Headline ── */
  .fund-hero {
    padding: 5rem 0 4rem !important;
  }

  .fund-hero h1 {
    margin-bottom: 2rem;
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* ── 2. The market case ── */
  .lead-stat {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
    margin-bottom: 4rem;
  }

  .lead-stat-figure {
    display: block;
    font-size: var(--text-display);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .lead-stat-text {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0;
  }

  .lead-stat-emphasis {
    color: var(--color-primary);
  }

  .market-supporting {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .market-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;
  }

  /* Fixed slot so the four claims stay on one line whatever each graphic's
     proportions are, and so the row doesn't reflow when the files land. */
  /* All four graphics are square canvases with the chart drawn inside, so they
     need real height to be legible. One height across the three keeps the row
     even. */
  /* The graphics are now cropped to the chart itself, so one height across the
     three gives them the same footprint. Centred, so a wider-than-tall chart
     and the standalone figure sit on the same line. */
  .market-graphic {
    /* Fixed height with the graphic centred in it, so all three claims start
       on the same line whatever each chart's proportions are; the margin below
       therefore reads identically across the row. */
    height: 150px;
    margin-bottom: 2.75rem;
    display: flex;
    align-items: center;
  }

  .market-graphic img,
  .market-graphic-placeholder {
    display: block;
    max-height: 150px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  .market-graphic-placeholder {
    width: 100%;
    height: 150px;
    background: var(--color-surface);
  }

  /* Stands in the graphic's slot where there is no graphic, so the three
     claims still sit on one line. */
  .market-graphic-figure {
    align-items: center;
    justify-content: flex-start;
  }

  .market-figure {
    font-size: var(--text-display);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .market-graphic [hidden] {
    display: none !important;
  }

  .market-claim {
    color: var(--color-text);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .market-source {
    display: inline-block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
    margin-bottom: 0;
  }

  .market-source:hover,
  .market-source:focus-visible {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .market-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    /* Set on the framing line rather than the grid, so the gap above the row
       is one value for all three columns and can't drift apart. */
    margin-bottom: 4.5rem;
  }

  /* ── 2b. And yet ──
     The second beat, on its own, with the graphic given room. */
  .gap .container {
    border-top: 1px solid var(--color-border);
    padding-top: 4rem;
  }

  /* A fixed graphic column rather than half the width, so the copy sits beside
     the chart instead of being pushed to the far side of the page. */
  /* A fixed, narrow graphic column with the copy right beside it, both
     starting on the same line — centring left the copy floating against the
     chart's height. */
  .gap-layout {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* A step up from the three above it, not a different order of magnitude. */
  .gap-graphic img,
  .gap-graphic-placeholder {
    display: block;
    width: 100%;
    /* Capped well inside half the content width, so it reads as a step up
       from the three above rather than as the page's subject. */
    max-width: min(100%, 300px);
    height: auto;
    object-fit: contain;
  }

  .gap-graphic-placeholder {
    height: 250px;
    background: var(--color-surface);
  }

  .gap-graphic [hidden] {
    display: none !important;
  }

  .gap-copy p {
    font-size: var(--text-h4);
    line-height: 1.45;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .gap-close {
    color: var(--color-primary) !important;
  }

  .gap-copy .market-source {
    margin-top: 0.75rem;
  }

  /* ── 4. British Business Bank ── */
  .bbb-body {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* ── 5. Pipeline ──
     Ordinary stat rows, same shape as the alumni figures below and the numbers
     on the home page: figure over label, no connectors. */
  .pipeline .container {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  /* Both rows carry four items on the same four columns, so every cell sits
     directly above its opposite number. */
  .stat-row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .stat-row-reach {
    margin-bottom: 2.5rem;
  }

  .row-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .row-label-second {
    margin-top: 0;
  }

  .stat-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    text-align: left;
  }

  .stat-cell-figure {
    display: block;
    white-space: nowrap;
    /* Optical correction so the label lines up with the number's ink. */
    text-indent: var(--stat-indent, 0);
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .stat-cell-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  /* A highlight, not a footnote: full width and above body size. */
  .flow-note {
    margin: 4rem 0 0;
    font-size: var(--text-h3);
    line-height: 1.35;
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text-body);
  }

  /* Each name links to that founder's profile. */
  .flow-name {
    color: var(--color-primary);
    text-decoration: none;
  }

  a.flow-name:hover,
  a.flow-name:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── 6. Alumni quality ── */
  .alumni-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }


  .alumni-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .alumni-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .alumni-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .alumni-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  .alumni-detail {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ── Where alumni came from: same marquee as the sponsor wall ── */
  .alumni-origins {
    margin-top: 4.5rem;
  }

  .alumni-origins-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .origin-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Fades at both ends so marks dissolve rather than being sliced. */
    mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
  }

  .origin-track {
    display: flex;
    gap: 4rem;
    animation: origin-scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes origin-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .origin-track {
      animation: none;
    }
  }

  .origin-item {
    flex-shrink: 0;
    width: 200px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
  }

  .origin-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* Coloured plate with the mark knocked out of it: grayscale plus a hard
     contrast push drops the plate to black and lifts the mark to white. */
  .origin-logo[data-tone='threshold'] {
    filter: grayscale(1) contrast(5);
  }

  /* Same idea, but the plate needs pulling below the contrast pivot first. */
  .origin-logo[data-tone='knockout'] {
    filter: grayscale(1) brightness(0.7) contrast(20);
  }

  /* A lockup that is both a coloured plate and dark type beside it. Inverting
     first drops the plate below the contrast pivot and lifts the type above
     it, so one pass keeps the knocked-out glyph *and* the wordmark. */
  .origin-logo[data-tone='plate'] {
    filter: invert(1) grayscale(1) brightness(1.2) contrast(3);
  }

  /* ── 7. Contact ── */
  /* Same treatment as the closing statement on the home page. */
  .closing {
    border-top: 1px solid var(--color-border);
  }

  .closing p {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--color-text);
    /* The manual break sets the two lines; a measure here would wrap the copy
       before it ever reached the break. */
    margin-bottom: 0;
  }

  .contact {
    padding-top: 0 !important;
  }

  .contact-line {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .contact-line a {
    color: var(--color-primary);
  }

  .contact-line a:hover {
    color: var(--color-primary-hover);
  }

  /* ── No holographic surface on this page ──
     The global tertiary hover fills with foil; here it inverts to solid
     white instead. The colour needs !important to beat the global rule that
     forces black text on the holographic surface. */
  .btn.btn-tertiary:hover,
  .btn.btn-tertiary:focus-visible {
    background: var(--color-white);
    background-image: none;
    border-color: var(--color-white);
    color: var(--color-black) !important;
  }

  @media (max-width: 1024px) {
    .market-grid,
    .alumni-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gap-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .stat-row,
    .stat-row-reach {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .fund section {
