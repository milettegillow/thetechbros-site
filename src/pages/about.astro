---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COMMUNITY_LEADS } from '../config';
import { VENTURE_PARTNERS } from '../data/people';
import { getEventStats, getEventsByYear } from '../lib/eventStats';

const events = await getCollection('events');
const eventStats = getEventStats(events);
const eventYears = getEventsByYear(events);
// The bars are proportional, so the tallest year sets the scale.
const peakYear = Math.max(...eventYears.map((y) => y.count));
// Only the most recent year is part-run; the rest are complete.
const currentYear = eventYears[eventYears.length - 1]?.year;

const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const venturePartnerCount = NUMBER_WORDS[VENTURE_PARTNERS.length] ?? String(VENTURE_PARTNERS.length);

// The evidence, with the source under each. Entries without a headline figure
// carry the finding itself — nothing is invented to fill the slot.
const marketCase = [
  {
    figure: '78p',
    label: 'revenue per £1 invested for female-founded startups, against 31p for male-founded',
    source: 'BCG, 2018',
  },
  {
    label: 'Female-founded startups reach exit faster.',
    source: 'PitchBook, 2023',
  },
  {
    figure: '15%',
    label: 'less capital burned per month',
    source: 'Inc, 2025',
  },
  {
    label: 'Female teams remain the most underrepresented in both decks submitted and investment received.',
    source: 'Founders Forum Group, 2025',
  },
];

const pillars = [
  {
    label: 'the fund',
    href: '/fund',
    line: 'first cheques into all-female, all-technical teams at pre-seed.',
  },
  {
    label: 'the accelerator',
    href: '/accelerator',
    line: "eight weeks, twice a year; the world's first all-female, all-technical accelerator",
  },
  {
    label: 'the community',
    href: '/community',
    // Event and city counts derive from the collection; the community figures
    // are not derivable from it and stay written out.
    line: `we've hosted 1,500+ technical women at ${eventStats.eventCount} live events across ${eventStats.cityCount} cities. our whatsapp community has 250+ curated members from 26 countries. apply to join `,
    cta: { text: 'here', href: '/community#apply' },
  },
];

const cohorts = [
  { label: 'cohort 1', rate: '8.7%' },
  { label: 'cohort 2', rate: '7.4%' },
];

const lead = {
  name: 'Milette Gillow',
  role: 'CEO',
  photo: '/about/milette.png',
  linkedin: 'https://www.linkedin.com/in/milettegillow/',
  bio: [
    'PhD mathematics, Leeds, started university aged 16.',
    'Investor and founder-in-residence at Entrepreneurs First; VC analyst in Berlin and Hong Kong; EWOR venture scout.',
    'Governing board, Oxford High School GDST.',
  ],
};

// Everyone else, name and role only. Community leads come from the shared
// config so /about and /community can't drift apart.
const team = [
  {
    name: 'Sara Patti',
    role: 'Partnerships',
    photo: '/community/leads/sara-patti.png',
    linkedin: 'https://www.linkedin.com/in/sara-patti/',
  },
  {
    name: 'Shameem Golestaneh',
    role: 'University partnerships',
    photo: '/community/leads/shameem-golestaneh.png',
    linkedin: 'https://www.linkedin.com/in/shameem-golestaneh-3378b3194/',
  },
  ...COMMUNITY_LEADS.map((person) => ({
    name: person.name,
    role: `${person.role}, ${person.city}`,
    photo: person.photo ? `/community/leads/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
];

const stats = [
  {
    figure: '70%',
    label: 'of participants met a potential co-founder at a bros event',
    source: 'post-event surveys, 2024-25',
  },
  {
    figure: '80%',
    label: 'report being more likely to found a startup after attending one of our events',
    source: 'post-event surveys, 2024-25',
  },
];
---

<BaseLayout
  title="About"
  description="Why The Tech Bros exists, what we've built, and who's behind it."
>
  <Navigation />
  <main class="about">
    <!-- 1. Why we exist -->
    <section class="why">
      <div class="container">
        <h1>why we exist</h1>
        <p class="lead">
          Only 2% of global venture capital goes to all-female teams, and in the US that has fallen
          to 1%.
        </p>
        <p>
          The Tech Bros exists to disrupt that, through a fund, an accelerator, and a global
          community of technical women.
        </p>
        <p>
          We back women in highly technical fields to launch their startup - from idea stage to
          pre-seed, and all the way through to exit or IPO.
        </p>
      </div>
    </section>

    <!-- 2. The market case -->
    <section class="market">
      <div class="container">
        <h2>the market case</h2>
        <p class="market-frame">
          female-led startups outperform. they remain the most chronically underfunded teams in the
          market.
        </p>
        <ul class="market-grid">
          {marketCase.map((item) => (
            <li class="market-item">
              {item.figure ? (
                <>
                  <span class="market-figure">{item.figure}</span>
                  <span class="market-label">{item.label}</span>
                </>
              ) : (
                <span class="market-statement">{item.label}</span>
              )}
              <span class="market-source">{item.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. The three things we do -->
    <section class="pillars">
      <div class="container">
        <h2>what we do</h2>
        <ul class="pillar-grid">
          {pillars.map((pillar) => (
            <li class="pillar">
              <a href={pillar.href} class="pillar-link">{pillar.label}</a>
              <p class="pillar-line">
                {pillar.line}
                {pillar.cta && <><a href={pillar.cta.href} class="pillar-cta">{pillar.cta.text}</a>.</>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Trajectory. Year counts come from the events collection. -->
    <section class="trajectory">
      <div class="container">
        <h2>where we are</h2>
        <ol class="year-list">
          {eventYears.map((year) => (
            <li class="year">
              <span class="year-label">{year.year}</span>
              <span class="year-bar" style={`--fill: ${(year.count / peakYear) * 100}%`}></span>
              <span class="year-count">
                {year.count} events
                {year.year === currentYear && <span class="year-note"> so far</span>}
              </span>
            </li>
          ))}
        </ol>

        <p class="trajectory-note">
          Two accelerator cohorts and 500+ applications, all reached organically.
        </p>

        <ul class="acceptance">
          {cohorts.map((cohort) => (
            <li class="acceptance-item">
              <span class="acceptance-rate">{cohort.rate}</span>
              <span class="acceptance-label">acceptance rate, {cohort.label}</span>
            </li>
          ))}
        </ul>

        <p class="trajectory-note">
          And a fund cornerstone-backed by the British Business Bank.
        </p>
      </div>
    </section>

    <!-- 5. Team. `id="team"` is the target of the /team redirect. -->
    <section class="team" id="team">
      <div class="section-banner holo">
        <div class="container"><h2>team</h2></div>
      </div>
      <div class="container">

        <div class="team-layout">
          <!-- Lead: larger photo, the only bio on the page. -->
          <div class="person person-lead">
            <div class="person-portrait person-portrait-lead">
              <img
                src={lead.photo}
                alt={lead.name}
                class="person-photo"
                loading="lazy"
                decoding="async"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
              <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
            </div>
            <div class="person-name-row">
              <p class="person-name">{lead.name}</p>
              {lead.linkedin && (
                <a
                  href={lead.linkedin}
                  class="event-link"
                  title={`View ${lead.name} on LinkedIn`}
                  aria-label={`View ${lead.name} on LinkedIn`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
            </div>
            <p class="person-meta">{lead.role}</p>
            <ul class="person-bio">
              {lead.bio.map((line) => <li>{line}</li>)}
            </ul>
          </div>

          <!-- Everyone else: two columns, smaller photos, no bios. -->
          <div class="team-others">
            {team.map((person) => (
              <div class="person">
                <div class="person-portrait">
                  {person.photo ? (
                    <>
                      <img
                        src={person.photo}
                        alt={person.name}
                        class="person-photo"
                        loading="lazy"
                        decoding="async"
                        onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                      />
                      <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
                    </>
                  ) : (
                    <span class="person-photo-placeholder" aria-hidden="true"></span>
                  )}
                </div>
                <div class="person-name-row">
                  <p class="person-name">{person.name}</p>
                  {person.linkedin && (
                    <a
                      href={person.linkedin}
                      class="event-link"
                      title={`View ${person.name} on LinkedIn`}
                      aria-label={`View ${person.name} on LinkedIn`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    </a>
                  )}
                </div>
                <p class="person-meta">{person.role}</p>
              </div>
            ))}
          </div>
        </div>

        <p class="team-aside">
          {venturePartnerCount} <a href="/accelerator#venture-partners">venture partners</a> work with
          every cohort.
        </p>

        <div class="leads-cta">
          <a href="/community" class="btn btn-primary">become a community lead for your city</a>
        </div>
      </div>
    </section>

    <!-- 6. Stats -->
    <section class="stats">
      <div class="container">
        <ul class="stat-grid">
          {stats.map((stat) => (
            <li class="stat-item">
              <span class="stat-figure">{stat.figure}</span>
              <span class="stat-label">{stat.label}</span>
              <span class="stat-source">{stat.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* The measure exists for running prose only — the `why we exist` block. Short
     blocks, stat labels and card copy size to their container instead, or they
     read as truncated rather than measured. */
  .about {
    --measure: 82ch;
  }

  .about section {
    padding: 5rem 0;
  }

  .about h2 {
    font-size: var(--text-h2);
    color: var(--color-text);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 2.5rem;
  }

  /* Full-bleed divider, same treatment as the section banners on /press.
     Direct child of the section, so it runs edge to edge. */
  .section-banner {
    margin-bottom: 3rem;
    padding: 0.5rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.05;
  }

  /* The banner carries the section's top edge. */
  .about section.team {
    padding-top: 3rem;
  }

  /* ── 1. Why we exist ── */
  .why {
    padding: 4.5rem 0 4rem;
  }

  .why h1 {
    margin-bottom: 2.5rem;
  }

  .why .lead {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  /* The lead is a two-line intro and sizes to its container; the measure is
     for the running paragraphs beneath it. */
  .why p:not(.lead) {
    max-width: var(--measure);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  /* ── 2. The market case ── */
  .market-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  .market-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .market-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .market-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .market-label {
    color: var(--color-text);
    line-height: 1.45;
  }

  /* Findings without a headline number carry their own weight instead. */
  .market-statement {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.3;
    color: var(--color-text);
  }

  .market-source {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ── 3. The three things we do ── */
  .pillars {
    padding-top: 0;
  }

  .pillar-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .pillar-link {
    display: inline-block;
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .pillar-link:hover,
  .pillar-link:focus-visible {
    color: var(--color-primary);
  }

  .pillar-line {
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 0;
  }

  .pillar-cta {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pillar-cta:hover {
    color: var(--color-primary-hover);
  }

  /* ── 4. Trajectory ── */
  .year-list {
    list-style: none;
  }

  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 12rem;
    align-items: center;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .year-label {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text-muted);
  }

  /* Proportional to the busiest year, so the growth is visible, not asserted. */
  .year-bar {
    display: block;
    height: 10px;
    background: var(--color-surface);
    position: relative;
  }

  .year-bar::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill);
    background: var(--color-primary);
  }

  .year-count {
    font-size: var(--text-lead);
    color: var(--color-text);
    white-space: nowrap;
  }

  .year-note {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .trajectory-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  .acceptance {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  .acceptance-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .acceptance-rate {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .acceptance-label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  /* ── 5. Team: one block, lead on the left, everyone else on the right ── */
  .team-layout {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }

  /* Two rows of three. */
  .team-others {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  /* Fixed-height box with the photo sat on its floor, so names and roles line
     up across the row whatever each portrait's proportions are. */
  .person-portrait {
    display: flex;
    align-items: flex-end;
    height: 170px;
    margin-bottom: 1rem;
  }

  .person-portrait-lead {
    height: 320px;
  }

  /* Two lines' worth of space whether the name needs it or not, so every role
     in a row sits on the same line. */
  .team-others .person-name {
    min-height: 2.4em;
  }

  .person-photo,
  .person-photo-placeholder {
    display: block;
    height: 170px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .person-portrait-lead .person-photo,
  .person-portrait-lead .person-photo-placeholder {
    height: 320px;
  }

  .person-photo-placeholder {
    width: 128px;
    background: var(--color-surface);
  }

  .person-portrait-lead .person-photo-placeholder {
    width: 240px;
  }

  /* Beats the placeholder's own `display: block` when the image loads. */
  .person-portrait [hidden] {
    display: none !important;
  }

  /* Icon sits next to the name, not pushed to the far edge of the column. */
  .person-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .person-name {
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .person-meta {
    color: var(--color-primary);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 0;
  }

  /* Same icon treatment as the event cards. */
  .event-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity var(--transition-btn), color var(--transition-btn);
  }

  .event-link:hover,
  .event-link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .event-link svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .person-bio {
    list-style: none;
    margin-top: 1rem;
  }

  .person-bio li {
    font-size: var(--text-small);
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 0.6rem;
    padding-left: 1rem;
    position: relative;
  }

  .person-bio li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .team-aside {
    margin: 3rem 0 0;
    color: var(--color-text-body);
  }

  .team-aside a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .team-aside a:hover {
    color: var(--color-primary-hover);
  }

  .leads-cta {
    margin-top: 2rem;
  }

  /* ── 6. Stats ── */
  .stats {
    border-top: 1px solid var(--color-border);
  }

  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .stat-label {
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.35;
  }

  .stat-source {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .market-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .team-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .about section {
      padding: 3.5rem 0;
    }

    .year {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 0.5rem 1rem;
    }

    .year-count {
      grid-column: 2;
    }

    .market-grid,
    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .team-others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
