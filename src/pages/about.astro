---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { COMMUNITY_LEADS } from '../config';

const built = [
  { figure: '38', label: 'events', detail: 'across 10 cities and 4 countries' },
  { figure: '1,500+', label: 'technical women hosted in person' },
  { figure: '2', label: 'accelerator cohorts' },
  { figure: '40', label: 'founders selected' },
];

const team = [
  {
    name: 'Milette Gillow',
    role: 'CEO',
    photo: '/about/milette.png',
    linkedin: 'https://www.linkedin.com/in/milettegillow/',
    bio: [
      'PhD mathematics, Leeds, started university aged 16.',
      'Investor and founder-in-residence at Entrepreneurs First; VC analyst in Berlin and Hong Kong; EWOR venture scout.',
      'Governing board, Oxford High School GDST.',
    ],
  },
  {
    name: 'Sara Patti',
    role: 'Partnerships',
    photo: undefined as string | undefined,
    linkedin: undefined as string | undefined,
    bio: [] as string[],
  },
];

const stats = [
  {
    figure: '70%',
    label: 'of participants met a potential co-founder',
    source: 'UC Berkeley, April 2026',
  },
  {
    figure: '80%',
    label: 'report being more likely to found a startup after attending one of our events',
    source: 'post-event surveys, 2024–25',
  },
];
---

<BaseLayout
  title="About"
  description="Why The Tech Bros exists, what we've built, and who's behind it."
>
  <Navigation />
  <main class="about">
    <!-- 1. Why we exist -->
    <section class="why">
      <div class="container">
        <h1>why we exist</h1>
        <p class="lead">
          Only 2% of global venture capital goes to all-female teams, and in the US that has fallen
          to 1%.
        </p>
        <p>
          Female-led startups outperform, yet remain the most chronically underfunded teams in the
          market. The Tech Bros exists to disrupt that, through a fund, an accelerator, and a global
          community of technical women.
        </p>
        <p>
          We back women in highly technical fields to launch their startup — from idea stage to
          pre-seed, and all the way through to exit or IPO.
        </p>
      </div>
    </section>

    <!-- 2. What we've built -->
    <section class="built">
      <div class="container">
        <h2>what we've built</h2>
        <ul class="built-grid">
          {built.map((item) => (
            <li class="built-item">
              <span class="built-figure">{item.figure}</span>
              <span class="built-label">{item.label}</span>
              {item.detail && <span class="built-detail">{item.detail}</span>}
            </li>
          ))}
        </ul>
        <p class="built-note">
          And a fund cornerstone-backed by the British Business Bank.
        </p>
      </div>
    </section>

    <!-- 3. Team. `id="team"` is the target of the /team redirect. -->
    <section class="team" id="team">
      <div class="container">
        <h2>team</h2>
        <div class="person-grid">
          {team.map((person) => (
            <div class="person-card">
              {person.photo ? (
                <img src={person.photo} alt={person.name} class="person-photo" loading="lazy" decoding="async" />
              ) : (
                <div class="person-photo person-photo-placeholder" aria-hidden="true"></div>
              )}
              <div class="person-name-row">
                <p class="person-name">{person.name}</p>
                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    class="event-link"
                    title={`View ${person.name} on LinkedIn`}
                    aria-label={`View ${person.name} on LinkedIn`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
              <p class="person-meta">{person.role}</p>
              {person.bio.length > 0 && (
                <ul class="person-bio">
                  {person.bio.map((line) => <li>{line}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>

        <h3 class="leads-heading">community leads</h3>
        <div class="person-grid">
          {COMMUNITY_LEADS.map((lead) => (
            <div class="person-card">
              {lead.photo ? (
                <img
                  src={`/community/leads/${lead.photo}`}
                  alt={`${lead.name}, ${lead.role.toLowerCase()} in ${lead.city}`}
                  class="person-photo"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="person-photo person-photo-placeholder" aria-hidden="true"></div>
              )}
              <div class="person-name-row">
                <p class="person-name">{lead.name}</p>
                {lead.linkedin && (
                  <a
                    href={lead.linkedin}
                    class="event-link"
                    title={`View ${lead.name} on LinkedIn`}
                    aria-label={`View ${lead.name} on LinkedIn`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
              <p class="person-meta">{lead.role}, {lead.city}</p>
            </div>
          ))}
        </div>

        <p class="leads-cta">
          <a href="/community">become a community lead for your city</a>
        </p>
      </div>
    </section>

    <!-- 4. Stats -->
    <section class="stats">
      <div class="container">
        <ul class="stat-grid">
          {stats.map((stat) => (
            <li class="stat-item">
              <span class="stat-figure">{stat.figure}</span>
              <span class="stat-label">{stat.label}</span>
              <span class="stat-source">{stat.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about section {
    padding: 5rem 0;
  }

  .about h2 {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 2.5rem;
  }

  /* ── 1. Why we exist ── */
  .why {
    padding: 4.5rem 0 4rem;
  }

  .why h1 {
    max-width: 14ch;
    margin-bottom: 2.5rem;
  }

  .why .lead {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.3;
    color: var(--color-text);
    max-width: 34ch;
    margin-bottom: 2rem;
  }

  .why p {
    max-width: 62ch;
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  /* ── 2. What we've built ── */
  .built-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .built-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .built-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .built-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  .built-detail {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .built-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 50ch;
  }

  /* ── 3. Team — same treatment as the community leads on /community ── */
  .person-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem 2rem;
  }

  .person-card {
    max-width: 320px;
  }

  .person-photo {
    display: block;
    height: 320px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .person-photo-placeholder {
    width: 240px;
    background: var(--color-surface);
  }

  .person-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .person-name {
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .person-meta {
    color: var(--color-primary);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 0;
  }

  .event-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity var(--transition-btn), color var(--transition-btn);
  }

  .event-link:hover,
  .event-link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .event-link svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .person-bio {
    list-style: none;
    margin-top: 1rem;
  }

  .person-bio li {
    font-size: var(--text-small);
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 0.6rem;
    padding-left: 1rem;
    position: relative;
  }

  .person-bio li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .leads-heading {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-subheading);
    margin: 4rem 0 2.5rem;
  }

  .leads-cta {
    margin: 2.5rem 0 0;
  }

  .leads-cta a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .leads-cta a:hover {
    color: var(--color-primary-hover);
  }

  /* ── 4. Stats ── */
  .stats {
    border-top: 1px solid var(--color-border);
  }

  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .stat-label {
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.35;
    max-width: 32ch;
  }

  .stat-source {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .built-grid,
    .person-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .about section {
      padding: 3.5rem 0;
    }

    .built-grid,
    .person-grid,
    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
