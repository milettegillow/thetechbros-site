---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COMMUNITY_LEADS } from '../config';
import { VENTURE_PARTNERS } from '../data/venture-partners';
import { getEventStats, getEventsByYear } from '../lib/eventStats';

const events = await getCollection('events');
const eventStats = getEventStats(events);
const eventYears = getEventsByYear(events);
// The bars are proportional, so the tallest year sets the scale.
const peakYear = Math.max(...eventYears.map((y) => y.count));
// Only the most recent year is part-run; the rest are complete.
const currentYear = eventYears[eventYears.length - 1]?.year;

// Single bold statements, each pointing at the page that backs it up. The
// event count derives from the collection; the 1,500+ figure is not derivable
// from it and stays written out.
const headlines = [
  { text: 'women-founded businesses are a better bet.', href: '/fund' },
  {
    text: `we've hosted 1,500+ technical women across ${eventStats.eventCount} events.`,
    href: '/community',
  },
  { text: "the world's first all-female, all-technical accelerator.", href: '/accelerator' },
];

const pillars = [
  {
    label: 'the fund',
    href: '/fund',
    line: 'first cheques into all-female, all-technical teams at pre-seed. cornerstone-backed by the British Business Bank.',
  },
  {
    label: 'the accelerator',
    href: '/accelerator',
    line: "eight weeks, twice a year. two in person in Norway, six hybrid. the world's first all-female, all-technical accelerator.",
  },
  {
    label: 'the community',
    href: '/community',
    // Event, city and country counts derive from the collection; the 1,500+
    // figure is not derivable from it and stays written out.
    line: `${eventStats.eventCount} events across ${eventStats.cityCount} cities and ${eventStats.countryCount} countries. 1,500+ technical women hosted in person.`,
  },
];

const cohorts = [
  { label: 'cohort 1', rate: '8.7%' },
  { label: 'cohort 2', rate: '7.4%' },
];

const lead = {
  name: 'Milette Gillow',
  role: 'CEO',
  photo: '/about/milette.png',
  linkedin: 'https://www.linkedin.com/in/milettegillow/',
  bio: [
    'PhD mathematics, Leeds, started university aged 16.',
    'Investor and founder-in-residence at Entrepreneurs First; VC analyst in Berlin and Hong Kong; EWOR venture scout.',
    'Governing board, Oxford High School GDST.',
  ],
};

// One flat grid: the rest of the core team, then the venture partners. Name
// and LinkedIn only — no roles in here, so everyone reads at the same weight.
// Community leads come from the shared config, and the venture partners from
// the same list /accelerator renders, so nothing is retyped.
const core = [
  {
    name: 'Sara Patti',
    photo: '/community/leads/sara-patti.png',
    linkedin: 'https://www.linkedin.com/in/sara-patti/',
  },
  {
    name: 'Shameem Golestaneh',
    photo: '/community/leads/shameem-golestaneh.png',
    linkedin: 'https://www.linkedin.com/in/shameem-golestaneh-3378b3194/',
  },
  ...COMMUNITY_LEADS.map((person) => ({
    name: person.name,
    photo: person.photo ? `/community/leads/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
];

const team = [
  ...core,
  ...VENTURE_PARTNERS.map((person) => ({
    name: person.name,
    photo: person.photo ? `/accelerator/venture-partners/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
];

/**
 * Institutions the team and partners come from. Filenames resolve against
 * /about/institutions/. Empty until the logos are supplied — the strip renders
 * a short note instead of an empty scroller.
 */
const INSTITUTIONS: { file: string; name: string }[] = [];

// Rendered twice so the marquee can loop seamlessly, as on the home page.
const institutionMarquee = [...INSTITUTIONS, ...INSTITUTIONS];

const stats = [
  {
    figure: '70%',
    label: 'of participants met a potential co-founder at a bros event',
    source: 'post-event surveys, 2024-25',
  },
  {
    figure: '80%',
    label: 'report being more likely to found a startup after attending one of our events',
    source: 'post-event surveys, 2024-25',
  },
];
---

<BaseLayout
  title="About"
  description="Why The Tech Bros exists, what we've built, and who's behind it."
>
  <Navigation />
  <main class="about">
    <!-- 3. The three things we do -->
    <section class="pillars">
      <div class="container">
        <h1>what we do</h1>
        <p class="opening">
          we back technical women to build and own the most valuable technology companies in the
          world. we do it through a fund, an accelerator, and a global community.
        </p>
        <ul class="pillar-grid">
          {pillars.map((pillar) => (
            <li class="pillar">
              <a href={pillar.href} class="holo pillar-card">
                <span class="pillar-label">{pillar.label}</span>
                <span class="pillar-line">{pillar.line}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Headline claims, each linking to the page that carries the detail -->
    <section class="headlines">
      <div class="container">
        <ul class="headline-list">
          {headlines.map((item) => (
            <li class="headline">
              <a href={item.href}>{item.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Trajectory. Year counts come from the events collection. -->
    <section class="trajectory">
      <div class="container">
        <h2>where we are</h2>
        <ol class="year-list">
          {eventYears.map((year) => (
            <li class="year">
              <span class="year-label">{year.year}</span>
              <span class="year-bar" style={`--fill: ${(year.count / peakYear) * 100}%`}></span>
              <span class="year-count">
                {year.count} events
                {year.year === currentYear && <span class="year-note"> so far</span>}
              </span>
            </li>
          ))}
        </ol>

        <p class="trajectory-note">
          Two accelerator cohorts and 500+ applications, all reached organically.
        </p>

        <ul class="acceptance">
          {cohorts.map((cohort) => (
            <li class="acceptance-item">
              <span class="acceptance-rate">{cohort.rate}</span>
              <span class="acceptance-label">acceptance rate, {cohort.label}</span>
            </li>
          ))}
        </ul>

        <p class="trajectory-note">
          And a fund cornerstone-backed by the British Business Bank.
        </p>
      </div>
    </section>

    <!-- 5. Team. `id="team"` is the target of the /team redirect. -->
    <section class="team" id="team">
      <div class="section-banner holo">
        <div class="container"><h2>team</h2></div>
      </div>

      <div class="container">
        <!-- Lead sits on her own, and carries the only bio on the page. -->
        <div class="person team-lead">
          <div class="person-portrait person-portrait-lead">
            <img
              src={lead.photo}
              alt={lead.name}
              class="person-photo"
              loading="lazy"
              decoding="async"
              onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
            />
            <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
          </div>
          <div class="person-name-row">
            <p class="person-name">{lead.name}</p>
            {lead.linkedin && (
              <a
                href={lead.linkedin}
                class="event-link"
                title={`View ${lead.name} on LinkedIn`}
                aria-label={`View ${lead.name} on LinkedIn`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
          </div>
          <p class="person-meta">{lead.role}</p>
          <ul class="person-bio">
            {lead.bio.map((line) => <li>{line}</li>)}
          </ul>
        </div>

        <!-- Everyone else at one size: name and LinkedIn icon, nothing else. -->
        <div class="team-grid">
          {team.map((person) => (
            <div class="person">
              <div class="person-portrait">
                {person.photo ? (
                  <>
                    <img
                      src={person.photo}
                      alt={person.name}
                      class="person-photo"
                      loading="lazy"
                      decoding="async"
                      onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                    />
                    <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
                  </>
                ) : (
                  <span class="person-photo-placeholder" aria-hidden="true"></span>
                )}
              </div>
              <div class="person-name-row">
                <p class="person-name">{person.name}</p>
                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    class="event-link"
                    title={`View ${person.name} on LinkedIn`}
                    aria-label={`View ${person.name} on LinkedIn`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="leads-cta">
          <a href="/community" class="btn btn-primary">become a community lead for your city</a>
        </div>
      </div>

      <!-- Institutions. Same marquee treatment as the sponsor wall on the home
           page; empty until the logos are supplied. -->
      <div class="institutions">
        <div class="container">
          <p class="institutions-heading">our team and partners come from</p>
        </div>
        {institutionMarquee.length > 0 ? (
          <div class="institution-carousel">
            <div class="institution-track">
              {institutionMarquee.map((logo) => (
                <div class="institution-item">
                  <img src={`/about/institutions/${logo.file}`} alt={logo.name} loading="lazy" decoding="async" />
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="container">
            <p class="institutions-empty">Logos to come.</p>
          </div>
        )}
      </div>
    </section>

    <!-- 6. Stats -->
    <section class="stats">
      <div class="container">
        <ul class="stat-grid">
          {stats.map((stat) => (
            <li class="stat-item">
              <span class="stat-figure">{stat.figure}</span>
              <span class="stat-label">{stat.label}</span>
              <span class="stat-source">{stat.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about section {
    padding: 5rem 0;
  }

  /* `what we do` is the page's h1 now that the opening section has gone; it
     keeps the section-heading treatment so nothing shifts visually. */
  .about h1,
  .about h2 {
    font-size: var(--text-h2);
    color: var(--color-text);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 2.5rem;
  }

  /* Full-bleed divider, same treatment as the section banners on /press.
     Direct child of the section, so it runs edge to edge. */
  .section-banner {
    margin-bottom: 3rem;
    padding: 0.5rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.05;
  }

  /* The banner carries the section's top edge. */
  .about section.team {
    padding-top: 3rem;
  }

  /* ── 1. The three things we do — the page now opens here ── */
  .pillars {
    padding-top: 4.5rem;
  }

  /* ── 2. Headline claims ── */
  .headline-list {
    list-style: none;
  }

  /* Rules sit between the statements, not around the block. */
  .headline + .headline {
    border-top: 1px solid var(--color-border);
  }

  .headline a {
    display: block;
    padding: 1.75rem 0;
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.25;
    color: var(--color-text);
    text-decoration: none;
  }

  .headline a:hover,
  .headline a:focus-visible {
    color: var(--color-primary);
  }

  /* Larger than body copy, smaller than a heading, and full width rather than
     held to a measure. */
  .opening {
    font-size: var(--text-h4);
    line-height: 1.45;
    color: var(--color-text);
    margin-bottom: 3rem;
  }

  .pillar-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* The whole card is the link. The holographic surface carries it, and the
     global `.holo` rule forces black text on top. */
  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 20rem;
    padding: 2.5rem;
    text-decoration: none;
    border: 0;
    border-radius: 0;
  }

  .pillar-label {
    font-size: var(--text-h3);
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.1;
  }

  .pillar-line {
    font-size: var(--text-lead);
    font-weight: var(--weight-holo);
    line-height: 1.4;
  }

  /* ── 4. Trajectory ── */
  .year-list {
    list-style: none;
  }

  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 12rem;
    align-items: center;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .year-label {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text-muted);
  }

  /* Proportional to the busiest year, so the growth is visible, not asserted. */
  .year-bar {
    display: block;
    height: 10px;
    background: var(--color-surface);
    position: relative;
  }

  .year-bar::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill);
    background: var(--color-primary);
  }

  .year-count {
    font-size: var(--text-lead);
    color: var(--color-text);
    white-space: nowrap;
  }

  .year-note {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .trajectory-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  .acceptance {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  .acceptance-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .acceptance-rate {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .acceptance-label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  /* ── 5. Team: the lead on her own, then everyone else at one size ── */
  .team-lead {
    max-width: 22rem;
    margin-bottom: 4rem;
  }

  /* Five across, dropping a column at a time as the page narrows. */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  /* Fixed-height box with the photo sat on its floor, so names line up across
     a row whatever each portrait's proportions are. Nothing is cropped: the
     photo is contained, and scales down if it's wider than its column. */
  .person-portrait {
    display: flex;
    align-items: flex-end;
    height: 170px;
    margin-bottom: 1rem;
  }

  .person-portrait-lead {
    height: 320px;
  }

  /* Two lines' worth of space whether the name needs it or not, so the rows
     stay level when a name wraps. */
  .team-grid .person-name {
    min-height: 2.4em;
  }

  .person-photo,
  .person-photo-placeholder {
    display: block;
    height: 170px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .person-portrait-lead .person-photo,
  .person-portrait-lead .person-photo-placeholder {
    height: 320px;
  }

  .person-photo-placeholder {
    width: 128px;
    background: var(--color-surface);
  }

  .person-portrait-lead .person-photo-placeholder {
    width: 240px;
  }

  /* Beats the placeholder's own `display: block` when the image loads. */
  .person-portrait [hidden] {
    display: none !important;
  }

  /* Icon sits next to the name, not pushed to the far edge of the column. */
  .person-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .person-name {
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .person-meta {
    color: var(--color-primary);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 0;
  }

  /* Same icon treatment as the event cards. */
  .event-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity var(--transition-btn), color var(--transition-btn);
  }

  .event-link:hover,
  .event-link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .event-link svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .person-bio {
    list-style: none;
    margin-top: 1rem;
  }

  .person-bio li {
    font-size: var(--text-small);
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 0.6rem;
    padding-left: 1rem;
    position: relative;
  }

  .person-bio li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .leads-cta {
    margin-top: 3rem;
  }

  /* ── Institutions: same marquee as the sponsor wall on the home page ── */
  .institutions {
    margin-top: 4.5rem;
  }

  .institutions-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .institutions-empty {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .institution-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Fades at both ends so marks dissolve rather than being sliced. */
    mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
  }

  .institution-track {
    display: flex;
    gap: 4rem;
    animation: institution-scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes institution-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .institution-track {
      animation: none;
    }
  }

  .institution-item {
    flex-shrink: 0;
    width: 220px;
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
  }

  .institution-item img {
    display: block;
    width: auto;
    height: auto;
    max-height: 72px;
    max-width: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* ── 6. Stats ── */
  .stats {
    border-top: 1px solid var(--color-border);
  }

  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

  .stat-label {
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.35;
  }

  .stat-source {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 1200px) {
    .team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 1024px) {


    .pillar-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .about section {
      padding: 3.5rem 0;
    }

    .year {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 0.5rem 1rem;
    }

    .year-count {
      grid-column: 2;
    }

        .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
