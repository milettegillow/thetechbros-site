    <!-- Work With Us -->
    <section class="work-with-us" id="work-with-us">
      <div class="container">
        <h2>work with us</h2>
        <p class="section-intro">We're always looking for exceptional people who share our mission. Open positions will appear below.</p>
        <div class="open-roles">
          <WorkWithUsRoles />
