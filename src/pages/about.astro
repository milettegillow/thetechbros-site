---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COMMUNITY_LEADS } from '../config';
import { VENTURE_PARTNERS } from '../data/venture-partners';
import { getEventStats, getEventsByYear } from '../lib/eventStats';

const events = await getCollection('events');
const eventStats = getEventStats(events);
const eventYears = getEventsByYear(events);
// The bars are proportional, so the tallest year sets the scale.
const peakYear = Math.max(...eventYears.map((y) => y.count));
// Only the most recent year is part-run; the rest are complete.
const currentYear = eventYears[eventYears.length - 1]?.year;

// The research behind the thesis. The detail lives on /fund; this is the case
// in brief.
const whyPoints = [
  'When presented with identical pitches, both male and female investors rate those pitched by men more favourably.',
  'Both male and female investors rate identical pitches more highly when told a male investor had already invested.',
  'Male founders are more often asked "promotion" questions about what might go right, while female founders are asked "prevention" questions about what might go wrong. In comparable companies, entrepreneurs asked primarily prevention questions raise an average of seven times less.',
];

const pillars = [
  {
    label: 'the fund',
    href: '/fund',
    line: 'first cheques into all-female, all-technical teams at pre-seed. cornerstone-backed by the British Business Bank.',
  },
  {
    label: 'the accelerator',
    href: '/accelerator',
    line: "eight weeks, twice a year. two in person in Norway, six hybrid. the world's first all-female, all-technical accelerator.",
  },
  {
    label: 'the community',
    href: '/community',
    // Event, city and country counts derive from the collection; the 1,500+
    // figure is not derivable from it and stays written out.
    line: `${eventStats.eventCount} events across ${eventStats.cityCount} cities and ${eventStats.countryCount} countries. 1,500+ technical women hosted in person.`,
  },
];

const cohorts = [
  { label: 'cohort 1', rate: '8.7%' },
  { label: 'cohort 2', rate: '7.4%' },
];

const lead = {
  name: 'Milette Gillow',
  role: 'CEO',
  photo: '/about/milette.png',
  linkedin: 'https://www.linkedin.com/in/milettegillow/',
  bio: [
    'PhD mathematics, Leeds, started university aged 16.',
    'Investor and founder-in-residence at Entrepreneurs First; VC analyst in Berlin and Hong Kong; EWOR venture scout.',
    'Governing board, Oxford High School GDST.',
  ],
};

// One flat grid: the rest of the core team, then the venture partners. Name
// and LinkedIn only — no roles in here, so everyone reads at the same weight.
// Community leads come from the shared config, and the venture partners from
// the same list /accelerator renders, so nothing is retyped.
const core = [
  {
    name: 'Sara Patti',
    photo: '/community/leads/sara-patti.png',
    linkedin: 'https://www.linkedin.com/in/sara-patti/',
  },
  {
    name: 'Shameem Golestaneh',
    photo: '/community/leads/shameem-golestaneh.png',
    linkedin: 'https://www.linkedin.com/in/shameem-golestaneh-3378b3194/',
  },
  ...COMMUNITY_LEADS.map((person) => ({
    name: person.name,
    photo: person.photo ? `/community/leads/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
];

const team = [
  ...core,
  ...VENTURE_PARTNERS.map((person) => ({
    name: person.name,
    photo: person.photo ? `/accelerator/venture-partners/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
];

/**
 * Institutions the team and partners come from. `height` is tuned per mark, and
 * `tone` overrides the default white-out for artwork that is a coloured plate
 * with the shape knocked out of it — flattening those to white fills the plate.
 */
const INSTITUTIONS = [
  { file: 'google.png', name: 'Google', height: 24 },
  { file: 'apple.png', name: 'Apple', height: 40 },
  { file: 'microsoft.png', name: 'Microsoft', height: 22 },
  { file: 'aws.png', name: 'AWS', height: 30 },
  { file: 'tesla.png', name: 'Tesla', height: 40 },
  { file: 'meta.png', name: 'Meta', height: 22 },
  { file: 'discord.png', name: 'Discord', height: 36, tone: 'threshold' },
  { file: 'nasa.png', name: 'NASA', height: 26 },
  { file: 'y-combinator.png', name: 'Y Combinator', height: 26, tone: 'plate' },
  { file: 'stanford.png', name: 'Stanford', height: 26 },
  { file: 'mit.png', name: 'MIT', height: 30 },
  { file: 'oxford.png', name: 'Oxford', height: 24, tone: 'threshold' },
  { file: 'cambridge.png', name: 'Cambridge', height: 22 },
  { file: 'berkeley.png', name: 'UC Berkeley', height: 20 },
  { file: 'caltech.png', name: 'Caltech', height: 28 },
  { file: 'ethzurich.png', name: 'ETH Zurich', height: 22 },
  { file: 'epfl.svg', name: 'EPFL', height: 24 },
];

// Rendered twice so the marquee can loop seamlessly, as on the home page.
const institutionMarquee = [...INSTITUTIONS, ...INSTITUTIONS];

const stats = [
  {
    figure: '70%',
    label: 'of participants met a potential co-founder at a bros event',
    source: 'post-event surveys, 2024-25',
  },
  {
    figure: '80%',
    label: 'report being more likely to found a startup after attending one of our events',
    source: 'post-event surveys, 2024-25',
  },
];
---

<BaseLayout
  title="About"
  description="Why The Tech Bros exists, what we've built, and who's behind it."
>
  <Navigation />
  <main class="about">
    <!-- 3. The three things we do -->
    <section class="pillars">
      <div class="container">
        <h1>what we do</h1>
        <p class="opening">
          we back the most ambitious technical women to build technology companies from scratch,
          through our 3 pillars: our fund, accelerator, and global community.
        </p>
        <ul class="pillar-grid">
          {pillars.map((pillar) => (
            <li class="pillar">
              <a href={pillar.href} class="holo pillar-card">
                <span class="pillar-label">{pillar.label}</span>
                <span class="pillar-line">{pillar.line}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Why we do it -->
    <section class="why-we-do-it">
      <div class="container">
        <h2>why we do it</h2>
        <a href="/fund" class="why-claim">women-owned businesses are a better bet.</a>
        <p class="why-body">
          Female-founded startups consistently outperform startups with all-male teams, yet receive
          a fraction of the venture funding.
        </p>
        <ul class="why-points">
          {whyPoints.map((point) => <li>{point}</li>)}
        </ul>
        <p class="why-close">
          We believe in creating an entirely new pipeline for backing exceptional female founders,
          from idea stage to pre-seed and all the way through to exit or IPO.
        </p>
      </div>
    </section>

    <!-- 4. Trajectory. Year counts come from the events collection. -->
    <section class="trajectory">
      <div class="container">
        <h2>where we are</h2>
        <ol class="year-list">
          {eventYears.map((year) => (
            <li class="year">
              <span class="year-label">{year.year}</span>
              <span class="year-bar" style={`--fill: ${(year.count / peakYear) * 100}%`}></span>
              <span class="year-count">
                {year.count} events
                {year.year === currentYear && <span class="year-note"> so far</span>}
              </span>
            </li>
          ))}
        </ol>

        <p class="trajectory-note">
          Two accelerator cohorts and 500+ applications, all reached organically, and a fund
          cornerstone-backed by the British Business Bank.
        </p>

        <ul class="acceptance">
          {cohorts.map((cohort) => (
            <li class="acceptance-item">
              <span class="acceptance-rate">{cohort.rate}</span>
              <span class="acceptance-label">acceptance rate, {cohort.label}</span>
            </li>
          ))}
        </ul>

      </div>
    </section>

    <!-- 5. Team. `id="team"` is the target of the /team redirect. -->
    <section class="team" id="team">
      <div class="section-banner holo">
        <div class="container"><h2>team</h2></div>
      </div>

      <div class="container">
        <!-- Lead sits on her own, and carries the only bio on the page. -->
        <div class="person team-lead">
          <div class="person-portrait person-portrait-lead">
            <img
              src={lead.photo}
              alt={lead.name}
              class="person-photo"
              loading="lazy"
              decoding="async"
              onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
            />
            <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
          </div>
          <div class="person-name-row">
            <p class="person-name">{lead.name}</p>
            {lead.linkedin && (
              <a
                href={lead.linkedin}
                class="event-link"
                title={`View ${lead.name} on LinkedIn`}
                aria-label={`View ${lead.name} on LinkedIn`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
          </div>
          <p class="person-meta">{lead.role}</p>
          <ul class="person-bio">
            {lead.bio.map((line) => <li>{line}</li>)}
          </ul>
        </div>

        <!-- Everyone else: circular portrait, name, whole tile links out. -->
        <ul class="team-grid">
          {team.map((person) => {
            const Tile = person.linkedin ? 'a' : 'div';
            return (
              <li>
                <Tile
                  class="person"
                  href={person.linkedin}
                  target={person.linkedin ? '_blank' : undefined}
                  rel={person.linkedin ? 'noopener noreferrer' : undefined}
                  aria-label={person.linkedin ? `${person.name} on LinkedIn` : undefined}
                >
                  {person.photo ? (
                    <>
                      <img
                        src={person.photo}
                        alt={person.name}
                        class="person-photo"
                        loading="lazy"
                        decoding="async"
                        onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                      />
                      <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
                    </>
                  ) : (
                    <span class="person-photo-placeholder" aria-hidden="true"></span>
                  )}
                  <span class="person-name">{person.name}</span>
                </Tile>
              </li>
            );
          })}
        </ul>

        <div class="leads-cta">
          <a href="/community" class="btn btn-primary">become a community lead for your city</a>
        </div>
      </div>

      <!-- Institutions. Same marquee treatment as the sponsor wall on the home
           page; empty until the logos are supplied. -->
      <div class="institutions">
        <div class="container">
          <p class="institutions-heading">our team and partners come from</p>
        </div>
        <div class="institution-carousel">
          <div class="institution-track">
            {institutionMarquee.map((logo) => (
              <div class="institution-item">
                <img
                  src={`/index/cohort-logos/${logo.file}`}
                  alt={logo.name}
                  data-tone={logo.tone}
                  style={`height: ${logo.height}px`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Stats -->
    <section class="stats">
      <div class="container">
        <ul class="stat-grid">
          {stats.map((stat) => (
            <li class="stat-item">
              <span class="stat-figure">{stat.figure}</span>
              <span class="stat-label">{stat.label}</span>
              <span class="stat-source">{stat.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about section {
    padding: 5rem 0;
  }

  /* `what we do` is the page's h1 now that the opening section has gone; it
     keeps the section-heading treatment so nothing shifts visually. */
  .about h1,
  .about h2 {
    font-size: var(--text-h2);
    color: var(--color-text);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 2.5rem;
  }

  /* Full-bleed divider, same treatment as the section banners on /press.
     Direct child of the section, so it runs edge to edge. */
  /* Same rhythm as the banners on /press: the band gives its heading room, the
     gap under it gives the section room, and the gap above stays larger. */
  .section-banner {
    margin-bottom: 2.5rem;
    padding: 1.25rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.05;
  }

  /* The banner carries the section's top edge. */
  .about section.team {
    padding-top: 3.5rem;
  }

  .team .section-banner {
    margin-bottom: 2rem;
  }

  /* ── 1. The three things we do — the page now opens here ── */
  .pillars {
    padding-top: 4.5rem;
  }

  /* ── 2. Why we do it ── */
  .why-claim {
    display: block;
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.25;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .why-claim:hover,
  .why-claim:focus-visible {
    color: var(--color-primary);
  }

  .why-body,
  .why-close {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
  }

  .why-points {
    list-style: none;
    margin: 0 0 2rem;
  }

  .why-points li {
    color: var(--color-text-body);
    line-height: 1.6;
    padding: 0 0 0 1.5rem;
    margin-bottom: 1rem;
    position: relative;
  }

  .why-points li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .why-close {
    margin-bottom: 0;
  }

  /* Larger than body copy, smaller than a heading, and full width rather than
     held to a measure. */
  .opening {
    font-size: var(--text-h4);
    line-height: 1.45;
    color: var(--color-text);
    margin-bottom: 3rem;
  }

  .pillar-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* The whole card is the link. The holographic surface carries it, and the
     global `.holo` rule forces black text on top. */
  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 20rem;
    padding: 2.5rem;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 0;
    transition: background-color var(--transition-btn), color var(--transition-btn);
  }

  /* Same inversion as the primary button: solid black, white text, and the
     foil reduced to a 1px border. */
  .pillar-card:hover,
  .pillar-card:focus-visible {
    background-color: var(--color-black);
    background-image: none;
    border-color: transparent;
    border-image-source: var(--holo-border-image);
    border-image-slice: 1;
  }

  .pillar-card:hover,
  .pillar-card:hover *,
  .pillar-card:focus-visible,
  .pillar-card:focus-visible * {
    color: var(--color-white) !important;
  }

  .pillar-label {
    font-size: var(--text-h3);
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.1;
  }

  .pillar-line {
    font-size: var(--text-lead);
    font-weight: var(--weight-holo);
    line-height: 1.4;
  }

  /* ── 4. Trajectory ── */
  .year-list {
    list-style: none;
  }

  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 12rem;
    align-items: center;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .year-label {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text-muted);
  }

  /* Proportional to the busiest year, so the growth is visible, not asserted. */
  .year-bar {
    display: block;
    height: 10px;
    background: var(--color-surface);
    position: relative;
  }

  .year-bar::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill);
    background: var(--color-primary);
  }

  .year-count {
    font-size: var(--text-lead);
    color: var(--color-text);
    white-space: nowrap;
  }

  .year-note {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .trajectory-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  .acceptance {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  .acceptance-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .acceptance-rate {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .acceptance-label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  /* ── 5. Team: the lead on her own, then everyone else in a tight grid ── */
  .team-lead {
    max-width: 22rem;
    margin-bottom: 2.5rem;
  }

  .person-portrait-lead {
    display: block;
    margin-bottom: 1rem;
  }

  .person-portrait-lead .person-photo,
  .person-portrait-lead .person-photo-placeholder {
    display: block;
    height: 320px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .person-portrait-lead .person-photo-placeholder {
    width: 240px;
    background: var(--color-surface);
  }

  .person-portrait-lead [hidden] {
    display: none !important;
  }

  .person-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Six across, dropping columns as the page narrows. Modest gaps: the tiles
     are small, so the section shouldn't sprawl. */
  .team-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }

  /* The whole tile is the link. Fixed rows: the portrait is a constant size and
     the name reserves two lines, so every tile is the same height whatever the
     name does. */
  .team-grid .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  /* Circular and cropped on purpose — the source photos are framed every which
     way, and a common mask is what makes the grid read as one set. This is the
     one place a radius is used; everything else on the site stays square. */
  .team-grid .person-photo,
  .team-grid .person-photo-placeholder {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    transition: opacity var(--transition-btn), filter var(--transition-btn);
  }

  .team-grid .person-photo,
  .team-grid .person-photo-placeholder {
    background: var(--color-surface);
  }

  .team-grid [hidden] {
    display: none !important;
  }

  .team-grid a.person:hover .person-photo,
  .team-grid a.person:focus-visible .person-photo {
    opacity: 0.6;
  }

  .team-grid a.person:hover .person-name,
  .team-grid a.person:focus-visible .person-name {
    color: var(--color-primary);
  }

  .team-grid .person-name {
    display: block;
    text-align: center;
    font-size: var(--text-small);
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--color-text);
    /* Two lines' worth whether the name needs it or not, so rows stay level. */
    min-height: 2.6em;
    transition: color var(--transition-btn);
  }

  /* The lead's name sits a step down from a section heading, not level with it. */
  .team-lead .person-name {
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .person-meta {
    color: var(--color-primary);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 0;
  }

  /* Same icon treatment as the event cards. */
  .event-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity var(--transition-btn), color var(--transition-btn);
  }

  .event-link:hover,
  .event-link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .event-link svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .person-bio {
    list-style: none;
    margin-top: 1rem;
  }

  .person-bio li {
    font-size: var(--text-small);
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 0.6rem;
    padding-left: 1rem;
    position: relative;
  }

  .person-bio li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .leads-cta {
    margin-top: 3rem;
    text-align: center;
  }

  /* ── Institutions: same marquee as the sponsor wall on the home page ── */
  .institutions {
    margin-top: 4.5rem;
  }

  .institutions-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .institution-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Fades at both ends so marks dissolve rather than being sliced. */
    mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
  }

  .institution-track {
    display: flex;
    gap: 4rem;
    animation: institution-scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes institution-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
