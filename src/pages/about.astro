---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COMMUNITY_LEADS, TEAM_LOGOS, teamLogo } from '../config';
import { VENTURE_PARTNERS } from '../data/venture-partners';
import { byLastName } from '../data/people';
import PeopleGrid from '../components/PeopleGrid.astro';
import { getEventStats, getEventsByYear } from '../lib/eventStats';

const events = await getCollection('events');
const eventStats = getEventStats(events);
const eventYears = getEventsByYear(events);
// The bars are proportional, so the tallest year sets the scale.
const peakYear = Math.max(...eventYears.map((y) => y.count));
// Only the most recent year is part-run; the rest are complete.
const currentYear = eventYears[eventYears.length - 1]?.year;

// The research behind the thesis, each point with the study it comes from.
const whyPoints = [
  {
    text: 'When presented with identical pitches, both male and female investors rate those pitched by men more favourably.',
    source: 'Brooks et al., PNAS, 2014',
    url: 'https://www.pnas.org/doi/10.1073/pnas.1321202111',
  },
  {
    text: 'Female-founded firms whose first-round backing came from female rather than male investors are twice as likely to fail to raise a further round. There is no equivalent effect for male-founded firms.',
    source: 'Snellman & Solal, Organization Science',
    url: 'https://pubsonline.informs.org/doi/10.1287/orsc.2022.1594',
  },
  {
    text: 'Male founders are more often asked "promotion" questions about what might go right, while female founders are asked "prevention" questions about what might go wrong. In comparable companies, entrepreneurs asked primarily prevention questions raise an average of seven times less.',
    source: 'Kanze et al., Harvard Business Review, 2017',
    url: 'https://hbr.org/2017/06/male-and-female-entrepreneurs-get-asked-different-questions-by-vcs-and-it-affects-how-much-funding-they-get',
  },
];

const pillars = [
  {
    label: 'the fund',
    href: '/fund',
    line: 'first cheques into all-female, all-technical teams at pre-seed; cornerstone-backed by the British Business Bank.',
  },
  {
    label: 'the accelerator',
    href: '/accelerator',
    line: "eight weeks, two in-person in Norway, six hybrid; the world's first all-female, all-technical accelerator.",
  },
  {
    label: 'the community',
    href: '/community',
    // Event, city and country counts derive from the collection; the 1,500+
    // figure is not derivable from it and stays written out.
    line: `${eventStats.eventCount} events across ${eventStats.cityCount} cities and ${eventStats.countryCount} countries; 1,500+ technical women hosted in person.`,
  },
];

const cohorts = [
  { label: 'cohort 1', rate: '8.7%' },
  { label: 'cohort 2', rate: '7.4%' },
];

const lead = {
  name: 'Dr. Milette Gillow',
  photo: '/about/milette.png',
  linkedin: 'https://www.linkedin.com/in/milettegillow/',
  bio: [
    'PhD mathematics, Leeds; started university aged 16.',
    'Investor and founder-in-residence at Entrepreneurs First; VC analyst in Berlin and Hong Kong; EWOR venture scout.',
    'Governing board, Oxford High School GDST.',
  ],
};

// One flat grid: the rest of the core team and the venture partners, in one
// run alphabetised by last name. Name and LinkedIn only — no roles in here, so everyone
// reads at the same weight. Community leads come from the shared config, and
// the venture partners from the same list /accelerator renders, so nothing is
// retyped. Milette is above this grid, not in it.
const core = [
  {
    name: 'Sara Patti',
    photo: '/community/leads/sara-patti.png',
    linkedin: 'https://www.linkedin.com/in/sara-patti/',
  },
  {
    name: 'Shameem Golestaneh',
    photo: '/community/leads/shameem-golestaneh.png',
    linkedin: 'https://www.linkedin.com/in/shameem-golestaneh-3378b3194/',
  },
  ...COMMUNITY_LEADS.map((person) => ({
    name: person.name,
    photo: person.photo ? `/community/leads/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
];

const team = [
  ...core,
  ...VENTURE_PARTNERS.map((person) => ({
    name: person.name,
    photo: person.photo ? `/accelerator/venture-partners/${person.photo}` : undefined,
    linkedin: person.linkedin || undefined,
  })),
].sort(byLastName);

/**
 * Institutions the team and partners come from, in display order: the most
 * widely recognised names lead the scroll. Names, heights and tones come from
 * the shared table in the config.
 */
const INSTITUTIONS = Object.keys(TEAM_LOGOS).map(teamLogo);

const institutionMarquee = [...INSTITUTIONS, ...INSTITUTIONS];

const stats = [
  {
    figure: '70%',
    label: 'of participants met a potential co-founder at a bros event',
    source: 'post-event surveys, 2024-25',
  },
  {
    figure: '80%',
    label: 'report being more likely to found a startup after attending a bros events',
    source: 'post-event surveys, 2024-25',
  },
];
---

<BaseLayout
  title="About"
  description="Why The Tech Bros exists, what we've built, and who's behind it."
>
  <Navigation />
  <main class="about">
    <!-- 3. The three things we do -->
    <section class="pillars">
      <div class="container">
        <h1>what we do</h1>
        <p class="opening">
          we back the most ambitious technical women to build startups from scratch,
          through our 3 pillars: our fund, accelerator, and global community.
        </p>
        <ul class="pillar-grid">
          {pillars.map((pillar) => (
            <li class="pillar">
              <a href={pillar.href} class="holo pillar-card">
                <span class="pillar-label">{pillar.label}</span>
                <span class="pillar-line">{pillar.line}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Why we do it -->
    <section class="why-we-do-it">
      <div class="container">
        <h2>why we do it</h2>
        <a href="/fund" class="why-claim">women-owned businesses are a better bet.</a>
        <p class="why-body">
          Female-founded startups consistently outperform startups with all-male teams, yet receive
          a fraction of the venture funding.
        </p>
        <div class="why-points">
          {whyPoints.map((point) => (
            <div class="why-point">
              <p class="why-point-text">{point.text}</p>
              <a class="why-source" href={point.url} target="_blank" rel="noopener noreferrer">
                {point.source}
              </a>
            </div>
          ))}
        </div>
        <p class="why-close">
          We believe in creating an entirely new pipeline for backing exceptional female founders,
          from idea stage to pre-seed and all the way through to exit or IPO.
        </p>
      </div>
    </section>

    <!-- 4. Trajectory. Year counts come from the events collection. -->
    <section class="trajectory">
      <div class="container">
        <h2>where we are</h2>
        <ol class="year-list">
          {eventYears.map((year) => (
            <li class="year">
              <span class="year-label">{year.year}</span>
              <span class="year-bar" style={`--fill: ${(year.count / peakYear) * 100}%`}></span>
              <span class="year-count">
                {year.count} events
                {year.year === currentYear && <span class="year-note">...so far!</span>}
              </span>
            </li>
          ))}
        </ol>

        <p class="trajectory-note">
          Two accelerator cohorts and 500+ applications, all reached organically, and a fund
          cornerstone-backed by the British Business Bank.
        </p>

        <ul class="acceptance">
          {cohorts.map((cohort) => (
            <li class="acceptance-item">
              <span class="acceptance-rate">{cohort.rate}</span>
              <span class="acceptance-label">acceptance rate, {cohort.label}</span>
            </li>
          ))}
        </ul>

      </div>
    </section>

    <!-- 5. Team. `id="team"` is the target of the /team redirect. -->
    <section class="team" id="team">
      <div class="section-banner holo">
        <div class="container"><h2>founder</h2></div>
      </div>

      <div class="container">
        <!-- The founder, centred, carrying the only bio on the page. -->
        <div class="person team-lead">
          <!-- Photo and name are one link, the same way a tile works in
               PeopleGrid: no separate icon, and the whole thing is the target. -->
          <a
            class="lead-card"
            href={lead.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${lead.name} on LinkedIn`}
          >
            <span class="person-portrait person-portrait-lead">
              <img
                src={lead.photo}
                alt={lead.name}
                class="person-photo"
                loading="lazy"
                decoding="async"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
              <span class="person-photo-placeholder" hidden aria-hidden="true"></span>
            </span>
            <span class="person-name">{lead.name}</span>
          </a>
          <ul class="person-bio">
            {lead.bio.map((line) => <li>{line}</li>)}
          </ul>
        </div>

      </div>

      <div class="section-banner holo">
        <div class="container"><h2>team</h2></div>
      </div>

      <div class="container">
        <!-- Everyone else: the same grid the venture partners and cohort 2
             founders use on /accelerator. -->
        <PeopleGrid people={team} columns={6} />

        <div class="leads-cta">
          <a href="/community#community-leads" class="btn btn-primary">become a community lead for your city</a>
        </div>
      </div>

      <!-- Institutions. Same marquee treatment as the sponsor wall on the home
           page; empty until the logos are supplied. -->
      <div class="institutions">
        <div class="container">
          <p class="institutions-heading">our team and partners come from</p>
        </div>
        <div class="institution-carousel">
          <div class="institution-track">
            {institutionMarquee.map((logo) => (
              <div class="institution-item">
                <img
                  src={logo.src}
                  alt={logo.name}
                  data-tone={logo.tone}
                  style={`height: ${logo.height}px`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Stats -->
    <section class="stats">
      <div class="container">
        <ul class="stat-grid">
          {stats.map((stat) => (
            <li class="stat-item">
              <span class="stat-figure">{stat.figure}</span>
              <span class="stat-label">{stat.label}</span>
              <span class="stat-source">{stat.source}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about section {
    padding: 5rem 0;
  }

  /* `what we do` is the page's h1 now that the opening section has gone; it
     keeps the section-heading treatment so nothing shifts visually. */
  .about h1,
  .about h2 {
    font-size: var(--text-h2);
    color: var(--color-text);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 2.5rem;
  }

  /* Full-bleed divider, same treatment as the section banners on /press.
     Direct child of the section, so it runs edge to edge. */
  /* Same rhythm as the banners on /press: the band gives its heading room, the
     gap under it gives the section room, and the gap above stays larger. */
  .section-banner {
    margin-bottom: 2.5rem;
    padding: 1.25rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.05;
  }

  /* The banner carries the section's top edge. */
  .about section.team {
    padding-top: 3.5rem;
  }

  .team .section-banner {
    margin-bottom: 2rem;
  }

  /* The second banner heads the grid, so it needs air above it as well as
     below — the founder block ends right against it otherwise. */
  .team .section-banner + .container + .section-banner,
  .team .container + .section-banner {
    margin-top: 3.5rem;
  }

  /* ── 1. The three things we do — the page now opens here ── */
  .pillars {
    padding-top: 4.5rem;
  }

  /* ── 2. Why we do it ── */
  /* Pink at rest, like every other link. On hover the foil fills the
     letterforms themselves via background-clip.

     This is the one place on the site where the holographic surface is used as
     a text effect rather than a background — a deliberate exception, made here
     and nowhere else. The gradient comes from the same `--holo-surface-image`
     token as every real surface, so the two can't drift apart. */
  .why-claim {
    display: inline-block;
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.25;
    color: var(--color-primary);
    text-decoration: none;
    margin-bottom: 2rem;
    background-color: transparent;
    background-image: var(--holo-surface-image);
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    /* The gradient is painted but masked out until hover, so only the colour
       has to change and the fill doesn't have to be built mid-transition. */
    -webkit-text-fill-color: var(--color-primary);
    transition: -webkit-text-fill-color var(--transition-btn), font-weight var(--transition-btn);
  }

  .why-claim:hover,
  .why-claim:focus-visible,
  .why-claim.is-hover {
    /* Heavier so the pastels hold their own against black — a hairline stroke
       in these tints reads as washed out. */
    font-weight: var(--weight-holo);
    -webkit-text-fill-color: transparent;
  }

  .why-body,
  .why-close {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
  }

  /* No markers: the indent and the spacing between points do the work. */
  .why-points {
    margin: 0 0 2.5rem;
    padding-left: 1.5rem;
  }

  .why-point + .why-point {
    margin-top: 2rem;
  }

  .why-point-text {
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  /* Same citation treatment as the market case on /fund. */
  .why-source {
    display: inline-block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
  }

  .why-source:hover,
  .why-source:focus-visible {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  .why-close {
    margin-bottom: 0;
  }

  /* Larger than body copy, smaller than a heading, and full width rather than
     held to a measure. */
  .opening {
    font-size: var(--text-h4);
    line-height: 1.45;
    color: var(--color-text);
    margin-bottom: 3rem;
  }

  .pillar-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* The whole card is the link. The holographic surface carries it, and the
     global `.holo` rule forces black text on top. */
  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 20rem;
    padding: 2.5rem;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 0;
    transition: background-color var(--transition-btn), color var(--transition-btn);
  }

  /* Same inversion as the primary button: solid black, white text, and the
     foil reduced to a 1px border. */
  .pillar-card:hover,
  .pillar-card:focus-visible {
    background-color: var(--color-black);
    background-image: none;
    border-color: transparent;
    border-image-source: var(--holo-border-image);
    border-image-slice: 1;
  }

  .pillar-card:hover,
  .pillar-card:hover *,
  .pillar-card:focus-visible,
  .pillar-card:focus-visible * {
    color: var(--color-white) !important;
  }

  .pillar-label {
    font-size: var(--text-h3);
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.1;
  }

  .pillar-line {
    font-size: var(--text-lead);
    font-weight: var(--weight-holo);
    line-height: 1.4;
  }

  /* ── 4. Trajectory ── */
  .year-list {
    list-style: none;
  }

  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 12rem;
    align-items: center;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .year-label {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text-muted);
  }

  /* Proportional to the busiest year, so the growth is visible, not asserted. */
  .year-bar {
    display: block;
    height: 10px;
    background: var(--color-surface);
    position: relative;
  }

  .year-bar::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill);
    background: var(--color-primary);
  }

  .year-count {
    font-size: var(--text-lead);
    color: var(--color-text);
    white-space: nowrap;
  }

  /* An aside, not a trailing fragment: enough space to read as a separate
     remark, and white so it carries. */
  .year-note {
    margin-left: 1.5rem;
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: var(--weight-holo);
  }

  .trajectory-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  .acceptance {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  .acceptance-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .acceptance-rate {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .acceptance-label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  /* ── 5. Team: the lead on her own, then everyone else in a tight grid ── */
  /* Centred as a unit and roughly twice as wide as before, so the bio lines
     don't break mid-phrase. */
  .team-lead {
    max-width: 44rem;
    margin: 0 auto 3rem;
    text-align: center;
  }

  /* The link is the tile: it carries no decoration of its own, so the photo
     and name read exactly as they did before you hover. */
  .lead-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .person-portrait-lead {
    display: block;
    margin-bottom: 1rem;
  }

  .person-portrait-lead .person-photo,
  .person-portrait-lead .person-photo-placeholder {
    margin: 0 auto;
  }

  .person-portrait-lead .person-photo,
  .person-portrait-lead .person-photo-placeholder {
    display: block;
    height: 320px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .person-portrait-lead .person-photo-placeholder {
    width: 240px;
    background: var(--color-surface);
  }

  .person-portrait-lead [hidden] {
    display: none !important;
  }

  /* The lead's name sits a step down from a section heading, not level with it. */
  .team-lead .person-name {
    display: block;
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0.25rem;
    transition: color var(--transition-btn);
  }

  /* The grid's hover, at this size: the portrait drops back and the name goes
     pink. Kept in step with PeopleGrid on purpose. */
  .person-portrait-lead .person-photo {
    transition: opacity var(--transition-btn);
  }

  .lead-card:hover .person-photo,
  .lead-card:focus-visible .person-photo {
    opacity: 0.6;
  }

  .lead-card:hover .person-name,
  .lead-card:focus-visible .person-name {
    color: var(--color-primary);
  }

  /* The block is centred by its parent; the list itself reads left — a centred
     list of bullets is unreadable. */
  .person-bio {
    list-style: none;
    margin-top: 1.5rem;
    text-align: left;
  }

  .person-bio li {
    font-size: var(--text-small);
    color: var(--color-text-body);
    line-height: 1.5;
    margin-bottom: 0.6rem;
    padding-left: 1rem;
    position: relative;
  }

  .person-bio li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .leads-cta {
    margin-top: 3rem;
    text-align: center;
  }

  /* ── Institutions: same marquee as the sponsor wall on the home page ── */
  .institutions {
    margin-top: 4.5rem;
  }

  .institutions-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .institution-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Fades at both ends so marks dissolve rather than being sliced. */
    mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 92%, transparent 100%);
  }

  .institution-track {
    display: flex;
    gap: 4rem;
    animation: institution-scroll 90s linear infinite;
    width: fit-content;
  }

  @keyframes institution-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .institution-track {
      animation: none;
    }
  }

  .institution-item {
    flex-shrink: 0;
    width: 220px;
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
  }

  .institution-item img {
    display: block;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* ── Marks on an opaque background ──
     `brightness(0) invert(1)` whitens every non-transparent pixel, so artwork
     that ships with a background flattens to a solid white rectangle. These
     three treatments drop the background to black and lift the mark to white
     instead; which one works depends on where the background sits relative to
     the contrast pivot. */

  /* Dark or saturated background, mark already light. */
  .institution-item img[data-tone='threshold'] {
    filter: grayscale(1) contrast(5);
  }

  /* Background sits mid-to-light, so it needs pulling under the pivot first
     or it whites out. */
  .institution-item img[data-tone='knockout'] {
    filter: grayscale(1) brightness(0.7) contrast(20);
  }

  /* The mirror case: a background dark enough that the mark needs lifting
     over the pivot rather than the background pushed under it. */
  .institution-item img[data-tone='knockout-dark'] {
    filter: grayscale(1) brightness(1.2) contrast(20);
  }

  /* ── 6. Stats ── */
  .stats {
    border-top: 1px solid var(--color-border);
  }

  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    color: var(--color-primary);
  }

