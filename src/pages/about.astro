<style>
  .mission {
    padding: 6rem 0 4rem;
  }

  .mission-content {
    max-width: 800px;
    margin: 0;
  }

  .lead {
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: 2rem;
    font-weight: 400;
  }

  .mission-content p {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .origin {
    background: rgba(0, 0, 0, 0.2);
    padding: 4rem 0;
  }

  .origin-list {
    list-style: none;
    margin: 2rem 0;
    padding-left: 0;
  }

  .origin-list li {
    padding: 0.3rem;
    padding-left: 2rem;
    position: relative;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .origin-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .origin p {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  /* ── Team, moved from /team ── */
  .founders {
    padding: 6rem 0 4rem;
  }

  .section-intro {
    text-align: left;
    font-size: 1.2rem;
    margin-bottom: 3rem;
    color: var(--color-text);
  }

  /* ── People grid — shared treatment for all team photography ──
     Photos sit straight on the black page: no card, no frame, no border.
     3:4 portrait crop weighted to the top third so faces don't lose chins. */
  .person-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin-top: 3rem;
  }

  .person-card {
    max-width: 320px;
    text-align: left;
  }

  .person-photo {
    display: block;
    width: 100%;
    /* height:auto is load-bearing — the width/height attributes are a
       presentational hint that would otherwise pin the height and make
       aspect-ratio a no-op. */
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 25%;
    margin-bottom: 1rem;
  }

  .person-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .person-name {
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .person-meta {
    color: var(--color-primary);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 1rem;
  }

  @media (max-width: 1024px) {
    .person-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .person-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .team-bio {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 0.95rem;
    text-align: left;
    list-style-position: outside;
    padding-left: 1.5rem;
  }

  .team-bio li {
    margin-bottom: 0.75rem;
  }

  .team-bio li:last-child {
    margin-bottom: 0;
  }

  /* The LinkedIn icon uses the shared .event-link treatment. */
  .event-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity var(--transition-btn), color var(--transition-btn);
  }

  .event-link:hover,
  .event-link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .event-link svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .core-team {
    background: rgba(0, 0, 0, 0.2);
    padding: 4rem 0;
  }

  .work-with-us {
    padding: 4rem 0;
  }

  .open-roles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .role-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2rem;
    border-radius: 0;
  }

  .role-card h3 {
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .role-card p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .role-details {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .no-roles-message {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .no-roles-message a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .no-roles-message a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .open-roles {
      grid-template-columns: 1fr;
    }
  }
</style>
