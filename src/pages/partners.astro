---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ContactButton from '../components/ContactButton.astro';
---

<BaseLayout title="Partners">
  <Navigation />
  <main>
    <!-- Hero -->
    <section class="partner-hero">
      <div class="container">
        <h1>partner with us</h1>
        <p class="hero-subtitle">Access the world's best technical founders. Build the future together.</p>
      </div>
    </section>

    <!-- companies, moved from /partner/companies -->
    <section class="partner-group" id="companies">
      <div class="container">
        <h2 class="partner-group-title">partner with us: companies</h2>
      </div>
    </section>
    <section class="companies-partner">
      <div class="container">
        <div class="partner-content">
          <h2>why partner with the tech bros</h2>
          <p class="section-intro">We work with companies who want access to technical women they wouldn't otherwise meet.</p>
          <p>Our events are not broad, open meetups. They are highly curated, technical-first spaces that attract senior engineers, researchers, and early-stage founders across AI, robotics, deep tech, and applied science.</p>
          
          <h3>partnering with us gives you:</h3>
          <ul class="partner-list">
            <li>Direct access to a hard-to-reach technical talent pool</li>
            <li>High-signal brand exposure in a trusted community</li>
            <li>A credible way to support women in tech without performative initiatives</li>
          </ul>

          <h2>what partnership looks like</h2>
          <p>You sponsor a one-off event that we design with you, aligned to your goals.</p>
          
          <h3>typical formats include:</h3>
          <ul class="partner-list">
            <li>Hackathons</li>
            <li>Technical conferences or panels</li>
            <li>Co-working and community days</li>
          </ul>
          <p>We handle curation, audience quality, and delivery. You show up to the right room.</p>
        </div>
      </div>
    </section>

    <div class="spotlight-hero-image">
      <img 
        src="/partners/bang-olufsen-hackathon-hero.jpg" 
        alt="Bang & Olufsen Hackathon"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="1920"
        height="1080"
      />
    </div>

    <section class="spotlight-section">
      <div class="container">
        <div class="spotlight-content">
          <div class="spotlight-images-left">
            <img src="/partners/bang-olufsen-1.jpg" alt="Bang & Olufsen Hackathon" />
            <img src="/partners/bang-olufsen-2.jpg" alt="Bang & Olufsen Hackathon" />
            <img src="/partners/bang-olufsen-3.jpg" alt="Bang & Olufsen Hackathon" />
          </div>
          <div class="spotlight-text-column">
            <h2>spotlight: bang & olufsen hackathon</h2>
            <p>We partnered with Bang & Olufsen on a bespoke hackathon bringing together technical women across hardware, AI, and engineering.</p>
            <div class="spotlight-stats">
              <div class="spotlight-stat">
                <div class="spotlight-number">24</div>
                <div class="spotlight-label">participants</div>
              </div>
              <div class="spotlight-stat">
                <div class="spotlight-number">73%</div>
                <div class="spotlight-label">CS / AI / Engineering background</div>
              </div>
            </div>
            <p>The event created meaningful technical engagement, high-quality conversations, and strong brand alignment without feeling like a recruitment fair.</p>
            
            <div class="spotlight-quotes">
              <blockquote>"It was ABSOLUTELY FANTASTIC to have an all woman event! Had some great meaningful conversations that wouldn't regularly pop up in mixed events! Great to get other girls inputs and experiences of the STEM industry 🧡This was a true pleasure!"</blockquote>
              <blockquote>"Keep it going, you make such a great impact 💗"</blockquote>
              <blockquote>"Thank you for hosting this and we expect more hackathons in the future :)"</blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="companies-partner">
      <div class="container">
        <div class="partner-content">

          <div class="text-center" style="margin-top: 3rem;">
            <ContactButton label="Get in Touch" />
          </div>
        </div>
      </div>
    </section>
    <!-- investors, moved from /partner/investors -->
    <section class="partner-group" id="investors">
      <div class="container">
        <h2 class="partner-group-title">partner with us: investors</h2>
      </div>
    </section>
    <section class="investors-partner">
      <div class="container">
        <div class="partner-content">
          <h2>why partner with the tech bros</h2>
          <p class="section-intro">We introduce investors to exceptional technical founders early.</p>
          <p>Our community includes women building in AI, robotics, biotech, climate, and deep tech, many of whom are pre-incorporation or pre-raise. These are founders you won't meet through warm intros or demo days.</p>
          
          <h3>partnering with us allows you to:</h3>
          <ul class="partner-list">
            <li>Build relationships before rounds are competitive</li>
            <li>Be top of mind for high-potential technical founders</li>
            <li>Develop genuine founder trust outside a pitch context</li>
          </ul>

          <h2>what partnership looks like</h2>
          <p>You sponsor an event designed to bring you into the room early, not on a stage at the end.</p>
          
          <h3>formats include:</h3>
          <ul class="partner-list">
            <li>Founder–investor salons</li>
            <li>Panels with portfolio founders</li>
            <li>Small-group discussions and working sessions</li>
          </ul>
          <p>We prioritise depth, not deal theatre.</p>
        </div>
      </div>
    </section>

    <div class="spotlight-hero-image">
      <img 
        src="/partners/mercuri-canva-event-hero.jpg" 
        alt="Mercuri Ventures x Canva Event"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="1920"
        height="1080"
      />
    </div>

    <section class="spotlight-section">
      <div class="container">
        <div class="spotlight-content">
          <div class="spotlight-images-left">
            <img src="/partners/mercuri-canva-1.jpg" alt="Mercuri Ventures x Canva Event" />
            <img src="/partners/mercuri-canva-2.jpg" alt="Mercuri Ventures x Canva Event" />
            <img src="/partners/mercuri-canva-3.jpg" alt="Mercuri Ventures x Canva Event" />
          </div>
          <div class="spotlight-text-column">
            <h2>spotlight: mercuri ventures x canva</h2>
            <p>We partnered with Mercuri Ventures, Canva, and ElevenLabs on a hackathon connecting technical women with experienced operators and investors.</p>
            <div class="spotlight-stats">
              <div class="spotlight-stat">
                <div class="spotlight-number">35</div>
                <div class="spotlight-label">participants</div>
              </div>
              <div class="spotlight-stat">
                <div class="spotlight-number">80%</div>
                <div class="spotlight-label">in target fields (CS / AI / Maths / Engineering / Robotics)</div>
              </div>
              <div class="spotlight-stat">
                <div class="spotlight-number">4.5</div>
                <div class="spotlight-label">stars</div>
              </div>
            </div>            
            <div class="spotlight-quotes">
              <blockquote>Today has been great! I loved the collaborative effort of everyone and getting us to actual problem solve!</blockquote>
              <blockquote>It's been a lovely event to brainstorm and network! I definitely feel even more inspired to become a founder in future, knowing I have a solid foundation for that. Thank you once again for the event 💞</blockquote>
              <blockquote>I had so much fun! I thought the set up was amazing and I really appreciated the panel in the morning. The whole experience has definitely improved my confidence and the panel made me really excited about the idea to found or co-found my own startup. I would love to attend future events!</blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="investors-partner">
      <div class="container">
        <div class="partner-content">

          <div class="text-center" style="margin-top: 3rem;">
            <ContactButton label="Connect With Us" />
          </div>
        </div>
      </div>
    </section>
    <section class="partner-outro">
      <div class="container">
        <p>
          Working in higher education?
          <a href="/partners/universities">See how we partner with universities</a>.
        </p>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .partner-hero {
    padding: 6rem 0 3rem;
    text-align: center;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-top: 1rem;
    font-weight: 300;
  }

  .partner-group {
    padding: 4rem 0 0;
  }

  .partner-outro {
    padding: 4rem 0;
    border-top: 1px solid var(--color-border);
  }

  .partner-outro p {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .partner-outro a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .partner-outro a:hover {
    color: var(--color-primary-hover);
  }

  .partner-group-title {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  /* ── from /partner/companies ── */
.companies-partner {
    padding: 4rem 0;
    background: rgba(0, 0, 0, 0.2);
  }

  .partner-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .partner-content h2 {
    color: var(--color-text);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  .partner-content h2:first-of-type {
    margin-top: 0;
  }

  .partner-content h3 {
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .section-intro {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    line-height: 1.8;
  }

  .partner-content p {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
  }

  .partner-list {
    list-style: none;
    padding-left: 0;
    margin: 1.5rem 0;
  }

  .partner-list li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .partner-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .spotlight-hero-image {
    width: 100%;
    margin: 4rem 0;
  }

  .spotlight-hero-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .spotlight-section {
    padding: 4rem 0;
    background: rgba(0, 0, 0, 0.2);
  }

  .spotlight-content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
  }

  .spotlight-images-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spotlight-images-left img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0;
    object-fit: cover;
  }

  .spotlight-text-column h2 {
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .spotlight-quotes {
    margin-top: 2rem;
  }

  .spotlight-quotes blockquote {
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    border-left: 3px solid var(--color-primary);
    font-size: 1.05rem;
  }

  .spotlight-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: 2rem 0;
  }

  .spotlight-stat {
    text-align: center;
  }

  .spotlight-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .spotlight-label {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .spotlight-stats {
      grid-template-columns: 1fr;
    }

    .spotlight-content {
      grid-template-columns: 1fr;
    }

    .spotlight-text-column {
      order: 1;
    }

    .spotlight-images-left {
      order: 2;
    }
  }
  /* ── from /partner/investors ── */
.investors-partner {
