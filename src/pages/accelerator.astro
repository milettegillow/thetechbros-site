---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import { VENTURE_PARTNERS } from '../data/venture-partners';
import { COHORT_2 } from '../data/cohort-2';
import { COHORT_STRIP } from '../config';

const programme = [
  'a two-day in-person kickoff in london.',
  'two weeks in person at a hacker house in norway.',
  'six weeks hybrid, following the two in norway.',
  'an eleven-strong venture partner bench.',
  'weekly workshops from industry leaders.',
  'a demo day for invited investors.',
];

const whoGetsIn = [
  {
    figure: '500+',
    label: 'applications across two cohorts',
    detail: 'all reached organically',
  },
  { figure: '40', label: 'founders selected', detail: 'solo or in teams of 2-3' },
  {
    figure: '8.7% / 7.4%',
    label: 'acceptance rate, cohort 1 / cohort 2',
    detail: 'more competitive than Oxford or Cambridge',
  },
  { figure: '45%', label: 'ex-big tech engineers', detail: 'Tesla, Apple, Google, NASA' },
  {
    figure: '70%',
    label: 'attended a global top 25 university',
    detail: 'Stanford, MIT, Oxford, Cambridge',
  },
  { figure: '100%', label: 'STEM', detail: '80% engineering, CS or AI/ML backgrounds' },
];

// Restored from the old /apply/faq page, which redirects to #faq below.
const faqs = [
  {
    q: 'why are you called the tech bros?',
    a: "It's a tongue-in-cheek name. Our community of technical women love it, and that's who we're here for.",
  },
  {
    q: 'am I eligible?',
    a: 'All-female founding teams where everyone has a STEM background are invited to apply.',
  },
  {
    q: 'do I need a co-founder?',
    a: 'We don\u2019t do any co-founder matching on the programme. You can apply as a solo founder, but we recommend applying in a team of two if possible.',
  },
  {
    q: 'do I need to be working on my startup full-time?',
    a: 'Yes. Everyone accepted onto the accelerator must be working on their startup full-time.',
  },
  {
    q: 'do I need to be based anywhere specific?',
    a: 'No. We accept applications globally.',
  },
];

const cohortOnCohort = [
  { measure: 'repeat founders', one: '10%', two: '45%' },
  { measure: 'hardware founders', one: '5%', two: '45%' },
  { measure: 'users or pilots at selection', one: '35%', two: '90%' },
];

/**
 * Where cohort members came from. The list, its order, and each mark's tuned
 * height all live in the shared config, so this strip and "where they came
 * from" on /fund cannot drift apart.
 */
const origins = COHORT_STRIP;

---

<BaseLayout
  title="Accelerator"
  description="The world's first all-female, all-technical accelerator."
>
  <Navigation />
  <main class="accelerator">
    <!-- 1. Headline -->
    <section class="acc-hero">
      <div class="container">
        <div class="acc-hero-layout">
          <div class="acc-hero-copy">
            <h1>the world's first all-female, all-technical accelerator</h1>
            <p class="hero-line">
              eight weeks. twenty founders. 500+ applications, all reached organically.
            </p>
          </div>
          <img
            src="/accelerator/hero.jpg"
            alt="Cohort founders at a Tech Bros accelerator session"
            class="section-photo"
            width="6000"
            height="4000"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- 3. The programme -->
    <section class="programme">
      <div class="section-banner holo">
        <div class="container"><h2>the programme</h2></div>
      </div>

      <div class="container">
        <div class="programme-layout">
          <div class="programme-detail">
            <ul class="programme-list">
              {programme.map((item) => <li>{item}</li>)}
            </ul>
            <p class="programme-terms">investment terms are confirmed at offer stage.</p>
          </div>
          <div class="programme-photo-frame">
            <img
              src="/accelerator/norway-cohort.jpg"
              alt="Cohort founders at the hacker house in Norway"
              class="section-photo"
              width="1066"
              height="1600"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Who gets in -->
    <section class="who-gets-in">
      <div class="section-banner holo">
        <div class="container"><h2>who gets in</h2></div>
      </div>

      <div class="container">
        <p class="who-frame">this is who you'd be joining.</p>
        <ul class="stat-grid">
          {whoGetsIn.map((item) => (
            <li class="stat-item">
              <span class="stat-figure">{item.figure}</span>
              <span class="stat-label">{item.label}</span>
              {item.detail && <span class="stat-detail">{item.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4b. FAQ. `id="faq"` is the target of the /apply/faq redirect. -->
    <section class="faq" id="faq">
      <div class="section-banner holo">
        <div class="container"><h2>common questions</h2></div>
      </div>

      <div class="container">
        <ul class="faq-list">
          {faqs.map((item) => (
            <li>
              <details class="faq-item">
                <summary>
                  <span class="faq-question">{item.q}</span>
                  <span class="faq-marker" aria-hidden="true"></span>
                </summary>
                <p class="faq-answer">{item.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Cohort on cohort -->
    <section class="cohorts">
      <div class="section-banner holo">
        <div class="container"><h2>cohort on cohort</h2></div>
      </div>

      <div class="container">
        <div class="cohorts-layout">
          <img
            src="/accelerator/cohort-on-cohort.jpg"
            alt="Cohort founders working together"
            class="section-photo"
            width="5926"
            height="3951"
            loading="lazy"
            decoding="async"
          />
          <div class="cohorts-detail">
        <table class="cohort-table">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col">cohort 1</th>
              <th scope="col">cohort 2</th>
            </tr>
          </thead>
          <tbody>
            {cohortOnCohort.map((row) => (
              <tr>
                <th scope="row">{row.measure}</th>
                <td class="cohort-from">{row.one}</td>
                <td class="cohort-to">{row.two}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="cohort-note">the programme is getting more competitive.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Where founders came from. Not partners or sponsors — those live on /partners. -->
    <section class="origins">
      <div class="section-banner holo">
        <div class="container"><h2>our founders come from</h2></div>
      </div>

      <div class="container">
        <ul class="origin-strip">
          {origins.map((org) => (
            <li class="origin-item">
              <img
                src={org.src}
                alt={org.name}
                class="origin-logo"
                data-tone={org.tone}
                style={`height: ${org.height}px`}
                {/* Eager: a lazy image never fires onerror, so a missing file
                    would sit there broken instead of falling back. */}
                loading="eager"
                decoding="async"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
              <span class="origin-name" hidden>{org.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Founders who found us at an event -->
    <section class="from-events">
      <div class="container">
        <h2>many of our founders find us at an event first</h2>
        <p class="from-events-line">
          Four of our twenty cohort 2 founders first came to us as prize winners at bros events.
        </p>
        <div class="btn-group">
          <a href="/community" class="btn btn-tertiary">see the community</a>
          <a href="/partners" class="btn btn-tertiary">partner with us</a>
        </div>
      </div>
    </section>

    <!-- 8. Venture partners -->
    <section class="partners" id="venture-partners">
      <div class="section-banner holo">
        <div class="container"><h2>venture partners</h2></div>
      </div>

      <div class="container">
        <PeopleGrid people={VENTURE_PARTNERS} photoBase="/accelerator/venture-partners" columns={6} />
      </div>
    </section>

    <!-- 9. Cohort 2 -->
    <section class="cohort-2">
      <div class="section-banner holo">
        <div class="container"><h2>cohort 2</h2></div>
      </div>

      <div class="container">
        <p class="cohort-2-line">270+ applied. twenty selected. a 7.4% acceptance rate.</p>
        <PeopleGrid people={COHORT_2} photoBase="/accelerator/cohort-2" columns={5} />
      </div>
    </section>

    <!-- 10. Applications status and sign-up. `id="apply-now"` is the target of
         the /apply/accelerator#apply-now redirect, which is still in
         circulation, and `id="newsletter"` of links to the sign-up. -->
    <section class="status" id="apply-now">
      <div class="container">
        <div class="holo status-block">
          <p class="status-headline">cohort 3 applications open next spring.</p>
          <p class="status-sub">
            sign up to <a href="/community#newsletter">our newsletter</a> to hear first.
          </p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .accelerator section {
    padding: 5rem 0;
  }

  .accelerator h2 {
    font-size: var(--text-h2);
    color: var(--color-text);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 2.5rem;
  }

  /* Full-bleed divider, same treatment as the section banners on /press: a
     direct child of the section so it runs edge to edge, with its inner
     container keeping the heading on the page's text gutter. Deliberately
     shallow — a divider, not a statement block. */
  .section-banner {
    margin-bottom: 3rem;
    padding: 1.25rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.05;
  }

  /* The banner carries each section's top edge. */
  .accelerator section.programme,
  .accelerator section.who-gets-in,
  .accelerator section.faq,
  .accelerator section.cohorts,
  .accelerator section.origins,
  .accelerator section.partners,
  .accelerator section.cohort-2 {
    padding-top: 3rem;
  }

  /* ── FAQ ──
     Native <details>, so it opens without JavaScript and answers keyboard and
     screen-reader interaction for free. */
  .faq-list {
    list-style: none;
    max-width: 72ch;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-btn);
  }

  /* Safari draws its own triangle without this. */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover .faq-question,
  .faq-item summary:focus-visible .faq-question {
    color: var(--color-primary);
  }

  .faq-question {
    font-size: var(--text-lead);
    line-height: 1.4;
    color: var(--color-text);
    transition: color var(--transition-btn);
  }

  /* A plus that becomes a minus, rather than a rotating chevron — square, in
     keeping with the rest of the page. */
  .faq-marker {
    --faq-stroke: 1;
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    align-self: center;
  }

  .faq-item[open] .faq-marker {
    --faq-stroke: 0;
  }

  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    background: var(--color-primary);
  }

  .faq-marker::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }

  .faq-marker::after {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
    opacity: var(--faq-stroke);
    transition: opacity var(--transition-btn);
  }

  .faq-answer {
    color: var(--color-text-body);
    line-height: 1.6;
    padding: 0 0 1.5rem;
    margin: 0;
    max-width: 66ch;
  }

  .who-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  /* Photographs sit straight on black: contained so nothing is cropped, no
     border, no radius. */
  .section-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border: 0;
    border-radius: 0;
  }

  .acc-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
    gap: 3rem;
    align-items: center;
  }

  /* The photo fills the full height of the block beside it. `cover` rather
     than `contain`: matching the height exactly means losing a little off the
     top and bottom, which is preferable to a short photo against a long list. */
  .programme-layout,
  .cohorts-layout {
    display: grid;
    gap: 2rem;
    align-items: stretch;
  }

  .cohorts-layout {
    grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
  }

  .programme-layout .section-photo,
  .cohorts-layout .section-photo {
    object-fit: cover;
  }

  .programme-layout .section-photo {
    object-position: center;
  }

  /* ── 1. Headline ── */
  /* Out-specifies `.accelerator section`, which would otherwise reimpose 5rem
     and pull the banner away from the hero. */
  .accelerator section.acc-hero {
    padding: 4.5rem 0 1.25rem;
  }


  .acc-hero h1 {
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 52ch;
    margin-bottom: 0;
  }

  /* ── 2. Applications status ──
     The closing block, and the answer to the first question anyone arrives
     with. Deliberately NOT full-bleed, unlike the section banners above it:
     it sits inside the container so its edges line up with the section
     headings' text, which is what makes it read as a block on the page rather
     than another band across it. */
  .status-block {
    padding: 5rem 4rem;
    text-align: left;
  }

  .status-headline {
    font-size: var(--text-h2);
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.15;
    margin: 0 0 1.25rem;
    /* Narrow enough to break after "applications", so the headline sets in
       two lines rather than one long one. */
    max-width: 22ch;
  }

  .status-sub {
    font-size: var(--text-lead);
    margin-bottom: 0;
  }

  /* Buttons can't sit on the foil — black text is enforced there — so the
     newsletter is a plain underlined link instead. */
  .status-sub a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── 3. The programme ── */
  .programme-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
  }

  /* The frame is the height of the list beside it; the picture inside is run
     125% of that height and pulled up an eighth, so exactly the top and bottom
     tenth of the image fall outside it. Doing it here rather than through
     `cover` geometry keeps the crop at 10/10 whatever the column width or the
     list's height turn out to be. */
  .programme-photo-frame {
    position: relative;
    overflow: hidden;
  }

  .programme-photo-frame .section-photo {
    position: absolute;
    top: -12.5%;
    left: 0;
    width: 100%;
    height: 125%;
  }

  .programme-list {
    list-style: none;
    max-width: 60ch;
  }

  /* The rules between items do the separating; a marker as well is redundant.
     The left indent stays so the text sits exactly where it did before. */
  .programme-list li {
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.5;
    padding: 1rem 0 1rem 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .programme-terms {
    margin: 2.5rem 0 0;
    color: var(--color-text-muted);
  }

  /* ── 4. Who gets in ── */
  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .stat-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  .stat-detail {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ── 5. Cohort on cohort ── */
  .cohort-table {
    width: 100%;
    max-width: 46rem;
    border-collapse: collapse;
    text-align: left;
  }

  .cohort-table th,
  .cohort-table td {
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cohort-table thead th {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-weight: var(--weight-body);
  }

  .cohort-table tbody th {
    font-weight: var(--weight-body);
    color: var(--color-text);
  }

  .cohort-from,
  .cohort-to {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    width: 8rem;
  }

  .cohort-from {
    color: var(--color-text-muted);
  }

  .cohort-to {
    color: var(--color-primary);
  }

  .cohort-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  /* ── 6. Origins strip ── */
  .origin-strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 2.5rem;
    align-items: center;
  }

  .origin-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    /* Same treatment as the as-seen-in strip and the partner wall. */
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* Coloured plate with the mark knocked out of it: grayscale plus a hard
     contrast push drops the plate to black and lifts the mark to white. */
  .origin-logo[data-tone='threshold'] {
    filter: grayscale(1) contrast(5);
  }

  /* Same idea, but the plate sits light enough that it needs pulling down
     below the contrast pivot first, or it whites out instead. */
  .origin-logo[data-tone='knockout'] {
    filter: grayscale(1) brightness(0.7) contrast(20);
  }

  /* A lockup that is both a coloured plate and dark type beside it. Inverting
     first drops the plate below the contrast pivot and lifts the type above
     it, so one pass keeps the knocked-out glyph *and* the wordmark — every
     other treatment loses one or the other. */
  .origin-logo[data-tone='plate'] {
    filter: invert(1) grayscale(1) brightness(1.2) contrast(3);
  }

  /* Wordmark fallback for organisations with no logo file yet. */
  .origin-item [hidden] {
    display: none !important;
  }

  .origin-name {
    font-size: var(--text-body);
    color: var(--color-text);
    letter-spacing: var(--tracking-subheading);
  }

  /* ── 7. From events ── */
  .from-events-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 58ch;
    margin-bottom: 0;
  }

  /* ── 9. Cohort 2 ── */
  .cohort-2-line {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 768px) {
    .accelerator section {
      padding: 3.5rem 0;
    }

    /* Photos stack: below the list and the headline, above the table. */
    .programme-layout,
    .acc-hero-layout,
    .cohorts-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .cohorts-layout .section-photo {
      order: -1;
    }

    /* Stacked: the frame gets an explicit height, since there is no longer a
       list beside it to take its height from. */
    .programme-photo-frame {
      height: 22rem;
    }

    .cohorts-layout .section-photo {
      height: auto;
      max-height: 26rem;
      object-fit: cover;
    }

    .status-block {
      padding: 3rem 1.75rem;
    }

    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cohort-from,
    .cohort-to {
      width: auto;
    }
  }
</style>
