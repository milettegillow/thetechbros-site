---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import { VENTURE_PARTNERS } from '../data/venture-partners';
import { COHORT_2 } from '../data/cohort-2';

const programme = [
  'a two-day in-person kickoff in london.',
  'two weeks in person at a hacker house in norway.',
  'six weeks hybrid, following the two in norway.',
  'an eleven-strong venture partner bench.',
  'weekly workshops from industry leaders.',
  'a demo day for invited investors.',
];

const whoGetsIn = [
  {
    figure: '500+',
    label: 'applications across two cohorts',
    detail: 'all reached organically',
  },
  { figure: '40', label: 'founders selected', detail: 'solo or in teams of 2-3' },
  {
    figure: '8.7% / 7.4%',
    label: 'acceptance rate, cohort 1 / cohort 2',
    detail: 'more competitive than Oxford or Cambridge',
  },
  { figure: '45%', label: 'ex-big tech engineers', detail: 'Tesla, Apple, Google, NASA' },
  {
    figure: '70%',
    label: 'attended a global top 25 university',
    detail: 'Stanford, MIT, Oxford, Cambridge',
  },
  { figure: '100%', label: 'STEM', detail: '80% engineering, CS or AI/ML backgrounds' },
];

const cohortOnCohort = [
  { measure: 'repeat founders', one: '10%', two: '45%' },
  { measure: 'hardware founders', one: '5%', two: '45%' },
  { measure: 'users or pilots at selection', one: '35%', two: '90%' },
];

/**
 * Where cohort members came from. `logo` points at public/index/cohort-logos/.
 * `height` is tuned per mark rather than shared: these range from tall icons to
 * wordmarks five times wider than they are tall, and one height renders them at
 * wildly different weights. `tone` overrides the default white-out for marks
 * that are a coloured plate with the shape knocked out of it — flattening those
 * to white fills the plate solid.
 */
const origins = [
  { name: 'Google', logo: '/index/cohort-logos/google.png', height: 28 },
  { name: 'Apple', logo: '/index/cohort-logos/apple.png', height: 40 },
  { name: 'NASA', logo: '/index/cohort-logos/nasa.png', height: 26 },
  { name: 'Tesla', logo: '/index/cohort-logos/tesla.png', height: 40 },
  { name: 'Microsoft', logo: '/index/cohort-logos/microsoft.png', height: 22 },
  { name: 'Meta', logo: '/index/cohort-logos/meta.png', height: 20 },
  { name: 'AWS', logo: '/index/cohort-logos/aws.png', height: 34 },
  { name: 'Discord', logo: '/index/cohort-logos/discord.png', height: 36, tone: 'threshold' },
  { name: 'Y Combinator', logo: '/index/cohort-logos/y-combinator.png', height: 26, tone: 'plate' },
  { name: 'Stanford', logo: '/index/cohort-logos/stanford.png', height: 28 },
  { name: 'MIT', logo: '/index/cohort-logos/mit.png', height: 30 },
  { name: 'Oxford', logo: '/index/cohort-logos/oxford.png', height: 26, tone: 'threshold' },
  { name: 'Cambridge', logo: '/index/cohort-logos/cambridge.png', height: 20 },
  { name: 'UC Berkeley', logo: '/index/cohort-logos/berkeley.png', height: 18 },
  { name: 'Caltech', logo: '/index/cohort-logos/caltech.png', height: 22 },
  { name: 'EPFL', logo: '/index/cohort-logos/epfl.svg', height: 24 },
  { name: 'ETH Zurich', logo: '/index/cohort-logos/ethzurich.png', height: 17 },
];

---

<BaseLayout
  title="Accelerator"
  description="The world's first all-female, all-technical accelerator."
>
  <Navigation />
  <main class="accelerator">
    <!-- 1. Headline -->
    <section class="acc-hero">
      <div class="container">
        <div class="acc-hero-layout">
          <div class="acc-hero-copy">
            <h1>the world's first all-female, all-technical accelerator</h1>
            <p class="hero-line">
              eight weeks. twenty founders. 500+ applications, all reached organically.
            </p>
          </div>
          <img
            src="/accelerator/hero.jpg"
            alt="Cohort founders at a Tech Bros accelerator session"
            class="section-photo"
            width="6000"
            height="4000"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- 3. The programme -->
    <section class="programme">
      <div class="section-banner holo">
        <div class="container"><h2>the programme</h2></div>
      </div>

      <div class="container">
        <div class="programme-layout">
          <div class="programme-detail">
            <ul class="programme-list">
              {programme.map((item) => <li>{item}</li>)}
            </ul>
            <p class="programme-terms">investment terms are confirmed at offer stage.</p>
          </div>
          <img
            src="/accelerator/norway-cohort.jpg"
            alt="Cohort founders at the hacker house in Norway"
            class="section-photo"
            width="1066"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- 3b. Eligibility -->
    <section class="eligibility">
      <div class="container">
        <h3>who can apply</h3>
        <p>
          We don't do co-founder matching. Every member of an applying team must be female and have
          a STEM background.
        </p>
      </div>
    </section>

    <!-- 4. Who gets in -->
    <section class="who-gets-in">
      <div class="section-banner holo">
        <div class="container"><h2>who gets in</h2></div>
      </div>

      <div class="container">
        <p class="who-frame">this is who you'd be joining.</p>
        <ul class="stat-grid">
          {whoGetsIn.map((item) => (
            <li class="stat-item">
              <span class="stat-figure">{item.figure}</span>
              <span class="stat-label">{item.label}</span>
              {item.detail && <span class="stat-detail">{item.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Cohort on cohort -->
    <section class="cohorts">
      <div class="section-banner holo">
        <div class="container"><h2>cohort on cohort</h2></div>
      </div>

      <div class="container">
        <div class="cohorts-layout">
          <img
            src="/accelerator/cohort-on-cohort.jpg"
            alt="Cohort founders working together"
            class="section-photo"
            width="5926"
            height="3951"
            loading="lazy"
            decoding="async"
          />
          <div class="cohorts-detail">
        <table class="cohort-table">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col">cohort 1</th>
              <th scope="col">cohort 2</th>
            </tr>
          </thead>
          <tbody>
            {cohortOnCohort.map((row) => (
              <tr>
                <th scope="row">{row.measure}</th>
                <td class="cohort-from">{row.one}</td>
                <td class="cohort-to">{row.two}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="cohort-note">the programme is getting more competitive.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Where founders came from. Not partners or sponsors — those live on /partners. -->
    <section class="origins">
      <div class="section-banner holo">
        <div class="container"><h2>our founders come from</h2></div>
      </div>

      <div class="container">
        <p class="origins-note">where cohort members came from before the programme.</p>
        <ul class="origin-strip">
          {origins.map((org) => (
            <li class="origin-item">
              <img
                src={org.logo}
                alt={org.name}
                class="origin-logo"
                data-tone={org.tone}
                style={`height: ${org.height}px`}
                {/* Eager: a lazy image never fires onerror, so a missing file
                    would sit there broken instead of falling back. */}
                loading="eager"
                decoding="async"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
              <span class="origin-name" hidden>{org.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Founders who found us at an event -->
    <section class="from-events">
      <div class="container">
        <h2>many of our founders find us at an event first</h2>
        <p class="from-events-line">
          Four of our twenty cohort 2 founders first came to us as prize winners at Tech Bros
          events.
        </p>
        <div class="btn-group">
          <a href="/community" class="btn btn-tertiary">see the community</a>
          <a href="/partners" class="btn btn-tertiary">partner with us</a>
        </div>
      </div>
    </section>

    <!-- 8. Venture partners -->
    <section class="partners" id="venture-partners">
      <div class="section-banner holo">
        <div class="container"><h2>venture partners</h2></div>
      </div>

      <div class="container">
        <PeopleGrid people={VENTURE_PARTNERS} photoBase="/accelerator/venture-partners" columns={6} />
      </div>
    </section>

    <!-- 9. Cohort 2 -->
    <section class="cohort-2">
      <div class="section-banner holo">
        <div class="container"><h2>cohort 2</h2></div>
      </div>

      <div class="container">
        <p class="cohort-2-line">270+ applied. twenty selected. a 7.4% acceptance rate.</p>
        <PeopleGrid people={COHORT_2} photoBase="/accelerator/cohort-2" columns={5} />
      </div>
    </section>

    <!-- 10. Applications status and sign-up. `id="apply-now"` is the target of
         the /apply/accelerator#apply-now redirect, which is still in
         circulation, and `id="newsletter"` of links to the sign-up. -->
    <section class="status" id="apply-now">
      <div class="holo status-block" id="newsletter">
        <div class="container">
          <p class="status-headline">cohort 3 applications open next spring.</p>
          <p class="status-sub">sign up to hear first.</p>
          <div class="newsletter-wrap">
            <NewsletterSignup buttonText="subscribe" variant="on-holo" />
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .accelerator section {
    padding: 5rem 0;
  }

  .accelerator h2 {
    font-size: var(--text-h2);
    color: var(--color-text);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 2.5rem;
  }

  /* Full-bleed divider, same treatment as the section banners on /press: a
     direct child of the section so it runs edge to edge, with its inner
     container keeping the heading on the page's text gutter. Deliberately
     shallow — a divider, not a statement block. */
  .section-banner {
    margin-bottom: 3rem;
    padding: 1.25rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.05;
  }

  /* The banner carries each section's top edge. */
  .accelerator section.programme,
  .accelerator section.who-gets-in,
  .accelerator section.cohorts,
  .accelerator section.origins,
  .accelerator section.partners,
  .accelerator section.cohort-2 {
    padding-top: 3rem;
  }

  /* ── Eligibility ── */
  .eligibility {
    padding-top: 0 !important;
  }

  .eligibility h3 {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .eligibility p {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-text);
    max-width: 62ch;
    margin-bottom: 0;
  }

  .who-frame {
    font-size: var(--text-lead);
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  /* Photographs sit straight on black: contained so nothing is cropped, no
     border, no radius. */
  .section-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border: 0;
    border-radius: 0;
  }

  .acc-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
    gap: 3rem;
    align-items: center;
  }

  /* The photo fills the full height of the block beside it. `cover` rather
     than `contain`: matching the height exactly means losing a little off the
     top and bottom, which is preferable to a short photo against a long list. */
  .programme-layout,
  .cohorts-layout {
    display: grid;
    gap: 2rem;
    align-items: stretch;
  }

  .cohorts-layout {
    grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
  }

  .programme-layout .section-photo,
  .cohorts-layout .section-photo {
    object-fit: cover;
  }

  /* ── 1. Headline ── */
  /* Out-specifies `.accelerator section`, which would otherwise reimpose 5rem
     and pull the banner away from the hero. */
  .accelerator section.acc-hero {
    padding: 4.5rem 0 1.25rem;
  }

  .accelerator section.status {
    padding-top: 0;
  }

  .acc-hero h1 {
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 52ch;
    margin-bottom: 0;
  }

  /* ── 2. Applications status ──
     The first question anyone arrives with, so it gets the foil and sits
     above everything else on the page. */
  .status {
    padding-top: 0;
  }

  /* Full-bleed closing block: the foil runs edge to edge and everything on it
     is centred. */
  .accelerator section.status {
    padding: 0;
  }

  .status-block {
    padding: 4rem 0;
    text-align: center;
  }

  .status-headline {
    font-size: var(--text-h2);
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.15;
    margin: 0 auto 1rem;
    max-width: 22ch;
  }

  .status-sub {
    font-size: var(--text-lead);
    margin-bottom: 2rem;
  }

  /* ── 3. The programme ── */
  .programme-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
  }

  .programme-list {
    list-style: none;
    max-width: 60ch;
  }

  /* The rules between items do the separating; a marker as well is redundant.
     The left indent stays so the text sits exactly where it did before. */
  .programme-list li {
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.5;
    padding: 1rem 0 1rem 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .programme-terms {
    margin: 2.5rem 0 0;
    color: var(--color-text-muted);
  }

  /* ── 4. Who gets in ── */
  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .stat-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  .stat-detail {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ── 5. Cohort on cohort ── */
  .cohort-table {
    width: 100%;
    max-width: 46rem;
    border-collapse: collapse;
    text-align: left;
  }

  .cohort-table th,
  .cohort-table td {
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cohort-table thead th {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-weight: var(--weight-body);
  }

  .cohort-table tbody th {
    font-weight: var(--weight-body);
    color: var(--color-text);
  }

  .cohort-from,
  .cohort-to {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    width: 8rem;
  }

  .cohort-from {
    color: var(--color-text-muted);
  }

  .cohort-to {
    color: var(--color-primary);
  }

  .cohort-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  /* ── 6. Origins strip ── */
  .origins-note {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
    color: var(--color-text-muted);
  }

  .origin-strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 2.5rem;
    align-items: center;
  }

  .origin-logo {
    display: block;
    height: 30px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    /* Same treatment as the as-seen-in strip and the partner wall. */
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* Coloured plate with the mark knocked out of it: grayscale plus a hard
     contrast push drops the plate to black and lifts the mark to white. */
  .origin-logo[data-tone='threshold'] {
    filter: grayscale(1) contrast(5);
  }

  /* Same idea, but the plate sits light enough that it needs pulling down
     below the contrast pivot first, or it whites out instead. */
  .origin-logo[data-tone='knockout'] {
    filter: grayscale(1) brightness(0.7) contrast(20);
  }

  /* A lockup that is both a coloured plate and dark type beside it. Inverting
     first drops the plate below the contrast pivot and lifts the type above
     it, so one pass keeps the knocked-out glyph *and* the wordmark — every
     other treatment loses one or the other. */
  .origin-logo[data-tone='plate'] {
    filter: invert(1) grayscale(1) brightness(1.2) contrast(3);
  }

  /* Wordmark fallback for organisations with no logo file yet. */
  .origin-item [hidden] {
    display: none !important;
  }

  .origin-name {
    font-size: var(--text-body);
    color: var(--color-text);
    letter-spacing: var(--tracking-subheading);
  }

  /* ── 7. From events ── */
  .from-events-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 58ch;
    margin-bottom: 0;
  }

  /* ── 9. Cohort 2 ── */
  .cohort-2-line {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  /* The form sits inside the foil block, centred, at a readable width. */
  .newsletter-wrap {
    max-width: 34rem;
    margin: 0 auto;
    /* The fields themselves read left; only the block is centred. */
    text-align: left;
  }

  @media (max-width: 1024px) {
    .stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 768px) {
    .accelerator section {
      padding: 3.5rem 0;
    }

    /* Photos stack: below the list and the headline, above the table. */
    .programme-layout,
    .acc-hero-layout,
    .cohorts-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .cohorts-layout .section-photo {
      order: -1;
    }

    .programme-layout .section-photo,
    .cohorts-layout .section-photo {
      height: auto;
      max-height: 26rem;
      object-fit: cover;
    }

    .status-block {
      padding: 2.5rem 0;
    }

    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cohort-from,
    .cohort-to {
      width: auto;
    }
  }
</style>
