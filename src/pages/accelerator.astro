---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import { VENTURE_PARTNERS, COHORT_2 } from '../data/people';

const programme = [
  'Two weeks in person at a hacker house in Norway.',
  'A six-week hybrid programme.',
  'A twelve-strong venture partner bench.',
  'Workshops.',
  'A demo day for invited investors.',
];

const whoGetsIn = [
  {
    figure: '500+',
    label: 'applications across two cohorts',
    detail: 'all reached organically',
  },
  { figure: '40', label: 'founders selected' },
  {
    figure: '8.7% / 7.4%',
    label: 'acceptance rate, cohort 1 / cohort 2',
    detail: 'more competitive than Oxford or Cambridge',
  },
  { figure: '45%', label: 'ex-big tech engineers', detail: 'Tesla, Apple, Google, NASA' },
  {
    figure: '70%',
    label: 'attended a global top 25 university',
    detail: 'Stanford, MIT, Oxford, Cambridge',
  },
  { figure: '100%', label: 'STEM', detail: '80% engineering, CS or AI/ML backgrounds' },
];

const cohortOnCohort = [
  { measure: 'Repeat founders', one: '10%', two: '45%' },
  { measure: 'Hardware founders', one: '5%', two: '45%' },
  { measure: 'Users or pilots at selection', one: '35%', two: '90%' },
];

// `logo` points at public/index/cohort-logos/. Five of these have no file yet
// and fall back to a wordmark; drop the file in and add the path.
const origins = [
  { name: 'Google', logo: '/index/cohort-logos/google.png' },
  { name: 'Apple', logo: '/index/cohort-logos/apple.png' },
  { name: 'Microsoft', logo: '/index/cohort-logos/microsoft.png' },
  { name: 'Tesla', logo: '/index/cohort-logos/tesla.png' },
  { name: 'Meta', logo: '/index/cohort-logos/meta.png' },
  { name: 'Discord', logo: '/index/cohort-logos/discord.png' },
  { name: 'NASA' },
  { name: 'Amazon' },
  { name: 'Y Combinator', logo: '/index/cohort-logos/ycombinator.png' },
  { name: 'Stanford', logo: '/index/cohort-logos/stanford.png' },
  { name: 'MIT', logo: '/index/cohort-logos/mit.png' },
  { name: 'Oxford', logo: '/index/cohort-logos/oxford.png' },
  { name: 'Cambridge', logo: '/index/cohort-logos/cambridge.png' },
  { name: 'UC Berkeley' },
  { name: 'Caltech' },
  { name: 'EPFL' },
];

---

<BaseLayout
  title="Accelerator"
  description="The world's first all-female, all-technical accelerator."
>
  <Navigation />
  <main class="accelerator">
    <!-- 1. Headline -->
    <section class="acc-hero">
      <div class="container">
        <h1>the world's first all-female, all-technical accelerator</h1>
        <p class="hero-line">
          six weeks. twenty founders. 500+ applications, all reached organically.
        </p>
      </div>
    </section>

    <!-- 2. Applications status. `id="apply-now"` is the target of the
         /apply/accelerator#apply-now redirect, which is still in circulation. -->
    <section class="status" id="apply-now">
      <div class="container">
        <div class="holo status-block">
          <p class="status-headline">Cohort 3 applications open next spring.</p>
          <p class="status-sub">
            <a href="#newsletter">Sign up to our newsletter to hear first.</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. The programme -->
    <section class="programme">
      <div class="container">
        <h2>the programme</h2>
        <ul class="programme-list">
          {programme.map((item) => <li>{item}</li>)}
        </ul>
        <p class="programme-terms">Investment terms are confirmed at offer stage.</p>
      </div>
    </section>

    <!-- 4. Who gets in -->
    <section class="who-gets-in">
      <div class="container">
        <h2>who gets in</h2>
        <ul class="stat-grid">
          {whoGetsIn.map((item) => (
            <li class="stat-item">
              <span class="stat-figure">{item.figure}</span>
              <span class="stat-label">{item.label}</span>
              {item.detail && <span class="stat-detail">{item.detail}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Cohort on cohort -->
    <section class="cohorts">
      <div class="container">
        <h2>cohort on cohort</h2>
        <table class="cohort-table">
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col">Cohort 1</th>
              <th scope="col">Cohort 2</th>
            </tr>
          </thead>
          <tbody>
            {cohortOnCohort.map((row) => (
              <tr>
                <th scope="row">{row.measure}</th>
                <td class="cohort-from">{row.one}</td>
                <td class="cohort-to">{row.two}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="cohort-note">The programme is getting more competitive.</p>
      </div>
    </section>

    <!-- 6. Where founders came from. Not partners or sponsors — those live on /partners. -->
    <section class="origins">
      <div class="container">
        <h2>our founders come from</h2>
        <p class="origins-note">Where cohort members came from before the programme.</p>
        <ul class="origin-strip">
          {origins.map((org) => (
            <li class="origin-item">
              {org.logo ? (
                <img src={org.logo} alt={org.name} class="origin-logo" loading="lazy" decoding="async" />
              ) : (
                <span class="origin-name">{org.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Founders who found us at an event -->
    <section class="from-events">
      <div class="container">
        <h2>many of our founders find us at an event first</h2>
        <p class="from-events-line">
          Four of our twenty cohort 2 founders first came to us as prize winners at Tech Bros
          events.
        </p>
        <div class="btn-group">
          <a href="/community" class="btn btn-tertiary">See the community</a>
        </div>
      </div>
    </section>

    <!-- 8. Venture partners -->
    <section class="partners">
      <div class="container">
        <h2>venture partners</h2>
        <PeopleGrid people={VENTURE_PARTNERS} photoBase="/accelerator/venture-partners" />
      </div>
    </section>

    <!-- 9. Cohort 2 -->
    <section class="cohort-2">
      <div class="container">
        <h2>cohort 2</h2>
        <p class="cohort-2-line">270+ applied. Twenty selected. A 7.4% acceptance rate.</p>
        <PeopleGrid people={COHORT_2} photoBase="/accelerator/cohort-2" />
      </div>
    </section>

    <!-- 10. Newsletter -->
    <section class="newsletter" id="newsletter">
      <div class="container">
        <h2>hear when cohort 3 opens</h2>
        <p class="newsletter-line">
          Applications open next spring. The newsletter is how you find out first.
        </p>
        <div class="newsletter-wrap">
          <NewsletterSignup buttonText="Subscribe" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .accelerator section {
    padding: 5rem 0;
  }

  .accelerator h2 {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-subheading);
    margin-bottom: 2.5rem;
  }

  /* ── 1. Headline ── */
  .acc-hero {
    padding: 4.5rem 0 3rem;
  }

  .acc-hero h1 {
    max-width: 20ch;
    margin-bottom: 2rem;
  }

  .hero-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 52ch;
    margin-bottom: 0;
  }

  /* ── 2. Applications status ──
     The first question anyone arrives with, so it gets the foil and sits
     above everything else on the page. */
  .status {
    padding-top: 0;
  }

  .status-block {
    padding: 3rem;
  }

  .status-headline {
    font-size: var(--text-h2);
    line-height: 1.15;
    margin-bottom: 1rem;
    max-width: 22ch;
  }

  .status-sub {
    font-size: var(--text-lead);
    margin-bottom: 0;
  }

  /* Buttons can't sit on the foil — black text is enforced there — so this is
     a plain underlined link instead. */
  .status-sub a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── 3. The programme ── */
  .programme-list {
    list-style: none;
    max-width: 60ch;
  }

  .programme-list li {
    font-size: var(--text-lead);
    color: var(--color-text);
    line-height: 1.5;
    padding: 1rem 0 1rem 1.75rem;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .programme-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .programme-terms {
    margin: 2.5rem 0 0;
    color: var(--color-text-muted);
  }

  /* ── 4. Who gets in ── */
  .stat-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-figure {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .stat-label {
    color: var(--color-text);
    line-height: 1.4;
  }

  .stat-detail {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ── 5. Cohort on cohort ── */
  .cohort-table {
    width: 100%;
    max-width: 46rem;
    border-collapse: collapse;
    text-align: left;
  }

  .cohort-table th,
  .cohort-table td {
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cohort-table thead th {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-weight: var(--weight-body);
  }

  .cohort-table tbody th {
    font-weight: var(--weight-body);
    color: var(--color-text);
  }

  .cohort-from,
  .cohort-to {
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    width: 8rem;
  }

  .cohort-from {
    color: var(--color-text-muted);
  }

  .cohort-to {
    color: var(--color-primary);
  }

  .cohort-note {
    margin: 2.5rem 0 0;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  /* ── 6. Origins strip ── */
  .origins-note {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
    color: var(--color-text-muted);
  }

  .origin-strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 2.5rem;
    align-items: center;
  }

  .origin-logo {
    display: block;
    height: 34px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.85;
  }

  /* Wordmark fallback for organisations with no logo file yet. */
  .origin-name {
    font-size: var(--text-body);
    color: var(--color-text);
    letter-spacing: var(--tracking-subheading);
  }

  /* ── 7. From events ── */
  .from-events-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 58ch;
    margin-bottom: 0;
  }

  /* ── 9. Cohort 2 ── */
  .cohort-2-line {
    margin-top: -1.5rem;
    margin-bottom: 2.5rem;
    font-size: var(--text-lead);
    color: var(--color-text);
  }

  /* ── 10. Newsletter ── */
  .newsletter {
    border-top: 1px solid var(--color-border);
  }

  .newsletter-line {
    font-size: var(--text-lead);
    color: var(--color-text);
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .newsletter-wrap {
    max-width: 34rem;
  }

  @media (max-width: 1024px) {
    .stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 768px) {
    .accelerator section {
      padding: 3.5rem 0;
    }

    .status-block {
      padding: 2rem 1.5rem;
    }

    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cohort-from,
    .cohort-to {
      width: auto;
    }
  }
</style>
