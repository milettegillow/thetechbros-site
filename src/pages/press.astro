// HIDDEN: the podcasts section is commented out, not deleted. To restore it,
// uncomment this data block and the matching markup below the mentions
// section. Nothing else needs changing — the preview images are still in
// public/press/ and the .podcasts styles are still in this file.
/*
// Podcasts use the same row shape as mentions, plus a description.
const podcasts = [
  {
    platform: 'Spotify',
    date: '2025-05-15',
    dateLabel: '15th May 2025',
    title: 'the tech bros: creating and backing female-founded tech companies',
    description:
      'An awesome chat with the brilliant minds behind The Tech Bros. They are shaking up the male-dominated world of tech by increasing the number of all-female, all-technical startups with hackathons, panels, and workshops, plus a newly launched accelerator programme.',
    url: 'https://open.spotify.com/episode/3z0c2V3ZU2WPhbxRQEsUJX?si=f95306ef48414e95&nd=1&dlsi=d0ff325f5499487c',
  },
  {
    platform: 'YouTube',
    date: '2025-05-20',
    dateLabel: '20th May 2025',
    title:
      'how the tech bros are empowering the next Generation of technical female founders to launch startups',
    description:
      'In this episode, we sit down with the founders of The Tech Bros, a bold new force in Venture Capital (VC) on a mission to increase the number of all-female, all-technical startups coming into existence by enabling women in highly technical fields -- with a focus on postgrads and PhDs -- to launch their startup through their hands-on events & accelerator programme.',
    url: 'https://www.youtube.com/watch?v=SubeLiG-jyI',
  },
  {
