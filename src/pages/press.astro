    date: '2026-07-06',
    dateLabel: '6th July 2026',
    headline: 'Why vibe coders need community support to thrive',
    url: 'https://www.thetimes.com/business/entrepreneurs/article/power-communities-vibe-coders-friends-enterprise-network-379tqx8vg',
  },
  {
    publication: 'Pulse 2',
    date: '2026-06-27',
    dateLabel: '27th June 2026',
    headline:
      'British Business Bank Commits Up To £90 Million To Back Emerging UK Venture Capital Managers',
    url: 'https://pulse2.com/british-business-bank-commits-up-to-90-million-to-back-emerging-uk-venture-capital-managers/',
