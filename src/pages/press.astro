---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import AsSeenIn from '../components/AsSeenIn.astro';

// Tier 1. `image` and `url` are both optional: three of these have no artwork
// yet, and the British Business Bank announcement has no public URL on file.
const featured = [
  {
    publication: 'Sifted',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: 'Exclusive: British Business Bank backs 10 VC funds with £90m pot',
    description:
      "The Tech Bros Fund named as one of ten microfunds selected from 151 applications for the British Business Bank's first Microfunds cohort.",
    url: 'https://sifted.eu/articles/exclusive-bbb-10-vc-funds-90m',
  },
  {
    publication: 'British Business Bank',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: 'Official announcement: £90m across 10 microfunds',
    description:
      'The British Business Bank announces cornerstone commitments to ten emerging managers under its £400m Investor Pathways Capital initiative.',
    url: 'https://www.british-business-bank.co.uk/news-and-events/news/british-business-bank-backs-new-generation-uk-venture-capital-investors-first-investor-pathways',
  },
  {
    publication: 'Shifter',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: 'The Tech Bros får deler av milliardfond',
    description:
      "Norwegian coverage of the British Business Bank commitment and the accelerator's Norway cohort.",
    url: 'https://www.shifter.no/nyheter/the-tech-bros-far-deler-av-milliardfond-til-a-investere-i-startups-av-og-med-kvinner/468672',
  },
  {
    publication: 'Tech Funding News',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline:
      'British Business Bank backs 10 microfunds with £90M, with most GPs women or from ethnic minority backgrounds',
    description:
      'The Tech Bros: Fund I profiled as investing in female technical founders, primarily graduates of the accelerator, led by Dr Milette Gillow.',
    url: 'https://techfundingnews.com/british-business-bank-90m-microfunds/',
  },
  {
    publication: 'Shifter',
    date: '2025-08-05',
    dateLabel: '5th Aug 2025',
    headline:
      'på en hytte på hafjell har the tech bros samlet noen av verdens mest ambisiøse gründere – og alle er kvinner',
    description:
      "On a cabin at Hafjell, The Tech Bros has gathered some of the world's most ambitious founders – and they're all women.",
    url: 'https://www.shifter.no/nyheter/pa-en-hytte-pa-hafjell-har-the-tech-bros-samlet-noen-av-verdens-mest-ambisiose-grundere-og-alle-er-kvinner/412703',
    image: '/press/shifter-article.jpg',
  },
  {
    publication: 'Sifted',
    date: '2025-07-02',
    dateLabel: '2nd July, 2025',
    headline: "meet the women behind the tech bros: 'we're laying claim to the term'",
    description:
      "Fed up of women being 'overlooked and undervalued' by VCs, two UK-based founders have started an all-female accelerator.",
    url: 'https://sifted.eu/articles/meet-the-women-behind-the-tech-bros-were-laying-claim-to-the-term',
    image: '/press/sifted-article.jpg',
  },
].sort((a, b) => b.date.localeCompare(a.date));

// Tier 2. These all cover the same announcement, so they share a subject line
// rather than an invented headline. Entries without a confirmed URL render as
// plain text; nothing is guessed.
const BBB_SUBJECT = 'British Business Bank Microfunds announcement';

const mentions = [
  {
    publication: 'The Times',
    date: '2026-07-06',
    dateLabel: '6th July, 2026',
    headline: 'Why vibe coders need community support to thrive',
    url: 'https://www.thetimes.com/business/entrepreneurs/article/power-communities-vibe-coders-friends-enterprise-network-379tqx8vg',
  },
  {
    publication: 'Pulse 2',
    date: '2026-06-27',
    dateLabel: '27th June, 2026',
    headline: BBB_SUBJECT,
    url: 'https://pulse2.com/british-business-bank-commits-up-to-90-million-to-back-emerging-uk-venture-capital-managers/',
  },
  {
    publication: 'Insider Media',
    date: '2026-06-26',
    dateLabel: '26th June, 2026',
    headline: BBB_SUBJECT,
    url: 'https://www.insidermedia.com/news/national/british-business-bank-to-commit-90m-to-back-new-generation-of-uk-venture-capital-investors',
  },
  {
    publication: 'UKTN',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: BBB_SUBJECT,
    url: 'https://www.uktech.news/funding/british-business-bank-commits-90m-for-next-generation-of-vc-investors-20260625',
  },
  {
    publication: 'BeBeez International',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: BBB_SUBJECT,
    url: 'https://bebeez.eu/2026/06/25/british-business-bank-commits-e104-million-to-support-uk-venture-capital-fund-managers/',
  },
  {
    publication: 'The Southern Gazette',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: BBB_SUBJECT,
    url: 'https://www.thesoutherngazette.com/financial/british-business-bank-backs-new-generation-of-uk-venture-capital-investors-with-first-investor-pathways-capital-commitment-of-up-to-90m/',
  },
  {
    publication: 'Beinsure',
    date: '2026-06-25',
    dateLabel: '25th June, 2026',
    headline: BBB_SUBJECT,
  },
].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="Press">
  <Navigation />
  <main>
    <!-- Hero -->
    <section class="press-hero">
      <div class="container">
        <h1>press</h1>
        <p class="hero-subtitle">Independent coverage of The Tech Bros, our founders, and the companies being built through the programme.</p>
      </div>
    </section>

    <AsSeenIn />

    <!-- Tier 1: featured -->
    <section class="featured">
      <div class="container">
        <h2>featured</h2>
        <div class="press-list">
          {featured.map((item) => (
            <article class={`press-item${item.image ? '' : ' press-item-no-image'}`}>
              <div class="press-item-content">
                {item.image && (
                  <div class="press-image">
                    <img src={item.image} alt={`${item.publication} coverage`} loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="press-text">
                  <p class="press-source">{item.publication} — {item.dateLabel}</p>
                  <h3>
                    {item.url ? (
                      <a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a>
                    ) : (
                      item.headline
                    )}
                  </h3>
                  <p class="press-excerpt">{item.description}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Tier 2: mentions -->
    <section class="mentions">
      <div class="container">
        <h2>mentions</h2>
        <ul class="mention-list">
          {mentions.map((item) => (
            <li class="mention">
              <span class="mention-meta">{item.publication} — {item.dateLabel}</span>
              <span class="mention-headline">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a>
                ) : (
                  item.headline
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Podcasts -->
    <section class="podcasts">
      <div class="container">
        <h2>podcasts</h2>
        <div class="press-list">
          <article class="press-item">
            <div class="press-item-content">
              <div class="press-image">
                <img src="/press/spotify-podcast.jpg" alt="Spotify Podcast" />
              </div>
              <div class="press-text">
                <h3><a href="https://open.spotify.com/episode/3z0c2V3ZU2WPhbxRQEsUJX?si=f95306ef48414e95&nd=1&dlsi=d0ff325f5499487c" target="_blank" rel="noopener noreferrer">the tech bros: creating and backing female-founded tech companies</a></h3>
                <p class="press-source">Spotify — 15th May 2025</p>
                <p class="press-excerpt">This week, I had an awesome chat with  and , the brilliant minds behind . These ladies are shaking up the male-dominated world of tech by increasing the number of all-female, all-technical startups with hackathons, panels, and workshops…AND a newly launched accelerator programme!</p>
              </div>
            </div>
          </article>
          <article class="press-item">
            <div class="press-item-content">
              <div class="press-image">
                <img src="/press/youtube-podcast.jpg" alt="YouTube Podcast" />
              </div>
              <div class="press-text">
                <h3><a href="https://www.youtube.com/watch?v=SubeLiG-jyI" target="_blank" rel="noopener noreferrer">how the tech bros are empowering the next Generation of technical female founders to launch startups</a></h3>
                <p class="press-source">YouTube — 20th May 2025</p>
                <p class="press-excerpt">In this episode, we sit down with the founders of The Tech Bros, a bold new force in Venture Capital (VC) on a mission to increase the number of all-female, all-technical startups coming into existence by enabling women in highly technical fields -- with a focus on postgrads and PhDs -- to launch their startup through their hands-on events & accelerator programme.</p>
              </div>
            </div>
          </article>
          <article class="press-item">
            <div class="press-item-content">
              <div class="press-image">
                <img src="/press/generationship-podcast.jpg" alt="Generationship Podcast" />
              </div>
              <div class="press-text">
                <h3><a href="https://www.heavybit.com/library/podcasts/generationship/ep-47-the-tech-bros-with-milette-gillow-and-sedinam-simpson" target="_blank" rel="noopener noreferrer">ep 47: the tech bros with milette gillow and sedinam simpson</a></h3>
                <p class="press-source">Generationship — 13th Nov 2025</p>
                <p class="press-excerpt">In episode 47 of Generationship, Rachel Chalmers chats with Dr. Milette Gillow and Sedinam Simpson, co-founders of The Tech Bros, about their mission to make tech more inclusive and inventive. They unpack lessons from their first accelerator cohort, debate the future of AI, and share what it takes to build confidence and community in an evolving industry.</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Press Contact -->
    <section class="press-contact">
      <div class="container text-center">
        <h2>press inquiries</h2>
        <p>Interested in covering The Tech Bros, our founders, or our companies?</p>
        <p>We're always happy to connect with journalists and podcasters who want to tell the story of our founders building the future.</p>
        <div style="margin-top: 2rem;">
          <a href="mailto:team@thetechbros.io" class="btn btn-secondary">Get In Touch</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .press-hero {
    padding: 6rem 0 3rem;
    text-align: center;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-top: 1rem;
    font-weight: 300;
  }

  .featured {
    padding: 4rem 0 3rem;
  }

  .mentions {
    padding: 0 0 4rem;
  }

  .podcasts {
    background: rgba(0, 0, 0, 0.2);
    padding: 4rem 0;
  }

  .press-list {
    max-width: 900px;
    margin: 0 auto;
  }

  .featured h2,
  .mentions h2,
  .podcasts h2 {
    margin-left: -2rem;
    margin-bottom: 3rem;
  }

  .press-item {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .press-item:last-child {
    border-bottom: none;
  }

  /* Cards with no artwork drop the image column rather than leave a gap. */
  .press-item-no-image .press-item-content {
    grid-template-columns: 1fr;
  }

  .press-item-content {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    align-items: start;
    margin-left: -2rem;
  }

  .press-image {
    width: 250px;
    height: 250px;
    flex-shrink: 0;
  }

  .press-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }

  .press-text h3 {
    margin-bottom: 0.75rem;
  }

  .press-item h3 a {
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .press-item h3 a:hover {
    color: var(--color-primary);
  }

  .press-source {
    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .press-excerpt {
    color: var(--color-text-muted);
    line-height: 1.8;
    font-size: 1rem;
  }

  /* ── Tier 2: mentions. Deliberately lighter than the featured cards:
     a dated list, no artwork, no description. ── */
  .mention-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .mention {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .mention-meta {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .mention-headline {
    color: var(--color-text-body);
    line-height: 1.45;
  }

  .mention-headline a {
    color: var(--color-text);
    text-decoration: none;
  }

  .mention-headline a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .mention {
      grid-template-columns: 1fr;
    }
  }

  .press-contact {
    padding: 4rem 0;
  }

  .press-contact h2 {
    margin-bottom: 1.5rem;
  }

  .press-contact p {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 600px;
    margin: 1rem auto;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .press-item {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
    }

    .featured h2,
    .mentions h2,
    .podcasts h2 {
      margin-left: 0;
    }

    .press-item-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-left: 0;
    }

    .press-image {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      max-width: 200px;
      margin: 0 auto;
    }
  }
</style>
