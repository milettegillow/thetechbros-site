import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import AsSeenIn from '../components/AsSeenIn.astro';
import { PUBLICATION_LOGOS, PUBLICATION_LOGO_HEIGHTS } from '../config';

