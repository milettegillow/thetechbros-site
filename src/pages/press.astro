    description:
      'In episode 47 of Generationship, Rachel Chalmers chats with Dr. Milette Gillow and Sedinam Simpson, co-founders of The Tech Bros, about their mission to make tech more inclusive and inventive. They unpack lessons from their first accelerator cohort, debate the future of AI, and share what it takes to build confidence and community in an evolving industry.',
    url: 'https://www.heavybit.com/library/podcasts/generationship/ep-47-the-tech-bros-with-milette-gillow-and-sedinam-simpson',
  },
].sort((a, b) => b.date.localeCompare(a.date));
*/

/** Marks in the row lists are scaled down from the strip's tuned heights. */
const ROW_MARK_SCALE = 0.62;
---

<BaseLayout title="Press">
  <Navigation />
  <main>
    <!-- Hero -->
    <section class="press-hero">
      <div class="container">
        <h1>press</h1>
        <p class="hero-subtitle">Independent coverage of The Tech Bros, our founders, and the companies being built through the programme.</p>
      </div>
    </section>

    <AsSeenIn />

    <!-- Tier 1: featured -->
    <section class="featured">
      <div class="section-banner holo">
        <div class="container"><h2>featured</h2></div>
      </div>
      <div class="container">
        <div class="press-list">
          {featured.map((item) => (
            <article class="press-item">
              <div class="press-item-content">
                <div class="press-mark">
                  {PUBLICATION_LOGOS[item.publication] ? (
                    <img
                      src={PUBLICATION_LOGOS[item.publication]}
                      alt={item.publication}
                      class="press-mark-logo"
                      loading="eager"
                      decoding="async"
                      onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                    />
                  ) : null}
                  <span class="press-mark-name" hidden={Boolean(PUBLICATION_LOGOS[item.publication])}>
                    {item.publication}
                  </span>
                </div>
                <div class="press-text">
                  <p class="press-source">{item.publication} — {item.dateLabel}</p>
                  <h3>
                    {item.url ? (
                      <a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a>
                    ) : (
                      item.headline
                    )}
                  </h3>
                  <p class="press-excerpt">{item.description}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Tier 2: mentions -->
    <section class="mentions">
      <div class="section-banner holo">
        <div class="container"><h2>mentions</h2></div>
      </div>
      <div class="container">
        <ul class="mention-list">
          {mentions.map((item) => (
            <li class="mention">
              <span class="mention-meta">
                {PUBLICATION_LOGOS[item.publication] ? (
                  <>
                    <img
                      src={PUBLICATION_LOGOS[item.publication]}
                      alt={item.publication}
                      class="mention-logo"
                      style={`height: ${Math.round((PUBLICATION_LOGO_HEIGHTS[item.publication] ?? 20) * ROW_MARK_SCALE)}px`}
                      loading="eager"
                      decoding="async"
                      onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
                    />
                    <span class="mention-name" hidden>{item.publication}</span>
                  </>
                ) : (
                  <span class="mention-name">{item.publication}</span>
                )}
                <span class="mention-sep">-</span>
                <span class="mention-date">{item.dateLabel}</span>
              </span>
              <span class="mention-headline">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a>
                ) : (
                  item.headline
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* HIDDEN: podcasts section. Uncomment this block and the `podcasts` data
        in the frontmatter to bring it back.

    <!-- Podcasts -->
    <section class="podcasts">
      <div class="section-banner holo">
        <div class="container"><h2>podcasts</h2></div>
      </div>
      <div class="container">
        <ul class="mention-list">
          {podcasts.map((item) => (
            <li class="mention">
              <span class="mention-meta">
                <span class="mention-name">{item.platform}</span>
                <span class="mention-sep">-</span>
                <span class="mention-date">{item.dateLabel}</span>
              </span>
              <span class="mention-headline">
                <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a>
                <span class="mention-note">{item.description}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    */}

    <!-- Press Contact -->
    <section class="press-contact">
      <div class="container text-center">
        <h2>press inquiries</h2>
        <p>Interested in covering The Tech Bros, our founders, or our companies?</p>
        <p>We're always happy to connect with journalists and podcasters who want to tell the story of our founders building the future.</p>
        <div style="margin-top: 2rem;">
          <a href="mailto:team@thetechbros.io" class="btn btn-secondary">Get In Touch</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .press-hero {
    padding: 6rem 0 3rem;
    text-align: center;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-top: 1rem;
    font-weight: 300;
  }

  .featured {
    padding: 3.5rem 0;
  }

  .mentions,
  .podcasts {
    padding: 0 0 3.5rem;
  }

  .press-list {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Full-bleed divider: a direct child of the section, so it runs edge to edge
     while its inner container keeps the heading on the page's text gutter.
     Deliberately shallower than the home page's statement block. */
  .section-banner {
    margin-bottom: 2rem;
    padding: 1.25rem 0;
  }

  .section-banner h2 {
    margin: 0;
    text-align: left;
    font-size: var(--text-h3);
    font-weight: var(--weight-holo);
    letter-spacing: var(--tracking-holo);
    line-height: 1.1;
  }

  .press-item {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .press-item:last-child {
    border-bottom: none;
  }

  .press-item-content {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-left: -2rem;
  }

  /* The publication mark replaces the old article screenshot. Forced white so
     mixed-colour source files sit on black. */
  .press-mark {
    display: flex;
    align-items: flex-start;
    min-height: 40px;
  }

  .press-mark [hidden] {
    display: none !important;
  }

  .press-mark-logo {
    display: block;
    max-height: 40px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .press-mark-name {
    font-size: var(--text-lead);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-text);
  }



  .press-text h3 {
    margin-bottom: 0.75rem;
  }

  .press-item h3 a {
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .press-item h3 a:hover {
    color: var(--color-primary);
  }

  .press-source {
    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .press-excerpt {
    color: var(--color-text-muted);
    line-height: 1.8;
    font-size: 1rem;
  }

  /* ── Tier 2: mentions. Deliberately lighter than the featured cards:
     a dated list, no artwork, no description. ── */
  .mention-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .mention {
    display: grid;
    /* Wide enough that the longest publication + date never wraps, so the
       headline column keeps the whole of the remaining width. */
    grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
    gap: 0.25rem 2rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .mention-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .mention-meta [hidden] {
    display: none !important;
  }

  /* Same white-on-black treatment as the strip, scaled down. */
  .mention-logo {
    display: block;
    width: auto;
    max-width: 9rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .mention-name,
  .mention-date {
    white-space: nowrap;
  }

  .mention-sep {
    color: var(--color-text-muted);
  }

  .mention-headline {
    color: var(--color-text-body);
    line-height: 1.45;
  }

  /* Podcast rows carry a description under the episode title. */
  .mention-note {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .mention-headline a {
    color: var(--color-text);
    text-decoration: none;
  }

  .mention-headline a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .mention {
      grid-template-columns: 1fr;
    }
  }

  .press-contact {
    padding: 4rem 0;
  }

  .press-contact h2 {
    margin-bottom: 1.5rem;
  }

  .press-contact p {
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 600px;
    margin: 1rem auto;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .press-item {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
    }

    .press-item-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-left: 0;
    }

    .press-mark {
      margin-bottom: 0.5rem;
    }
  }
</style>
