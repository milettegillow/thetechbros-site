---
/**
 * A grid of people: circular portrait, name, and nothing else.
 *
 * The single implementation behind every people grid on the site — the team on
 * /about, the venture partners and the cohort 2 founders on /accelerator — so
 * they are identical by construction rather than by three copies of the same
 * rules. Only the column count differs.
 *
 * The whole tile is the link; there is no separate icon.
 */
import type { Person } from '../data/people';

interface Props {
  people: Person[];
  /**
   * Directory under /public that bare `photo` filenames resolve against.
   * Entries whose `photo` is already an absolute path ignore it, so a grid can
   * mix people whose photos live in different directories.
   */
  photoBase?: string;
  /** Columns at desktop width. Steps down to 4 and then 3 as the page narrows. */
  columns?: 3 | 5 | 6;
  /**
   * Portrait diameter in pixels. The default suits a full grid; a short row
   * can afford to go bigger. Reverts to the default on mobile either way.
   */
  photoSize?: number;
  /**
   * `start` fills the width in equal columns — right for a grid that runs to
   * several rows. `center` sizes the columns to their content and centres the
   * group, which is what a row of two or three needs so it isn't stranded
   * against the left margin.
   */
  align?: 'start' | 'center';
  /**
   * Track width in pixels for the centred variant, which is what sets how far
   * apart the tiles sit: each portrait centres in its own track, so a wider
   * track spreads a short row across more of the page. Ignored when `align` is
   * `start`, where the tracks share the line equally.
   */
  columnWidth?: number;
}

const {
  people,
  photoBase,
  columns = 6,
  photoSize = 120,
  align = 'start',
  columnWidth = 192,
} = Astro.props;

const srcFor = (photo: string) =>
  photo.startsWith('/') ? photo : `${photoBase}/${photo}`;
---

<ul
  class="people-grid"
  data-align={align}
  style={`--people-columns: ${columns}; --people-photo-size: ${photoSize}px; --people-column: ${columnWidth}px`}
>
  {people.map((person) => {
    const Tile = person.linkedin ? 'a' : 'div';
    return (
      <li>
        <Tile
          class="people-card"
          href={person.linkedin}
          target={person.linkedin ? '_blank' : undefined}
          rel={person.linkedin ? 'noopener noreferrer' : undefined}
          aria-label={person.linkedin ? `${person.name} on LinkedIn` : undefined}
        >
          {person.photo ? (
            <>
              <img
                src={srcFor(person.photo)}
                alt={person.name}
                class="people-photo"
                loading="lazy"
                decoding="async"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
              <span class="people-photo-placeholder" hidden aria-hidden="true"></span>
            </>
          ) : (
            <span class="people-photo-placeholder" aria-hidden="true"></span>
          )}
          <span class="people-label">
            <span class="people-name">{person.name}</span>
            {person.meta && (
              <span class="people-meta holo">
                {/* The text sits in its own span so `.holo span` picks it up
                    and gives it the system's on-holo weight and tracking,
                    rather than restating either here. */}
                <span>{person.meta}</span>
              </span>
            )}
          </span>
        </Tile>
      </li>
    );
  })}
</ul>

<style>
  .people-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--people-columns, 6), minmax(0, 1fr));
    /* Every row the same height, so a name that runs to a third line at a
       narrow width doesn't leave its row taller than the others. */
    grid-auto-rows: 1fr;
    gap: 2rem 1.25rem;
  }

  /* Fixed rows: the portrait is a constant size and the name reserves two
     lines, so every tile is the same height whatever the name does. */
  .people-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  /* Circular and cropped on purpose — the source photos are framed every which
     way, and a common mask is what makes a grid read as one set. The disc is
     drawn because the portraits are cut-outs on transparent backgrounds;
     without it the crop would be invisible. This is the one place a radius is
     used; everything else on the site stays square. */
  .people-photo,
  .people-photo-placeholder {
    display: block;
    width: var(--people-photo-size, 120px);
    height: var(--people-photo-size, 120px);
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    background: var(--color-surface);
    transition: opacity var(--transition-btn);
  }

  .people-grid [hidden] {
    display: none !important;
  }

  a.people-card:hover .people-photo,
  a.people-card:focus-visible .people-photo {
    opacity: 0.6;
  }

  a.people-card:hover .people-name,
  a.people-card:focus-visible .people-name {
    color: var(--color-primary);
  }

  /* Two lines' worth whether the text needs it or not, so rows stay level.
     It's the block rather than the name that reserves them, so a grid carrying
     a meta line spends the second line on that instead of on empty space. */
  .people-label {
    display: block;
    min-height: 2.6em;
  }

  .people-name {
    display: block;
    text-align: center;
    font-size: var(--text-small);
    line-height: 1.3;
    color: var(--color-text);
    transition: color var(--transition-btn);
  }

  /* Optional second line, used only where the grid carries a place. It sits on
     a holographic chip: `.holo` supplies the surface and the enforced black
     text, so neither is restated here. Square, like every other holographic
     surface on the site. The chip hugs its text rather than filling the tile,
     and is centred under the name by its own auto margins. */
  .people-meta {
    display: block;
    width: fit-content;
    margin-inline: auto;
    padding: 0.2rem 0.6rem;
    text-align: center;
    font-size: var(--text-small);
    line-height: 1.3;
  }

  /* Centred variant: tracks take a fixed width rather than a share of the
     line, which is what lets `justify-content` have anything to centre. */
  .people-grid[data-align='center'] {
    grid-template-columns: repeat(var(--people-columns, 6), minmax(0, var(--people-column, 192px)));
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .people-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* An enlarged portrait steps down once before the layout stacks, so it
       doesn't crowd its track. `min` leaves the default 120px untouched. */
    .people-photo,
    .people-photo-placeholder {
      width: min(var(--people-photo-size, 120px), 150px);
      height: min(var(--people-photo-size, 120px), 150px);
    }
  }

  @media (max-width: 768px) {
    .people-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Three enlarged portraits don't fit a phone, so the size reverts and the
       centred variant goes back to sharing the line like any other grid. */
    .people-grid[data-align='center'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      justify-content: normal;
    }

    .people-photo,
    .people-photo-placeholder {
      width: 120px;
      height: 120px;
    }
  }
</style>
