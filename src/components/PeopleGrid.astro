---
/**
 * A grid of people: circular portrait, name, and nothing else.
 *
 * The single implementation behind every people grid on the site — the team on
 * /about, the venture partners and the cohort 2 founders on /accelerator — so
 * they are identical by construction rather than by three copies of the same
 * rules. Only the column count differs.
 *
 * The whole tile is the link; there is no separate icon.
 */
import type { Person } from '../data/people';

interface Props {
  people: Person[];
  /**
   * Directory under /public that bare `photo` filenames resolve against.
   * Entries whose `photo` is already an absolute path ignore it, so a grid can
   * mix people whose photos live in different directories.
   */
  photoBase?: string;
  /** Columns at desktop width. Steps down to 4 and then 3 as the page narrows. */
  columns?: 5 | 6;
}

const { people, photoBase, columns = 6 } = Astro.props;

const srcFor = (photo: string) =>
  photo.startsWith('/') ? photo : `${photoBase}/${photo}`;
---

<ul class="people-grid" style={`--people-columns: ${columns}`}>
  {people.map((person) => {
    const Tile = person.linkedin ? 'a' : 'div';
    return (
      <li>
        <Tile
          class="people-card"
          href={person.linkedin}
          target={person.linkedin ? '_blank' : undefined}
          rel={person.linkedin ? 'noopener noreferrer' : undefined}
          aria-label={person.linkedin ? `${person.name} on LinkedIn` : undefined}
        >
          {person.photo ? (
            <>
              <img
                src={srcFor(person.photo)}
                alt={person.name}
                class="people-photo"
                loading="lazy"
                decoding="async"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
              <span class="people-photo-placeholder" hidden aria-hidden="true"></span>
            </>
          ) : (
            <span class="people-photo-placeholder" aria-hidden="true"></span>
          )}
          <span class="people-name">{person.name}</span>
        </Tile>
      </li>
    );
  })}
</ul>

<style>
  .people-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--people-columns, 6), minmax(0, 1fr));
    /* Every row the same height, so a name that runs to a third line at a
       narrow width doesn't leave its row taller than the others. */
    grid-auto-rows: 1fr;
    gap: 2rem 1.25rem;
  }

  /* Fixed rows: the portrait is a constant size and the name reserves two
     lines, so every tile is the same height whatever the name does. */
  .people-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  /* Circular and cropped on purpose — the source photos are framed every which
     way, and a common mask is what makes a grid read as one set. The disc is
     drawn because the portraits are cut-outs on transparent backgrounds;
     without it the crop would be invisible. This is the one place a radius is
     used; everything else on the site stays square. */
  .people-photo,
  .people-photo-placeholder {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    background: var(--color-surface);
    transition: opacity var(--transition-btn);
  }

  .people-grid [hidden] {
    display: none !important;
  }

  a.people-card:hover .people-photo,
  a.people-card:focus-visible .people-photo {
    opacity: 0.6;
  }

  a.people-card:hover .people-name,
  a.people-card:focus-visible .people-name {
    color: var(--color-primary);
  }

  .people-name {
    display: block;
    text-align: center;
    font-size: var(--text-small);
    line-height: 1.3;
    color: var(--color-text);
    /* Two lines' worth whether the name needs it or not, so rows stay level. */
    min-height: 2.6em;
    transition: color var(--transition-btn);
  }

  @media (max-width: 1024px) {
    .people-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .people-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
