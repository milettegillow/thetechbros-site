---
/**
 * A grid of people: photo, name, LinkedIn icon. Nothing else.
 *
 * Used for both the venture partners and the cohort 2 founders so the two
 * sections are identical by construction rather than by coincidence. Photo
 * treatment matches the community leads on /community: fixed height, never
 * cropped, no border, sitting straight on black.
 */
import type { Person } from '../data/people';

interface Props {
  people: Person[];
  /** Directory under /public that the `photo` filenames resolve against. */
  photoBase: string;
}

const { people, photoBase } = Astro.props;

// Until any photo exists, a grid of empty cards is just dead space — so the
// same data renders as a plain list of names instead.
const hasPhotos = people.some((person) => person.photo);
---

{hasPhotos ? (
<div class="people-grid">
  {people.map((person) => (
    <div class="people-card">
      {person.photo ? (
        <img
          src={`${photoBase}/${person.photo}`}
          alt={person.name}
          class="people-photo"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="people-photo people-photo-placeholder" aria-hidden="true"></div>
      )}
      <div class="people-name-row">
        <p class="people-name">{person.name}</p>
        {person.linkedin && (
          <a
            href={person.linkedin}
            class="event-link"
            title={`View ${person.name} on LinkedIn`}
            aria-label={`View ${person.name} on LinkedIn`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  ))}
</div>
) : (
<ul class="people-list">
  {people.map((person) => (
    <li class="people-list-item">
      <span class="people-name">{person.name}</span>
      {person.linkedin && (
        <a
          href={person.linkedin}
          class="event-link"
          title={`View ${person.name} on LinkedIn`}
          aria-label={`View ${person.name} on LinkedIn`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      )}
    </li>
  ))}
</ul>
)}

<style>
  /* Name-only fallback: same columns as the grid, without the empty frames. */
  .people-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem 2rem;
  }

  .people-list-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  /* Same treatment as the team grid on /about: a fixed-height box with the
     photo sat on its floor, so names line up across a row whatever each
     portrait's proportions are. Contained, never cropped, no border. */
  .people-photo,
  .people-photo-placeholder {
    display: block;
    height: 170px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  /* Stands in at the same height so the grid doesn't reflow once photos land. */
  .people-photo-placeholder {
    width: 128px;
    background: var(--color-surface);
  }

  /* Two lines' worth of space whether the name needs it or not, so the rows
     stay level when a long name wraps. */
  .people-grid .people-name {
    min-height: 2.4em;
  }

  .people-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .people-name {
    color: var(--color-text);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-subheading);
    line-height: 1.2;
    margin-bottom: 0;
  }

  /* Same icon treatment as the event cards. */
  .event-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity var(--transition-btn), color var(--transition-btn);
  }

  .event-link:hover,
  .event-link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .event-link svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  @media (max-width: 1200px) {
    .people-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 1024px) {
    .people-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .people-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .people-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
