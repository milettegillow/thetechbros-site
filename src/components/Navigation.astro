---
const navLinks = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/fund', label: 'fund' },
  { href: '/accelerator', label: 'accelerator' },
  { href: '/community', label: 'community' },
  { href: '/press', label: 'press' },
];

/**
 * The current page, so its nav item can stay pink. Trailing slashes are
 * stripped so `/about/` and `/about` are the same page; `/` would strip to an
 * empty string, hence the fallback.
 */
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="nav-logo">the tech bros</a>
    <button type="button" class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="nav-toggle-icon"></span>
      <span class="nav-toggle-icon"></span>
      <span class="nav-toggle-icon"></span>
    </button>
    <ul class="nav-links" id="nav-links">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link"
            aria-current={link.href === here ? 'page' : undefined}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    /* Original values, restored from 298af29^. */
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    border-bottom: 4px solid var(--color-primary);
    /* Above every page section, which sit at z-index 1. This is the part that
       actually fixed the bleed-through; the opaque fill was over-correction. */
    z-index: 500;
    padding: 1rem 0;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    font-family: var(--font-primary);
    font-size: 2rem;
    font-weight: var(--weight-heading);
    color: var(--color-primary);
    text-decoration: none;
    text-transform: lowercase;
    letter-spacing: var(--tracking-wordmark);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
    padding: 0.5rem;
    z-index: 101;
  }

  .nav-toggle-icon {
    width: 24px;
    height: 2px;
    background: var(--color-primary);
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-primary);
    /* White, not muted: the bar is semi-transparent and sits over photography
       and holographic bands, where 55% white had too little to hold on to. */
    color: var(--color-text);
    font-weight: 400;
    transition: color 0.2s ease;
    text-transform: lowercase;
    font-size: var(--text-lead);
    letter-spacing: var(--tracking-nav);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-primary);
  }

  /* Where you are. Same pink as the hover, so the bar has one accent colour
     rather than two. */
  .nav-link[aria-current='page'] {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      position: relative;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(10px);
      border-top: 2px solid var(--color-primary);
      flex-direction: column;
      align-items: center;
      gap: 0;
      padding: 1rem;
      margin-top: 1rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
      max-height: 0;
      overflow: hidden;
      list-style: none;
    }

    .nav-links.nav-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      max-height: 1000px;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon:nth-child(1) {
      transform: rotate(45deg);
      position: relative;
      top: 6px;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded="true"] .nav-toggle-icon:nth-child(3) {
      transform: rotate(-45deg);
      position: relative;
      top: -6px;
    }

    .nav-link {
      padding: 0.75rem 0;
      width: 100%;
      justify-content: center;
      text-align: center;
      position: relative;
    }

    .nav-link::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
    }
  }
</style>

<script>
  const navToggle = document.querySelector('.nav-toggle');
  const navLinks = document.getElementById('nav-links');

  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', String(!isExpanded));
      navLinks.classList.toggle('nav-open');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!navToggle.contains(e.target as Node) && !navLinks.contains(e.target as Node)) {
        navToggle.setAttribute('aria-expanded', 'false');
        navLinks.classList.remove('nav-open');
      }
    });

    // Close menu when pressing Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navLinks.classList.contains('nav-open')) {
        navToggle.setAttribute('aria-expanded', 'false');
        navLinks.classList.remove('nav-open');
      }
    });
  }
</script>
